#!/usr/bin/env bash
# Context level from the session transcript (not the pane's status line, which is the owner's own setup).
# hh-context <agent> [--window <tokens>] | --all.  Exit: 2 no project / no session or usable transcript, 3 .hivehouse
# tracked, 4 bad window, 64 usage. The window is Claude Code's own (context.json, which hh-statusline keeps for a spawned
# agent), when it was read for the agent's current session; else --window; else the agent's `window` in team.json (written
# at spawn), default $HH_WINDOW_DEFAULT. It is never inferred from a model name. A window that was not measured or given is a guess,
# and the reading says so: "45 (window assumed 1000000)", or, when the tokens exceed that guess, "1500000 tokens (window unknown)": never a percent
# over 100. An agent that is no longer running as recorded (after a restart,
# say) keeps its last level and is marked: "45 (not running)"; one that cannot be told about is not.
set -u
. "$(dirname "$0")/hh-lib.sh"
ROOT=$(hh_project_root) || exit $?
STATE="$ROOT/$HH_STATE_DIR"
if [ -n "$(git -C "$ROOT" ls-files -- "$HH_STATE_DIR")" ]; then
  hh_die 3 "files under $HH_STATE_DIR/ are tracked by git; untrack them before using hivehouse here"
fi
pct() {  # pct <agent> [window]
  local a="$1" win="${2:-}" s t used c sid m
  s="$STATE/team/$a/session.json"; [ -f "$s" ] || return 2
  t=$(hh_json_get "$s" .transcript_path); [ -f "$t" ] || return 2
  used=$(hh_transcript_used "$t")
  [ -n "$used" ] || return 2
  # Claude Code's reading counts only for the session it was taken in: a rotated or replaced session's file is stale
  c="$STATE/team/$a/context.json"; sid=$(hh_json_get "$s" .session_id)
  if [ -n "$sid" ] && [ "$(hh_json_get "$c" .session_id)" = "$sid" ]; then
    m=$(hh_json_get "$c" .window); case "$m" in ''|*[!0-9]*|0) ;; *) echo $(( used * 100 / m )); return 0 ;; esac
  fi
  [ -n "$win" ] && { echo $(( used * 100 / win )); return 0; }
  win=$(jq -r --arg a "$a" '[.agents[]? | select(.name == $a) | .window][0] // empty' "$STATE/team.json" 2>/dev/null)
  case "$win" in ''|*[!0-9]*|0) win=$HH_WINDOW_DEFAULT ;; esac
  hh_assumed_level "$used" "$win"
}
mark() { hh_team_agent_is "$ROOT" "$1"; [ $? -eq 1 ] && printf ' (not running)'; return 0; }   # mark <agent>
if [ "${1:-}" = "--all" ]; then
  [ -f "$STATE/team.json" ] || hh_die 2 "no team recorded"
  for a in $(jq -r '.agents[].name' "$STATE/team.json"); do printf '%s %s%s\n' "$a" "$(pct "$a" || echo '?')" "$(mark "$a")"; done
  exit 0
fi
[ -n "${1:-}" ] || hh_die 64 "usage: hh-context <agent> [--window n] | --all"
w=""
if [ "${2:-}" = "--window" ]; then
  w="${3:-}"; case "$w" in ''|*[!0-9]*|0) hh_die 4 "--window must be a positive number: $w" ;; esac
fi
v=$(pct "$1" "$w") || hh_die 2 "no session or transcript recorded for $1"
printf '%s%s\n' "$v" "$(mark "$1")"

#!/usr/bin/env bash
# Typed manifest of what hivemind created. Never stores a command: hm-cleanup derives removal from the kind.
set -u
. "$(dirname "$0")/hm-lib.sh"
hm_ensure_state
ROOT=$(hm_project_root) || exit $?
STATE="$ROOT/.hivemind"; FILE="$STATE/manifest.jsonl"; LOCK="$STATE/manifest.lock"
touch "$FILE"

allowed() {
  case "$1" in
    worktree) echo "path base" ;; tmux) echo "socket pane agent" ;; process) echo "pid port" ;;
    dir|file) echo "path" ;; remote) echo "host path" ;; *) return 1 ;;
  esac
}
required() {
  case "$1" in
    worktree) echo "path base" ;; tmux) echo "socket pane agent" ;; process) echo "pid" ;;
    dir|file) echo "path" ;; remote) echo "host path" ;;
  esac
}
resolve_path() {  # absolute, no . or .. segment, parent resolved with pwd -P, never a symlink or another user's
  local p="$1" d b
  case "$p" in /*) ;; *) hm_die 4 "path must be absolute: $p" ;; esac
  case "/$p/" in */../*|*/./*) hm_die 4 "'.' or '..' segment in path: $p" ;; esac
  while [ "${#p}" -gt 1 ] && [ "${p%/}" != "$p" ]; do p="${p%/}"; done
  [ "$p" = / ] && hm_die 4 "refused path: /"
  d=$(cd "$(dirname "$p")" 2>/dev/null && pwd -P) || hm_die 4 "parent directory does not exist: $p"
  b=$(basename "$p")
  if [ "$d" = / ]; then printf '/%s\n' "$b"; else printf '%s/%s\n' "$d" "$b"; fi
}
refuse_protected() {  # equal to, or an ancestor of, a place hivemind must never remove
  local rp="$1" q
  for q in / "$HOME" "$ROOT" /tmp /private/tmp "${TMPDIR:-}"; do
    [ -n "$q" ] && [ -d "$q" ] || continue
    q=$(cd "$q" && pwd -P)
    case "$q/" in "$rp"/*) hm_die 4 "refused path (is or contains a protected directory): $rp" ;; esac
  done
  [ "$rp" = "$STATE" ] && hm_die 4 "refused path: $rp"
  if [ -L "$rp" ]; then hm_die 4 "refused: $rp is a symlink"; fi
  if [ -e "$rp" ] && [ ! -O "$rp" ]; then hm_die 4 "refused: $rp is not owned by the caller"; fi
  return 0
}
refuse_inside_project() {  # file and dir entries: not in the project, not in a recorded worktree
  local rp="$1" w
  case "$rp/" in "$ROOT/.hivemind/tmp/"*) ;; "$ROOT/"*) hm_die 4 "refused: $rp is inside the project" ;; esac
  while IFS= read -r w; do
    [ -n "$w" ] || continue
    case "$rp/" in "$w/"*) hm_die 4 "refused: $rp is inside the recorded worktree $w" ;; esac
  done < <(jq -r 'select(.kind == "worktree") | .path' "$FILE")
}
valid_value() {  # valid_value <field> <value>
  local k="$1" v="$2"
  case "$v" in *$'\n'*|*$'\r'*) hm_die 4 "control character in $k" ;; esac
  case "$k" in
    pid|port) case "$v" in ''|*[!0-9]*) hm_die 4 "$k must be a number: $v" ;; esac ;;
    pane) case "$v" in %[0-9]*) case "${v#%}" in *[!0-9]*) hm_die 4 "bad pane id: $v" ;; esac ;; *) hm_die 4 "bad pane id: $v" ;; esac ;;
    agent) case "$v" in ''|*[!A-Za-z0-9._-]*) hm_die 4 "bad agent name: $v" ;; esac ;;
    base) case "$v" in ''|-*|*[!A-Za-z0-9._/-]*) hm_die 4 "bad branch name: $v" ;; esac ;;
    host) case "$v" in ''|-*|*[!A-Za-z0-9._@-]*) hm_die 4 "bad host name: $v" ;; esac ;;
  esac
}
cmd_add() {
  local kind="${1:-}"; [ $# -gt 0 ] && shift
  local fields; fields=$(allowed "$kind") || hm_die 4 "unknown kind: $kind"
  local json kv k v seen=" " rp
  json=$(jq -nc --arg id "m-$(date +%s)-$$-$RANDOM" --arg kind "$kind" --arg at "$(hm_now)" \
    --arg by "${HM_AGENT:-owner}" '{id:$id,kind:$kind,at:$at,by:$by}')
  for kv in "$@"; do
    case "$kv" in *=*) ;; *) hm_die 4 "expected field=value, got: $kv" ;; esac
    k="${kv%%=*}"; v="${kv#*=}"
    case " $fields " in *" $k "*) ;; *) hm_die 4 "field '$k' is not allowed for $kind" ;; esac
    case "$seen" in *" $k "*) hm_die 4 "field '$k' given twice" ;; esac
    seen="$seen$k "
    valid_value "$k" "$v"
    if { [ "$k" = path ] && [ "$kind" != remote ]; } || [ "$k" = socket ]; then
      rp=$(resolve_path "$v") || exit $?
      refuse_protected "$rp"
      if [ "$kind" = file ] || [ "$kind" = dir ]; then refuse_inside_project "$rp"; fi
      v="$rp"
    elif [ "$k" = path ]; then   # a remote path is judged on the remote by hm-remote-sync; here only its shape
      case "$v" in /*) ;; *) hm_die 4 "remote path must be absolute: $v" ;; esac
      case "/$v/" in */../*|*/./*) hm_die 4 "'.' or '..' segment in path: $v" ;; esac
      [ "$v" = / ] && hm_die 4 "refused path: /"
    fi
    json=$(printf '%s' "$json" | jq -c --arg k "$k" --arg v "$v" '. + {($k): $v}')
  done
  for k in $(required "$kind"); do case "$seen" in *" $k "*) ;; *) hm_die 4 "$kind needs $k=" ;; esac; done
  if [ "$kind" = process ]; then
    local pid started command pgid
    pid=$(printf '%s' "$json" | jq -r .pid)
    hm_alive "$pid" || hm_die 4 "process $pid is not running"
    started=$(hm_lstart "$pid"); command=$(ps -o command= -p "$pid"); pgid=$(ps -o pgid= -p "$pid" | tr -d ' ')
    json=$(printf '%s' "$json" | jq -c --arg s "$started" --arg c "$command" --arg g "$pgid" '. + {started:$s, command:$c, pgid:$g}')
  fi
  printf '%s\n' "$json" >> "$FILE"
  printf '%s\n' "$json" | jq -r .id
}
cmd_list() {
  if [ "${1:-}" = "--kind" ]; then jq -c --arg k "${2:-}" 'select(.kind == $k)' "$FILE"; else jq -c . "$FILE"; fi
}
cmd_drop() {
  local tmp; [ -n "${1:-}" ] || hm_die 64 "usage: hm-manifest drop <id>"
  [ -n "$(jq -r --arg id "$1" 'select(.id == $id) | .id' "$FILE")" ] || hm_die 4 "no such entry: $1"
  tmp=$(mktemp "$STATE/manifest.XXXXXX") && jq -c --arg id "$1" 'select(.id != $id)' "$FILE" > "$tmp" && mv "$tmp" "$FILE"
}
with_lock() {  # every write to the manifest runs under one mkdir lock
  local wait="${HM_LOCK_WAIT_S:-10}" tries=0 json
  json=$(hm_holder_json $$)
  until hm_lock_try "$LOCK" "$json"; do
    tries=$((tries + 1)); [ "$tries" -gt $((wait * 10)) ] && hm_die 75 "manifest is locked by another hivemind process"
    sleep 0.1
  done
  trap 'hm_lock_release "$LOCK" $$' EXIT
  "$@"; local s=$?
  hm_lock_release "$LOCK" $$; trap - EXIT
  return $s
}
case "${1:-}" in
  add)  shift; with_lock cmd_add "$@" ;;
  list) shift; cmd_list "$@" ;;
  drop) shift; with_lock cmd_drop "$@" ;;
  *) echo "usage: hm-manifest add <kind> k=v... | list [--kind k] | drop <id>" >&2; exit 64 ;;
esac

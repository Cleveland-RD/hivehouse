#!/usr/bin/env bash
# One heavy job at a time on this machine, shared by every project. The lock lives in the fixed machine home
# (never under a project), so callers with any cwd or environment meet the same one. mkdir is the lock; see hm-lib.sh
# for the stale rules. A holder is its pid AND that pid's start time, so a reused pid is not mistaken for it.
# `kill -9` of `hm-slot run` frees the slot (its pid is gone) while the command it started may still be running.
#   hm-slot run <label> -- <command...>   hold while the command runs; exit 75 with the holder on stderr if busy
#   hm-slot acquire <label> --pid <pid>   hold for a long-lived process (freed when that process dies)
#   hm-slot release --pid <pid> [--label <l>]   release; refused unless pid and its start time are the holder's
#   hm-slot status                        holder JSON, or "free"
set -u
. "$(dirname "$0")/hm-lib.sh"
PROJECT=$(hm_project_root 2>/dev/null) || PROJECT=""   # machine-wide: works outside any repo, records the project only if found
HOME_DIR=$(hm_home); LOCK="$HOME_DIR/slot.lock"

take() {  # take <label> <pid>: 0 held, 75 busy (the holder is printed)
  local json
  json=$(hm_holder_json "$2" "$(jq -nc --arg label "$1" --arg project "$PROJECT" --arg agent "${HM_AGENT:-owner}" \
    --arg since "$(hm_now)" '{label:$label,project:$project,agent:$agent,since:$since}')") || return 1
  mkdir -p "$HOME_DIR"
  hm_lock_try "$LOCK" "$json" && return 0
  cat "$LOCK/holder.json" >&2 2>/dev/null; echo "hm-slot: busy; the lock is $LOCK (a holder whose process is gone is taken over; remove the directory by hand only if it is not)" >&2; return 75
}
case "${1:-}" in
  run)
    [ $# -ge 3 ] || hm_die 64 "usage: hm-slot run <label> -- <command...>"
    label="$2"; shift 2; [ "${1:-}" = "--" ] && shift
    [ $# -gt 0 ] || hm_die 64 "usage: hm-slot run <label> -- <command...>"
    take "$label" $$ || exit $?
    trap 'hm_lock_release "$LOCK" $$' EXIT
    trap 'exit 130' INT; trap 'exit 143' TERM
    "$@"; exit $? ;;
  acquire)
    [ "${3:-}" = "--pid" ] && [ -n "${4:-}" ] || hm_die 64 "usage: hm-slot acquire <label> --pid <pid>"
    case "$4" in *[!0-9]*) hm_die 64 "pid must be a number" ;; esac
    hm_alive "$4" || hm_die 4 "pid $4 is not running"
    take "$2" "$4" || exit $? ;;
  release)
    shift; pid=""; label=""
    while [ $# -gt 0 ]; do case "$1" in
      --pid) pid="${2:-}"; shift 2 ;; --label) label="${2:-}"; shift 2 ;;
      *) hm_die 64 "usage: hm-slot release --pid <pid> [--label <label>]" ;; esac; done
    [ -n "$pid" ] || hm_die 64 "usage: hm-slot release --pid <pid> [--label <label>]"
    [ -d "$LOCK" ] || exit 0
    if [ -n "$label" ] && [ "$(hm_json_get "$LOCK/holder.json" .label)" != "$label" ]; then
      hm_die 4 "slot is not held under the label $label"; fi
    hm_lock_release "$LOCK" "$pid" || hm_die 4 "slot is not held by pid $pid" ;;
  status)
    if [ -d "$LOCK" ] && ! hm_lock_stale "$LOCK"; then
      if [ -s "$LOCK/holder.json" ]; then jq -c . "$LOCK/holder.json"; else echo '{"pending":true}'; fi
    else echo free; fi ;;
  *) echo "usage: hm-slot run|acquire|release|status" >&2; exit 64 ;;
esac

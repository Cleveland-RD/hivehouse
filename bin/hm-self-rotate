#!/usr/bin/env bash
# The orchestrator's last act: rotate its own pane. Returns at once; the rotation runs detached, with all three streams
# redirected so it survives the end of the tool call that started it (A12).
# hm-self-rotate <agent> [hm-rotate options]
set -u
. "$(dirname "$0")/hm-lib.sh"
if [ "${1:-}" != "--detached" ]; then
  [ -n "${1:-}" ] || hm_die 64 "usage: hm-self-rotate <agent> [--still s] [--max s] [--settle s]"
  ROOT=$(hm_project_root) || exit $?
  mkdir -p "$ROOT/.hivemind" || exit $?
  LOG="$ROOT/.hivemind/rotate.out"
  HM_PROJECT="$ROOT" nohup "$0" --detached "$@" </dev/null >>"$LOG" 2>&1 &
  exit 0
fi
shift
exec "$(dirname "$0")/hm-rotate" "$@"

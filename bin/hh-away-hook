#!/bin/bash -p
# PreToolUse hook for a session hivehouse launched in bypass while the owner is away (the launch marker). It denies (exit 2,
# reason on stderr) what leaves the machine or lets the session out of the marker: MCP tools outside the owner's allowlist,
# Bash that pushes, publishes or uploads, starts Claude or a tmux window, or writes Claude Code's settings and hook files,
# SendMessage to anyone outside the session's own team, and Edit/Write to those same files.
# It reads its session's launch env, which a Bash command cannot change: HH_AWAY_BYPASS=1 (the marker), HH_AWAY_HUB (the
# hub's folder), HH_PROJECT (the project's home; the hub's own folder or nothing for the hub), HH_AWAY_MCP_ALLOW (the owner's
# away_mcp_allow, comma-separated, may be empty). Without the marker it exits 0 at once, before anything is read. With it,
# anything it cannot read or parse is a denial.
# Matching is by tokens and is not complete (`$'\x67'it push` and `g${e}it push` get through; the text of a script file it runs is read, KI-26).
PATH=/usr/bin:/bin:/usr/sbin:/sbin   # first of all: every program the hook and hh-lib.sh run by name comes from here, never from a PATH the session's Bash command set
[ "${HH_AWAY_BYPASS:-}" = 1 ] || { cat >/dev/null; exit 0; }
set -u
# Any exit that is not 0 or an explicit denial (a bash error, an unset variable, a missing library) is a denial too: Claude Code
# treats exit 1 as "no decision" and would let the tool run.
trap 'rc=$?; [ "$rc" -eq 0 ] || { [ -n "${DENIED:-}" ] || echo "Refused by hivehouse away mode: the check itself failed, which counts as a denial. Tell the owner." >&2; exit 2; }' EXIT
: "${HOME:?HOME is not set}"
HH_BIN=${0%/*}; [ "$HH_BIN" != "$0" ] || HH_BIN=.   # parameter expansion, never dirname: an executable on PATH by that name would be run instead
. "$HH_BIN/hh-lib.sh" || exit 2

deny() { DENIED=1; printf 'Refused by hivehouse away mode (the owner is away; this is not a permission prompt): %s. Do not try to change settings, hooks or permissions to get round it; tell the owner what you needed.\n' "$1" >&2; exit 2; }
CONF="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
WRAPPERS=" command exec nohup env sudo doas time nice ionice timeout stdbuf builtin eval xargs sh bash zsh dash ksh setsid if then else elif do while until ! { "

canon() {  # canon <path> <cwd>: absolute, ~ and $HOME expanded, dot segments collapsed, symlinks of an existing parent resolved
  local p="$1" d out="" seg IFS=/ parts
  case "$p" in "~") p="$HOME" ;; "~/"*) p="$HOME/${p#\~/}" ;; esac
  p=${p//\$\{HOME\}/$HOME}; p=${p//\$HOME/$HOME}
  case "$p" in /*) ;; *) p="$2/$p" ;; esac
  set -f; parts=($p); set +f
  for seg in ${parts[@]+"${parts[@]}"}; do
    case "$seg" in ''|.) ;; ..) out=${out%/*} ;; *) out="$out/$seg" ;; esac
  done
  out=${out:-/}
  d=$(dirname "$out")
  if [ -d "$d" ]; then d=$(cd -P "$d" 2>/dev/null && pwd -P) && out="${d%/}/$(basename "$out")"; fi
  printf '%s\n' "$out"
}
# P_WHY is why the last path asked about is refused (set by protected_one and protected): the refusal says it.
P_WHY="Claude Code's settings, hook and plugin files cannot be changed from an away session"
protected_one() {  # protected_one <canonical path>: 0 when Claude Code's settings, hook files, plugins or MCP config, the hub's records or a team.json
  local p="$1" b="${1##*/}" d="${1%/*}" c
  P_WHY="Claude Code's settings, hook and plugin files cannot be changed from an away session"
  c=$(canon "$CONF" /); h=$(canon "$HOME" /)
  [ "$p" = "$h/.claude.json" ] || [ "$p" = "$c/.claude.json" ] && return 0
  case "$b" in settings*.json) { [ "$d" = "$c" ] || [ "${d##*/}" = .claude ]; } && return 0 ;; esac
  case "$b" in .mcp.json|hooks.json) return 0 ;; esac
  case "$p" in "$c/plugins"|"$c/plugins/"*|"$c/hooks"|"$c/hooks/"*|*/.claude/hooks/*) return 0 ;; esac
  [ -z "${CLAUDE_PLUGIN_ROOT:-}" ] || { r=$(canon "$CLAUDE_PLUGIN_ROOT" /); case "$p" in "$r"|"$r/"*) return 0 ;; esac; }
  # the hub's records (hub.json is the identity away_hub_caller checks and the hub a SendMessage resolves by pid; projects.json lists what
  # may get bypass): only the hub's own session writes them, and any other marked session is refused
  if [ "$PROJ_REAL" != "$HUB" ]; then
    case "$p" in "$HUB/$HH_HUB_DIR"|"$HUB/$HH_HUB_DIR/"*)
      P_WHY="the hub's records ($HH_HUB_DIR) can be changed only by the hub's own session, never by an agent's or an orchestrator's"; return 0 ;; esac
  fi
  # ssh's folder: known_hosts and keys decide whom a session trusts and as whom it signs in (the config is not read for a listed host: -F none)
  case "$p" in "$h/.ssh"|"$h/.ssh/"*) P_WHY="ssh's folder (~/.ssh: keys, known hosts, config) cannot be changed from an away session"; return 0 ;; esac
  # a team.json names every agent's process: hivehouse's own scripts write it from their code, never a session's tools (the hub's too)
  case "$p" in */"$HH_STATE_DIR"/team.json) P_WHY="a team's team.json is written by hivehouse's own scripts, never through a session's tools"; return 0 ;; esac
  return 1
}
protected() {  # protected <path> <cwd>: the path itself, and where its links lead (a write goes to the target); a link loop counts
  local a l n=0
  P_WHY="Claude Code's settings, hook and plugin files cannot be changed from an away session"
  a=$(canon "$1" "$2"); protected_one "$a" && return 0
  while [ -L "$a" ] && [ "$n" -lt 8 ]; do
    l=$(readlink "$a") || return 0
    case "$l" in /*) ;; *) l="$(dirname "$a")/$l" ;; esac
    a=$(canon "$l" /); protected_one "$a" && return 0
    n=$((n + 1))
  done
  [ ! -L "$a" ] || return 0
  return 1
}

# --- inputs
hh_jq_resolve
[ -n "$HH_JQ" ] || deny "no root-owned jq was found (/usr/bin/jq, /usr/local/bin/jq or /opt/homebrew/bin/jq), so the tool call cannot be checked"
input=$(cat) || deny "its input could not be read"
tool=$(printf '%s' "$input" | "$HH_JQ" -er '.tool_name | strings' 2>/dev/null) || deny "its input is not a tool call"
cwd=$(printf '%s' "$input" | "$HH_JQ" -r '.cwd // empty | strings' 2>/dev/null) || deny "its input could not be parsed"
[ -n "$cwd" ] || cwd=$PWD
[ -n "${HH_PROJECT:-}" ] || deny "the project (HH_PROJECT) is missing from the session's launch env"
[ -n "${HH_AWAY_HUB:-}" ] && [ -d "$HH_AWAY_HUB/$HH_HUB_DIR" ] || deny "the hub's folder (HH_AWAY_HUB) is missing or unreadable"
HUB=$(cd -P "$HH_AWAY_HUB" && pwd -P) || deny "the hub's folder cannot be read"
PROJ_REAL=$(cd -P "$HH_PROJECT" 2>/dev/null && pwd -P) || PROJ_REAL=""   # a project that cannot be read is no hub: the stricter reading
allow=${HH_AWAY_MCP_ALLOW-}

mcp_check() {
  local e
  IFS=, read -ra es <<< "$allow"
  for e in ${es[@]+"${es[@]}"}; do
    e=${e// /}; [ -n "$e" ] || continue
    case "$e" in
      mcp__*) [ "$tool" = "$e" ] && return 0 ;;
      *) [ "$tool" = "$e" ] && return 0; case "$tool" in "mcp__${e}__"?*) return 0 ;; esac ;;
    esac
  done
  deny "$tool is not allowed while the owner is away (the owner's away_mcp_allow lists what is)"
}

# KI-25: Workflow, WebFetch, DesignSync, ArtifactCheck and PushNotification pass only when the owner listed them with `hh-hub away --tools`, which
# is the tools= line of the root-owned delegate file, read the way ssh_gate reads hosts=: never from the session's env, which it could not have set
# for itself anyway. A file that is missing, invalid, or names another hub grants none. (CronCreate and ScheduleWakeup are not in the matcher at all.)
tool_check() {
  local e
  hh_delegate_mine && [ "$HH_DG_HUB" = "$HUB" ] || deny "$tool is not allowed while the owner is away (no valid delegate file for this hub; the owner chooses extra tools with hh-hub away --tools)"
  IFS=, read -ra es <<< "$HH_DG_TOOLS"
  for e in ${es[@]+"${es[@]}"}; do [ "$tool" = "$e" ] && return 0; done
  deny "$tool is not allowed while the owner is away (the owner chooses extra tools with hh-hub away --tools)"
}

# --- messages: only to the session's own hub and team, checked by name and by process
declare -a ID_NAMES ID_PIDS ID_STARTS
add_id() {  # add_id <name> <pid> <started>
  [ -n "$1" ] || return 0
  ID_NAMES+=("$1"); ID_PIDS+=("${2:-}"); ID_STARTS+=("${3:-}")
}
add_orchestrator() {  # add_orchestrator <project home>
  local o pid st full live=""
  o=$(hh_self_entry "$1"); [ -n "$o" ] || return 0
  pid=$(printf '%s' "$o" | "$HH_JQ" -r '.claude_pid // empty'); st=$(printf '%s' "$o" | "$HH_JQ" -r '.claude_started // empty')
  full=$(printf '%s' "$o" | "$HH_JQ" -r '.name_full // empty')
  [ -n "$pid" ] || return 0
  live=$(hh_session_record "$pid" .name)
  [ -z "$live" ] || add_id "$live" "$pid" "$st"
  [ -z "$full" ] || add_id "$full" "$pid" "$st"
}
add_team() {  # add_team <project home>: its orchestrator and its agents, <project>-<agent> and the short name hh-spawn gave <agent>
  local home="$1" a pp ps
  add_orchestrator "$home"
  while IFS=$'\x1f' read -r a pp ps; do
    [ -n "$a" ] || continue
    add_id "$(basename "$home")-$a" "$pp" "$ps"
    add_id "$a" "$pp" "$ps"   # the short name: only of an agent in this team's own team.json, never matched freely
  done < <("$HH_JQ" -r '.agents[]? | [.name, .pane_pid, .pane_started] | map(. // "" | tostring) | join("\u001f")' "$home/$HH_STATE_DIR/team.json" 2>/dev/null)
}
msg_check() {
  local to ref pid i n live role proj p h t
  to=$(printf '%s' "$input" | "$HH_JQ" -er '.tool_input.to' 2>/dev/null) || deny "its SendMessage target cannot be read"
  case "$to" in main) return 0 ;; esac
  # who the session is, and whom it may message
  hubpid=$(hh_json_get "$HUB/$HH_HUB_DIR/hub.json" .claude_pid); hubst=$(hh_json_get "$HUB/$HH_HUB_DIR/hub.json" .claude_started)
  hubname=$(hh_json_get "$HUB/$HH_HUB_DIR/hub.json" .name)
  add_id "$hubname" "$hubpid" "$hubst"
  proj=$(cd -P "$HH_PROJECT" 2>/dev/null && pwd -P) || proj=""   # an unreadable project has no team: only the hub and main pass
  if [ "$proj" = "$HUB" ]; then
    while IFS= read -r h; do
      [ -n "$h" ] || continue
      case "$h" in /*) ;; *) h="$HUB/$h" ;; esac
      p=$(cd -P "$h" 2>/dev/null && pwd -P) || continue
      while IFS= read -r t <&3; do add_orchestrator "$t"; done 3< <(hh_team_roots "$p")   # the home and each worktree team of it: read without git
    done < <("$HH_JQ" -r '.projects[]?.home // empty' "$HUB/$HH_HUB_DIR/projects.json" 2>/dev/null)
  else
    add_team "$proj"
  fi
  case "$to" in
    uds:*)
      pid=${to##*/}; pid=${pid%.sock}
      for i in "${!ID_PIDS[@]}"; do
        [ "${ID_PIDS[$i]}" = "$pid" ] && hh_claude_is "$pid" "${ID_STARTS[$i]}" && return 0
      done
      deny "the message target $to is not the session's own hub or team" ;;
  esac
  n=$to
  case "$n" in *" ["*"]") n=${n% \[*} ;; esac
  # a name that a live session of another process also carries is not proof
  live=""
  for f in "$CONF"/sessions/*.json; do
    [ -f "$f" ] || continue
    pid=$("$HH_JQ" -r --arg n "$n" 'select(.name == $n) | .pid // empty' "$f" 2>/dev/null) || continue
    [ -n "$pid" ] && hh_alive "$pid" && hh_is_claude "$pid" || continue
    live="$live $pid "
  done
  for i in "${!ID_NAMES[@]}"; do
    [ "${ID_NAMES[$i]}" = "$n" ] || continue
    hh_claude_is "${ID_PIDS[$i]}" "${ID_STARTS[$i]}" || continue
    case "$live" in *[!\ ]*) ;; *) return 0 ;; esac   # no live record under the name: nothing to impersonate it
    for pid in $live; do [ "$pid" = "${ID_PIDS[$i]}" ] || deny "another live session also carries the name $n"; done
    return 0
  done
  deny "the message target $to is not the session's own hub or team"
}

# --- files
file_check() {
  local f
  f=$(printf '%s' "$input" | "$HH_JQ" -er '.tool_input | (.file_path // .notebook_path) | strings' 2>/dev/null) || deny "its file path cannot be read"
  protected "$f" "$cwd" && deny "$P_WHY"
  return 0
}

# --- Bash
bn() { local t=${1##*/}; printf '%s' "$t"; }
# KI-23: a heredoc body is data, not commands, only when the command that reads it does not run it. heredoc_strip prints the command
# with such bodies removed (an unquoted body keeps only its lines with $( or a backtick, which the segment reading then checks as
# before). Bodies are dropped only when EVERY command in the WHOLE call (each stage of each pipeline and list, on every line outside a
# body) is a known reader: cd, cat, grep, jq, wc, head, tail, sort, uniq, or hh-hub task / hh-hub decide (the only hh- commands that
# read a text from stdin). A list of runners would fail open for every program missing from it, so the call is held to a list of what is
# safe instead, and one unknown command anywhere (`bash s.sh` on a later line, `eval "$x"` after a $(cat <<EOF)) keeps every body checked.
# A command substitution anywhere (quoted or not), a line ending in a pipe, && or || and a quote left open at a line's end also keep them.
# A << inside quotes opens nothing, and an arithmetic 1<<A is not a heredoc (its stage is no reader).
heredoc_strip() {
  awk '
    function reader(stage,   n, i, w, c, d) {   # 1 when the stage runs a command that only reads its stdin as text
      n = split(stage, w, /[ \t]+/); c = ""
      for (i = 1; i <= n; i++) { if (w[i] == "" || index(w[i], "=")) continue; c = w[i]; d = w[i + 1]; break }
      if (c == "") return 0
      sub(/^.*\//, "", c)
      if (c == "hh-hub") return (d == "task" || d == "decide") ? 1 : 0
      return index(" cd cat grep jq wc head tail sort uniq ", " " c " ") ? 1 : 0
    }
    function allreaders(line,   t, n, i, w) {   # every stage of the line is a reader; quoted text is blanked first, and a command substitution anywhere fails it
      if (index(line, "$(") || index(line, "`")) return 0
      t = line; gsub(/\047[^\047]*\047/, "X", t); gsub(/"([^"\\]|\\.)*"/, "X", t)
      n = split(t, w, /[;&|()]+/)
      for (i = 1; i <= n; i++) { if (w[i] ~ /^[ \t]*$/) continue; if (!reader(w[i])) return 0 }
      return 1
    }
    BEGIN { inq = ""; inbody = 0; all = 1; no = 0 }
    {
      line = $0
      if (inbody) {
        t = line; if (strip[ci]) sub(/^\t+/, "", t)
        if (t == delim[ci]) { ci++; if (ci > nh) inbody = 0; next }
        no++; txt[no] = line; kd[no] = bq[ci] ? "drop" : "scan"
        next
      }
      no++; txt[no] = line; kd[no] = "line"
      nh = 0; n = length(line); if (!allreaders(line)) all = 0
      tl = line; sub(/[ \t]+$/, "", tl); tail = substr(tl, length(tl))
      if (tail == "|" || tail == "\\" || substr(tl, length(tl) - 1) == "&&") all = 0
      i = 1
      while (i <= n) {
        c = substr(line, i, 1)
        if (inq == "\047") { if (c == "\047") inq = ""; i++; continue }
        if (inq == "\"") { if (c == "\\") { i += 2; continue } if (c == "\"") inq = ""; i++; continue }
        if (c == "\\") { i += 2; continue }
        if (c == "\047" || c == "\"") { inq = c; i++; continue }
        if (c == "#" && (i == 1 || substr(line, i - 1, 1) ~ /[ \t]/)) break
        if (c == "<" && substr(line, i, 2) == "<<" && substr(line, i, 3) != "<<<") {
          j = i + 2; st = 0
          if (substr(line, j, 1) == "-") { st = 1; j++ }
          while (substr(line, j, 1) ~ /[ \t]/) j++
          q = 0; d = ""; ch = substr(line, j, 1)
          if (ch == "\047" || ch == "\"") { q = 1; k = index(substr(line, j + 1), ch); if (k == 0) { i++; continue } d = substr(line, j + 1, k - 1); j = j + k + 1 }
          else { if (ch == "\\") { q = 1; j++ }
                 while (substr(line, j, 1) ~ /[A-Za-z0-9_.-]/) { d = d substr(line, j, 1); j++ } }
          if (d == "") { i++; continue }
          nh++; delim[nh] = d; strip[nh] = st; bq[nh] = q
          i = j; continue
        }
        i++
      }
      if (inq != "") nh = 0
      if (nh > 0) { inbody = 1; ci = 1 }
    }
    END {
      for (k = 1; k <= no; k++) {
        if (kd[k] == "line" || !all) print txt[k]
        else if (kd[k] == "scan" && (index(txt[k], "$(") || index(txt[k], "`"))) print txt[k]
      }
    }'
}

# --- ssh to a host the owner listed (hosts= in the root-owned delegate file): a read, nothing else
# bash_check rewrites the command (quotes and backslashes go, ; & | ( ) ` $ become line breaks) before it reads anything, so the shape of an ssh
# command cannot be read from its result: `ssh h "tmux list-panes; touch x"` would come out as a read and a LOCAL touch while the remote runs both.
# So ssh_gate reads the RAW command, and only a command that is one ssh of plain words, start to end, can pass; anything else goes on to the general
# rules, which refuse ssh. The remote words are held to an allowlist (command word and subcommand), never to bash_check: its path rules resolve on
# THIS machine. -F none is required: ssh reads ~/.ssh/config and every file it Includes, and a session that wrote `Host <alias>` there could
# redefine a listed name; with no config, hosts= names real host names (or user@host), never aliases.
SSH_PLAIN='A-Za-z0-9_.:,=+/@%\ -'   # the only characters of such a command: letters, digits, _ . : , = + / @ % - and the space
rc_deny() { deny "a remote command may only read while the owner is away ($1)"; }
remote_check() {  # remote_check <word> [<word>...]: the words ssh sends to the remote shell; denies unless they are on the read-only list
  local c="${1:-}" sub="${2:-}" a p="" ext="" txt="" sig=""
  case "$c" in
    tmux) case "$sub" in
            list-panes|list-sessions|list-windows) ;;
            capture-pane|display-message) for a in "$@"; do [ "$a" = -p ] && p=1; done; [ -n "$p" ] || rc_deny "tmux $sub prints only with -p" ;;
            *) rc_deny "tmux $sub" ;;
          esac ;;
    ls|cat|head|grep|wc|df|ps|hh-context) ;;
    tail) shift; for a in "$@"; do case "$a" in -*f*|-*F*|--follow*|--retry*) rc_deny "tail does not follow" ;; esac; done ;;
    sed) [ "$sub" = -n ] || rc_deny "sed only as sed -n <lines>p"
         [[ "${3:-}" =~ ^[0-9]+(,[0-9]+)?p$ ]] || rc_deny "sed only as sed -n <lines>p"
         shift 3; for a in "$@"; do case "$a" in -*) rc_deny "sed takes no option after its script" ;; esac; done ;;
    git) case "$sub" in
           log|show) shift 2
                     for a in "$@"; do case "$a" in
                       --no-ext-diff) ext=1 ;; --no-textconv) txt=1 ;;
                       --no-show-signature) sig=1 ;;
                       --ext-diff|--textconv|--show-signature|--output|--output=*|-c|--exec-path*|--open-files-in-pager*|-O*) rc_deny "git $sub option $a runs or writes" ;;
                     esac; done
                     [ -n "$ext" ] && [ -n "$txt" ] && [ -n "$sig" ] || rc_deny "git $sub needs --no-ext-diff --no-textconv --no-show-signature, since the remote repository's config names programs for all three" ;;
           rev-parse) ;;
           *) rc_deny "git $sub" ;;
         esac ;;
    hh-slot) [ "$sub" = status ] || rc_deny "hh-slot $sub" ;;
    hh-hub) [ "$sub" = tasks ] || rc_deny "hh-hub $sub (hh-hub status runs git status in every project, which can run core.fsmonitor)" ;;
    *) rc_deny "$c is not on the list of reads" ;;
  esac
}
ssh_gate() {  # ssh_gate <raw command>: 1 = not an allowed ssh (the general rules decide, and refuse ssh); 0 = allowed; denies a listed-host ssh that breaks the shape
  local c="$1" w i o host e hosts
  c=${c#"${c%%[![:space:]]*}"}
  case "$c" in "ssh "*) ;; *) return 1 ;; esac
  case "$c" in *[!${SSH_PLAIN}]*) return 1 ;; esac
  hh_delegate_mine || return 1
  [ "$HH_DG_HUB" = "$HUB" ] || return 1
  hosts=$HH_DG_HOSTS   # empty: no host matches below, and the refusal says the owner listed none
  set -f; w=($c); set +f
  { [ "${w[1]:-}" = -F ] && [ "${w[2]:-}" = none ]; } || deny "ssh to a listed host needs -F none right after ssh: no ssh config is read while the owner is away, so hosts= names real host names"
  i=3
  while :; do
    case "${w[$i]:-}" in
      -T) i=$((i + 1)) ;;
      -o) o=${w[$((i + 1))]:-}
          case "$o" in
            BatchMode=yes) ;;
            ConnectTimeout=?*) case "${o#ConnectTimeout=}" in *[!0-9]*) deny "ssh -o ConnectTimeout takes digits only while the owner is away" ;; esac ;;
            *) deny "ssh -o $o is not allowed while the owner is away (only ConnectTimeout=<digits> and BatchMode=yes)" ;;
          esac
          i=$((i + 2)) ;;
      -*) deny "ssh option ${w[$i]} is not allowed while the owner is away (only -F none, -T, -o ConnectTimeout=<digits>, -o BatchMode=yes)" ;;
      *) break ;;
    esac
  done
  host=${w[$i]:-}; [ -n "$host" ] || deny "ssh needs a host"
  o=""; IFS=, read -ra e <<< "$hosts"
  for o in ${e[@]+"${e[@]}"}; do [ "$o" = "$host" ] && break; o=""; done
  [ -n "$o" ] || deny "ssh to $host is not allowed: the owner's delegate file lists other hosts (or none)"
  [ -n "${w[$((i + 1))]:-}" ] || deny "ssh needs a remote command while the owner is away (an interactive login is not allowed)"
  remote_check "${w[@]:$((i + 1))}"
  return 0
}

# KI-26: a script a Bash call runs (`bash f`, `sh f`, `zsh f`, `. f`, `source f`, `./f`, `bash < f`, behind wrappers and their arguments, and as the code
# of `sh -c`) is read with the same rules as a command. script_operand prints the file a segment's words run, or nothing; script_check reads it and
# checks its text, up to SCRIPT_MAX levels deep (a script that sources itself ends in a refusal). A file under the plugin's own bin (by where its
# links end) is not read. A file run by path is a program, not text, when it starts with a Mach-O or ELF magic number or has a NUL byte in its first
# line (what bash itself judges binary); everything else is read as text. A file that is missing, unreadable or over SCRIPT_BYTES is refused, since
# its text cannot be checked. A shell that takes its code from somewhere the hook cannot read first is refused by uncheckable_shell.
SCRIPT_MAX=4; SCRIPT_BYTES=262144; SCRIPT_DEPTH=0
script_operand() {  # script_operand <word>...: prints "shell <file>" or "direct <file>" for the file the words run
  local mode="" t skip="" wr="" i=0
  for t in "$@"; do
    i=$((i + 1))
    if [ -z "$mode" ]; then
      [ -z "$skip" ] || { skip=""; continue; }
      case "$t" in *=*) continue ;; esac
      case "${t##*/}" in bash|sh|zsh|dash|ksh|source) mode=shell; continue ;; esac
      [ "$t" != . ] || { mode=shell; continue; }
      case "$WRAPPERS" in *" $t "*) wr=$t; continue ;; esac
      case "$t" in
        -*) case "$wr:$t" in sudo:-[ugChpRTU]|doas:-u|nice:-n|ionice:-[cnp]|stdbuf:-[ioe]|timeout:-[sk]|env:-[uCS]|xargs:-[IndLPsEaJ]) skip=1 ;; esac; continue ;;
      esac
      if [ -n "$wr" ] && [[ "$t" =~ ^[0-9][0-9.]*[smhd]?$ ]]; then continue; fi   # a duration or a number behind a wrapper
      case "$t" in */*) printf 'direct %s\n' "$t" ;; esac
      return 0
    fi
    [ -z "$skip" ] || { skip=""; continue; }
    case "$t" in
      -o|+o|-O|+O) skip=1; continue ;;
      --*) continue ;;
      -*c*) script_operand "${@:$((i + 1))}"; return 0 ;;   # sh -c '<code>': the code's words are a command of their own
      -*|+*) continue ;;
    esac
    printf 'shell %s\n' "$t"; return 0
  done
}
script_is_program() {  # script_is_program <file> <mode>: 0 when the file is a program, not text
  local m
  [ "$(head -c 80 "$1" | head -n 1 | tr -d '\0' | wc -c)" = "$(head -c 80 "$1" | head -n 1 | wc -c)" ] || return 0
  [ "$2" = direct ] || return 1
  m=$(head -c 4 "$1" | od -An -tx1 | tr -d ' \n')
  case "$m" in feedface|feedfacf|cafebabe|cefaedfe|cffaedfe|bebafeca|7f454c46) return 0 ;; esac
  return 1
}
script_check() {  # script_check <mode> <file> <cwd>
  local mode="$1" f rf l c n text k=0
  f=$(canon "$2" "$3"); rf=$f
  while [ -L "$rf" ] && [ "$k" -lt 8 ]; do   # where the links end, not only the folder: a link in the plugin's bin can lead anywhere
    l=$(readlink "$rf") || break
    case "$l" in /*) ;; *) l="${rf%/*}/$l" ;; esac
    rf=$(canon "$l" /); k=$((k + 1))
  done
  c=$(canon "$HH_BIN" /); [ -L "$rf" ] || case "$rf" in "$c"/*) return 0 ;; esac
  [ -e "$f" ] && [ -f "$f" ] && [ -r "$f" ] || deny "the script $2 is not a file the hook can read, so its text cannot be checked"
  script_is_program "$f" "$mode" && return 0
  n=$(wc -c < "$f" 2>/dev/null | tr -d ' ') || n=""
  case "$n" in ''|*[!0-9]*) deny "the script $2 cannot be read, so its text cannot be checked" ;; esac
  [ "$n" -le "$SCRIPT_BYTES" ] || deny "the script $2 is over $SCRIPT_BYTES bytes, too large to check while the owner is away"
  SCRIPT_DEPTH=$((SCRIPT_DEPTH + 1))
  [ "$SCRIPT_DEPTH" -le "$SCRIPT_MAX" ] || deny "scripts run scripts more than $SCRIPT_MAX levels deep, which cannot be checked while the owner is away"
  text=$(cat "$f" 2>/dev/null) || deny "the script $2 cannot be read, so its text cannot be checked"
  bash_text "$text" "$3"
  SCRIPT_DEPTH=$((SCRIPT_DEPTH - 1))
}
uncheckable_shell() {  # uncheckable_shell <command text>: refuses a shell that takes its code from a pipe, a substitution or a program's output, none of which the hook can read first
  local c sh='(bash|sh|zsh|dash|ksh)' p='([A-Za-z0-9_./-]*/)?' w='((sudo|env|command|exec|nohup|time|nice|timeout|stdbuf)[[:space:]]+(-[^[:space:]]+[[:space:]]+|[0-9][0-9.smhd]*[[:space:]]+)*)*'
  c=$(printf '%s' "$1" | tr '\n' ' ')
  printf '%s' "$c" | grep -qE "(^|[^|])\|&?[[:space:]]*${w}${p}${sh}([[:space:];&)]|$)" && deny "a shell fed by a pipe reads code the hook cannot check first, which is not allowed while the owner is away"
  printf '%s' "$c" | grep -qE "(${sh}[^;&|]*|(^|[;&|(])[[:space:]]*(\.|source)[[:space:]]+)<\(" && deny "a shell reading a process substitution reads code the hook cannot check first, which is not allowed while the owner is away"
  printf '%s' "$c" | grep -qE "${sh}[[:space:]]+([^;&|]*[[:space:]])?-[A-Za-z]*c[[:space:]]+[^;&|]*(\\\$\(|\`)" && deny "a shell given code from a command substitution reads code the hook cannot check first, which is not allowed while the owner is away"
  printf '%s' "$c" | grep -qE "(^|[;&|(])[[:space:]]*(builtin[[:space:]]+|command[[:space:]]+)?eval[[:space:]][^;&|]*(\\\$|\`)" && deny "eval of a variable or substitution runs code the hook cannot check first, which is not allowed while the owner is away"
  printf '%s' "$c" | grep -qE "xargs[^;&|]*[[:space:]]${p}${sh}([[:space:];&)]|$)" && deny "xargs feeding a shell runs code the hook cannot check first, which is not allowed while the owner is away"
  printf '%s' "$c" | grep -qE "-exec(dir)?[[:space:]]+${p}${sh}([[:space:];&)]|$)" && deny "find -exec with a shell runs code the hook cannot check first, which is not allowed while the owner is away"
  if printf '%s' "$c" | grep -qE "(^|[[:space:];&|(])(BASH_ENV|ENV)="; then
    printf '%s' "$c" | grep -qE "(^|[[:space:]/])${sh}([[:space:];&)]|$)" && deny "BASH_ENV or ENV beside a shell makes it run a file the hook cannot check first, which is not allowed while the owner is away"
  fi
  return 0
}
bash_check() {
  local cmd
  cmd=$(printf '%s' "$input" | "$HH_JQ" -er '.tool_input.command | strings' 2>/dev/null) || deny "its command cannot be read"
  ssh_gate "$cmd" && return 0   # one ssh of plain words to a listed host, a read: the rest of this function is for everything else
  bash_text "$cmd" "$cwd"
}
bash_text() {  # bash_text <command text> <cwd>: the rules for a command; a script's text is run through it again
  local cmd="$1" cwd="$2" s seg tok toks ws i first second prev have_git="" have_push="" have_pub="" have_dock="" pkgm="" wr rt cmdw fb a b nx so seen kf kro
  local -a scripts=()
  cmd=$(printf '%s\n' "$cmd" | heredoc_strip)
  uncheckable_shell "$cmd"
  s=${cmd//\'/}; s=${s//\"/}; s=${s//\\/}
  # redirect targets are looked at before the punctuation goes
  while IFS= read -r rt; do
    rt=${rt#>}; rt=${rt#>}; rt=${rt#|}; rt=${rt# }; rt=${rt//[[:space:]]/}
    [ -n "$rt" ] && protected "$rt" "$cwd" && deny "a redirect is refused: $P_WHY"
  done < <(printf '%s\n' "$s" | grep -oE '>[>|]?[[:space:]]*[^[:space:];&|()<>]+' 2>/dev/null || true)
  s=${s//\$HOME/$HOME}
  s=$(printf '%s' "$s" | sed -E 's/([A-Za-z0-9_-])\(/\1 /g')   # "fix(scope):" in a message is not a subshell: only a ( after a space or an operator opens one
  # segments: one per simple command (separators become newlines); < > = tab become spaces for the token reading
  local segs; segs=$(printf '%s' "$s" | tr ';&|()`$' '\n\n\n\n\n\n\n' | tr '<>\t' '   ')
  set -f
  while IFS= read -r seg; do
    [ -n "${seg//[[:space:]]/}" ] || continue
    ws=($seg)                                  # whitespace tokens, "name=value" kept whole
    toks=(${seg//=/ })                         # A32 tokens
    # the command word: past wrappers, their options, numbers after them and "name=value" prefixes
    first=""; wr=""
    for tok in ${ws[@]+"${ws[@]}"}; do
      case "$tok" in *=*) [ -z "$first" ] && continue ;; esac
      case "$WRAPPERS" in *" $tok "*) wr=1; continue ;; esac
      case "$tok" in -*) continue ;; esac
      if [ -n "$wr" ]; then case "$tok" in ''|*[!0-9]*) ;; *) continue ;; esac; fi
      first=$tok; break
    done
    fb=$(bn "$first")
    for tok in ${toks[@]+"${toks[@]}"}; do
      case "$(bn "$tok")" in
        git) have_git=1 ;;
        npm|pnpm|yarn) pkgm=1 ;;
        docker) have_dock=1 ;;
      esac
      case "$tok" in push) have_push=1 ;; publish) have_pub=1 ;; esac
    done
    # command-position names
    cmdw=$fb
    if [ "$fb" = hh-slot ]; then
      cmdw=""; prev=""
      for tok in ${ws[@]+"${ws[@]}"}; do [ "$prev" = -- ] && { cmdw=$(bn "$tok"); break; }; prev=$tok; done
    fi
    case "$cmdw" in
      hh-push) deny "hh-push is not allowed while the owner is away" ;;
      hh-remote-sync) deny "hh-remote-sync is not allowed while the owner is away" ;;
      ssh|vercel|netlify) deny "$cmdw is not allowed while the owner is away" ;;
      scp|sftp) deny "$cmdw is not allowed while the owner is away" ;;
      claude) deny "starting Claude by hand is not allowed from an away session; hh-spawn and hh-hub start sessions" ;;
    esac
    case "$cmdw" in cd|pushd|popd)   # a relative script path later in the call is read from where the call has moved to; an unknown place is refused
      nx=""; seen=""
      for tok in ${ws[@]+"${ws[@]}"}; do
        [ -n "$seen" ] || { [ "$(bn "$tok")" != "$cmdw" ] || seen=1; continue; }
        case "$tok" in -|+*) nx=-; break ;; -*) ;; *) nx=$tok; break ;; esac
      done
      case "$cmdw:$nx" in popd:*|*:""|*:-) cwd=/nonexistent-cwd ;; *) cwd=$(canon "$nx" "$cwd") ;; esac ;;
    esac
    so=$(script_operand ${ws[@]+"${ws[@]}"})
    [ -z "$so" ] || scripts+=("${so%% *}"$'\x1f'"$cwd"$'\x1f'"${so#* }")
    local has_tmux="" has_start="" has_gh="" has_rsync="" has_curl="" has_wget="" has_write=""
    for i in "${!toks[@]}"; do
      tok=${toks[$i]}
      case "$(bn "$tok")" in
        tmux) has_tmux=1 ;;
        gh) # every gh must be followed by a read-only pair
          a=${toks[$((i+1))]-}; b=${toks[$((i+2))]-}
          case "$a $b" in "pr view"|"pr list"|"pr status"|"pr diff"|"pr checks"|"run view"|"run list"|"issue view"|"issue list") ;;
            *) deny "gh is allowed only for read-only forms while the owner is away" ;; esac ;;
        rsync) has_rsync=1 ;;
        curl) has_curl=1 ;;
        wget) has_wget=1 ;;
      esac
      case "$tok" in new-window|neww|split-window|splitw|new-session|new|respawn-pane|respawnp|respawn-window|respawnw|run-shell|run|if-shell|if|display-popup|popup|pipe-pane|pipep|source-file|source|send-keys|send) has_start=1 ;; esac
    done
    [ -z "$has_tmux" ] || [ -z "$has_start" ] || deny "tmux cannot start windows or sessions, run commands or type into panes from an away session; hh-spawn and hh-hub do those"
    if [ -n "$has_rsync" ]; then
      for tok in ${toks[@]+"${toks[@]}"}; do
        case "$tok" in
          -e|--rsh*|*:*) deny "rsync to a remote is not allowed while the owner is away" ;;
        esac
      done
    fi
    if [ -n "$has_curl$has_wget" ]; then
      for i in "${!toks[@]}"; do
        tok=${toks[$i]}; nx=${toks[$((i+1))]-}
        case "$tok" in
          -X|--request|--method)
            case "$nx" in GET|HEAD) ;; *) deny "curl and wget may only read while the owner is away" ;; esac ;;
          -X?*) case "${tok#-X}" in GET|HEAD) ;; *) deny "curl and wget may only read while the owner is away" ;; esac ;;
          --data*|--form*|--upload-file|--json|--post-data*|--post-file|--body-data|--body-file) deny "curl and wget may only read while the owner is away" ;;
          --*) ;;
          -*[dFTX]*) deny "curl and wget may only read while the owner is away" ;;
        esac
      done
    fi
    # ssh-keygen -R removes a host from ~/.ssh/known_hosts, a write under ~/.ssh that names no path; with no -f it would make a key there (its default
    # path); -l, -F, -y and -B only read
    kro=""
    if [ "$cmdw" = ssh-keygen ]; then
      kf=""
      for tok in ${ws[@]+"${ws[@]}"}; do
        case "$tok" in -*R*) deny "ssh-keygen -R changes ~/.ssh/known_hosts, which cannot be changed from an away session" ;; esac
        case "$tok" in -*f*) kf=1 ;; esac
        case "$tok" in -*[lFyB]*) kro=1 ;; esac
      done
      [ -n "$kf$kro" ] || deny "ssh-keygen without -f would make a key at its default path under ~/.ssh, which cannot be changed from an away session"
    fi
    # a write into a protected file by a command that writes
    case "$cmdw" in ssh-keygen|tee|cp|mv|rm|ln|install|dd|sed|perl|python|python3|node|ruby|truncate|touch|chmod|chown|patch|sponge|scp|sftp|rsync) has_write=1 ;; esac
    [ -z "$kro" ] || has_write=""
    if [ -n "$has_write" ]; then
      for tok in ${toks[@]+"${toks[@]}"}; do
        case "$tok" in -*) continue ;; esac
        protected "$tok" "$cwd" && deny "a command that writes is refused: $P_WHY"
      done
    fi
  done <<EOF
$segs
EOF
  set +f
  [ -z "$have_git$have_push" ] || { [ -n "$have_git" ] && [ -n "$have_push" ] && deny "git push is not allowed while the owner is away (a quoted \"push\" beside git counts: rephrase)"; }
  [ -z "$pkgm" ] || [ -z "$have_pub" ] || deny "publishing a package is not allowed while the owner is away"
  [ -z "$have_dock" ] || [ -z "$have_push" ] || deny "docker push is not allowed while the owner is away"
  local e m d f
  for e in ${scripts[@]+"${scripts[@]}"}; do
    IFS=$'\x1f' read -r m d f <<< "$e"
    script_check "$m" "$f" "$d"
  done
  return 0
}

agent_check() {  # an Agent call passes unless it starts a cloud agent, which carries no marker
  local iso
  iso=$(printf '%s' "$input" | "$HH_JQ" -er '.tool_input.isolation // "" | strings' 2>/dev/null) || deny "the Agent call's isolation cannot be read"
  [ "$iso" != remote ] || deny "a remote (cloud) agent starts with no marker and is not allowed while the owner is away"
  return 0
}
main() {
  case "$tool" in
    Bash) bash_check ;;
    mcp__*|Artifact|ArtifactData|ArtifactComments|RemoteTrigger) mcp_check ;;
    Agent) agent_check ;;
    Workflow|WebFetch|DesignSync|ArtifactCheck|PushNotification) tool_check ;;
    SendMessage) msg_check ;;
    Edit|Write|MultiEdit|NotebookEdit) file_check ;;
    *) deny "$tool is not a tool this hook was set up for" ;;
  esac
}
main
exit 0

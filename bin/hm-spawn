#!/usr/bin/env bash
# Start an agent in tmux with its role, rules and (optionally) its own worktree; or, with --self, register the calling
# pane as the orchestrator. Takes no command to run: it always starts `claude`. Never answers a dialog.
# Exit: 2 no project or no tmux pane, 3 .hivemind tracked, 4 refused value, 5 a dialog needs a person, 1 never idle,
# 64 usage.
set -u
. "$(dirname "$0")/hm-lib.sh"
USAGE="usage: hm-spawn --agent <n> --role <file> --rules <file> --model <m> --effort <e> --mode <m> [--worktree <abs> --branch <b> --base <b>] [--session <s>] [--window <tokens>] [--still <s>] [--max-wait <s>]
       hm-spawn --self --agent <n> [--name <orchestrator session name>] [--window <tokens>]"
# The only commands an agent may run without asking (A16): nothing here runs an arbitrary command, writes a chosen path
# (no git: --output=<path> writes anywhere; Claude Code already runs the read-only forms unprompted) or edits the
# manifest (a pre-approved `hm-manifest add` would let cleanup remove a path, pane or pid nobody named).
ALLOWED='Bash(hm-slot status) Bash(hm-slot release *) Bash(hm-context *) Bash(hm-gate-verify *) Bash(hm-settings resolve *) Bash(hm-disk *)'

agent=""; role=""; rules=""; model=""; effort=""; mode=""; wt=""; branch=""; base=""; session=""; window=200000
still=5; maxwait=90; self=0; others=0; oname=""
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || [ "$1" = --self ] || hm_die 64 "$USAGE"
  case "$1" in
    --self) self=1; shift; continue ;;
    --agent) agent="$2" ;; --window) window="$2" ;; --name) oname="$2" ;;
    --role) role="$2"; others=1 ;; --rules) rules="$2"; others=1 ;; --model) model="$2"; others=1 ;;
    --effort) effort="$2"; others=1 ;; --mode) mode="$2"; others=1 ;; --worktree) wt="$2"; others=1 ;;
    --branch) branch="$2"; others=1 ;; --base) base="$2"; others=1 ;; --session) session="$2"; others=1 ;;
    --still) still="$2"; others=1 ;; --max-wait) maxwait="$2"; others=1 ;;
    *) hm_die 64 "$USAGE" ;;
  esac
  shift 2
done
num() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; }
[ -n "$agent" ] || hm_die 64 "$USAGE"
hm_is_agent_name "$agent" || hm_die 4 "bad agent name: $agent"
num "$window" && [ "$window" -gt 0 ] || hm_die 4 "--window must be a positive number: $window"
num "$still" && num "$maxwait" || hm_die 4 "--still and --max-wait must be numbers"

if [ "$self" = 1 ]; then
  [ "$others" = 0 ] || hm_die 64 "--self takes only --agent, --name and --window"
  [ -z "$oname" ] || hm_is_session_name "$oname" || hm_die 4 "--name must be one line of letters, digits, space, - _ . ( ), at most 64: $oname"
  [ -n "${TMUX_PANE:-}" ] || hm_die 2 "--self must run inside the tmux pane to register"
  ROOT=$(hm_project_root) || exit $?
  hm_ensure_state || exit $?
  export HM_PROJECT="$ROOT"
  pane="$TMUX_PANE"
  hm-manifest list --kind tmux | jq -e --arg a "$agent" 'select(.agent == $a)' >/dev/null \
    && hm_die 4 "$agent belongs to a pane hivemind spawned; --self would re-point it at this one"
  socket=$(hm_tmux display-message -p -t "$pane" '#{socket_path}') || exit $?
  mode="" ; model=""; effort=""; session=""; branch=""; wt=""
else
  [ -z "$oname" ] || hm_die 64 "--name is for --self only"
  for v in role rules model effort mode; do [ -n "${!v}" ] || hm_die 64 "$USAGE"; done
  case "$mode" in plan|dontAsk|default|acceptEdits|auto) ;; bypassPermissions) hm_die 4 "bypassPermissions is never started by hm-spawn" ;; *) hm_die 4 "unknown permission mode: $mode" ;; esac
  [ -f "$role" ] && [ -f "$rules" ] || hm_die 4 "--role and --rules must be files"
  case "$model$effort" in *[!${HM_LOWER}${HM_UPPER}${HM_DIGITS}._\[\]-]*) hm_die 4 "bad model or effort" ;; esac
  case "$model" in -*) hm_die 4 "a model starting with - would be read as an option: $model" ;; esac
  case "$effort" in -*) hm_die 4 "an effort starting with - would be read as an option: $effort" ;; esac
  if [ -n "$wt" ]; then
    [ -n "$branch" ] && [ -n "$base" ] || hm_die 64 "--worktree needs --branch and --base"
    case "$wt" in /*) ;; *) hm_die 4 "--worktree must be an absolute path" ;; esac
    for b in "$branch" "$base"; do hm_is_branch_name "$b" || hm_die 4 "bad branch name: $b"; done
  fi
  ROOT=$(hm_project_root) || exit $?
  hm_ensure_state || exit $?
  export HM_PROJECT="$ROOT"
fi
STATE="$ROOT/.hivemind"; project=$(basename "$ROOT")

identify() {  # identify <pane> <socket>: the pane's identity, and for --self the Claude process that is registering it
  local ident
  ident=$(hm_pane_identity "$2" "$1") || { echo "hm-spawn: cannot read pane $1 on $2, so it is not registered" >&2; return 1; }   # a file without identity is never written
  PANE_PID=${ident%%$'\t'*}; PANE_STARTED=${ident#*$'\t'}; CLAUDE_PID=""; CLAUDE_STARTED=""
  # --self: the pane's process is the owner's shell, which outlives this Claude, so the Claude process is recorded too. A spawned
  # agent's pane lives only as long as the command it runs, so its pane identity is the whole of it.
  if [ "$self" = 1 ]; then
    CLAUDE_PID=$(hm_claude_ancestor) || { echo "hm-spawn: --self must run inside the Claude session it registers" >&2; return 1; }
    CLAUDE_STARTED=$(hm_lstart "$CLAUDE_PID")
  fi
}
register() {  # register <pane> <socket>: the registry maps a pane back to its project and agent
  local dir key
  identify "$1" "$2" || return 1
  dir=$(hm_registry_dir); mkdir -p "$dir"; key=$(hm_pane_key "$2" "$1")
  jq -n --arg project "$ROOT" --arg agent "$agent" --arg pane "$1" --arg socket "$2" --arg now "$(hm_now)" \
    --arg ppid "$PANE_PID" --arg pstarted "$PANE_STARTED" --arg cpid "$CLAUDE_PID" --arg cstarted "$CLAUDE_STARTED" \
    '{project:$project, agent:$agent, pane:$pane, socket:$socket, created:$now, pane_pid:$ppid, pane_started:$pstarted}
     + (if $cpid != "" then {claude_pid:$cpid, claude_started:$cstarted} else {} end)' > "$dir/$key.json.tmp$$" \
    && mv "$dir/$key.json.tmp$$" "$dir/$key.json"
}
upsert_team() {  # upsert_team <json object for the agent>: one entry per agent name
  local f="$STATE/team.json" cur='{"agents":[]}'
  [ -f "$f" ] && cur=$(cat "$f")
  printf '%s' "$cur" | jq --argjson a "$1" '.agents = ([.agents[]? | select(.name != $a.name)] + [$a])' > "$f.tmp$$" \
    && mv "$f.tmp$$" "$f"
}

if [ "$self" = 1 ]; then
  # The calling pane is the owner's own: it is registered and recorded in team.json, never on the manifest, because
  # hm-cleanup kills every pane the manifest names.
  register "$pane" "$socket" || exit $?
  # the session's own name, as agents are told to report to it (hm_orchestrator_name reads it live; this is its fallback)
  [ -n "$oname" ] || { oname=$(hm_session_record "$CLAUDE_PID" .name); hm_is_session_name "$oname" || oname=""; }
  upsert_team "$(jq -nc --arg n "$agent" --arg p "$pane" --arg s "$socket" --argjson w "$window" --arg pp "$PANE_PID" --arg ps "$PANE_STARTED" --arg cp "$CLAUDE_PID" --arg cs "$CLAUDE_STARTED" --arg nf "$oname" \
    '{name:$n, pane:$p, socket:$s, window:$w, pane_pid:$pp, pane_started:$ps} + (if $cp != "" then {claude_pid:$cp, claude_started:$cs} else {} end) + (if $nf != "" then {name_full:$nf} else {} end)')"
  # Its SessionStart hook ran before this registration existed, so it wrote nothing: the session is recorded here, from Claude
  # Code's own record of this process. The hook writes it again after a /clear.
  sid=$(hm_session_record "$CLAUDE_PID" .sessionId)
  if tp=$(hm_session_transcript "$sid"); then
    hm_write_session "$ROOT" "$agent" "$sid" "$tp" self || echo "hivemind: could not record $agent's session; hm-context reads ? until its next /clear" >&2
  else   # a record of another session (an earlier orchestrator's) would be read as this one's
    [ "$(hm_json_get "$STATE/team/$agent/session.json" .session_id)" = "$sid" ] || rm -f "$STATE/team/$agent/session.json"
    echo "hivemind: no single transcript found for $agent's session; hm-context reads ? until its next /clear" >&2
  fi
  echo "$pane"; exit 0
fi

cwd="$ROOT"
if [ -n "$wt" ]; then
  if [ -e "$wt" ]; then
    hm-manifest list --kind worktree | jq -e --arg p "$wt" 'select(.path == $p)' >/dev/null \
      || hm_die 4 "$wt exists and hivemind did not create it"
  else
    git -C "$ROOT" worktree add -q -b "$branch" "$wt" "$base" || hm_die 4 "git worktree add failed for $wt"
    hm-manifest add worktree path="$wt" base="$base" >/dev/null || exit $?
  fi
  cwd="$wt"
fi
mkdir -p "$STATE/team/$agent" "$STATE/handoffs"
cp "$role" "$STATE/team/$agent/role.md"; cp "$rules" "$STATE/team/$agent/RULES.md"
if [ ! -f "$STATE/handoffs/$agent.md" ]; then
  printf '# %s handoff\n\n## START HERE\n\nI am %s-%s. Report only to %s. Read .hivemind/team/%s/ (my role and the rules) first, then wait for its first message before any work.\n' \
    "$agent" "$project" "$agent" "$(hm_orchestrator_name "$ROOT")" "$agent" > "$STATE/handoffs/$agent.md"
fi

# No --session: an agent goes beside the pane that spawns it (the orchestrator's own tmux session), when that pane is on the server
# the agent is spawned on; outside tmux, or on another server, it goes to the project's own session as before.
if [ -z "$session" ] && [ -n "${TMUX_PANE:-}" ] && [ -n "${TMUX:-}" ]; then
  here=$(hm_tmux display-message -p -t "$TMUX_PANE" '#{socket_path}'$'\t''#{session_name}' 2>/dev/null) || here=""
  [ -n "$here" ] && [ "${here%%$'\t'*}" = "${TMUX%%,*}" ] && session="${here#*$'\t'}"
fi
session=${session:-hm-$(hm_project_key "$ROOT")}
# exec: the pane's own process must BE claude (the hook's one rule for a spawned agent), not a shell that happens to exec its last
# command; a shell that does not (fish, a startup file that sets a trap, `cmd; :`) would otherwise stay as the pane's process
# The agent's statusLine is hm-statusline, which keeps Claude Code's own window reading for hm-context and then runs the owner's
# statusLine, resolved here once (its other keys, padding and the like, are kept as the owner set them).
owner_sl=$(hm_owner_statusline "$cwd")
if [ -n "$owner_sl" ]; then printf '%s\n' "$owner_sl" > "$STATE/team/$agent/statusline.json"; else rm -f "$STATE/team/$agent/statusline.json"; fi
rm -f "$STATE/team/$agent/context.json"
settings=$(jq -nc --argjson o "${owner_sl:-null}" --arg bin "$(cd "$(dirname "$0")" && pwd -P)/hm-statusline" --arg dir "$STATE/team/$agent" \
  '{statusLine: (($o // {}) + {type: "command", command: ([$bin, $dir] | map(@sh) | join(" "))})}') || exit $?
cmd="exec $(printf '%q ' claude --name "$project-$agent" --model "$model" --effort "$effort" --permission-mode "$mode" --allowedTools "$ALLOWED" --settings "$settings")"
envs=(-e "HM_AGENT=$agent" -e "HM_PROJECT=$ROOT" -e "HIVEMIND_HOME=$(hm_home)")
[ -n "${HM_TMUX_SOCKET:-}" ] && envs+=(-e "HM_TMUX_SOCKET=$HM_TMUX_SOCKET")
if hm_tmux has-session -t "=$session" 2>/dev/null; then
  pane=$(hm_tmux new-window -d -P -F '#{pane_id}' -t "=$session:" -n "$agent" -c "$cwd" "${envs[@]}" "$cmd") || exit $?
else
  pane=$(hm_tmux new-session -d -P -F '#{pane_id}' -s "$session" -n "$agent" -c "$cwd" "${envs[@]}" "$cmd") || exit $?
fi
socket=$(hm_tmux display-message -p -t "$pane" '#{socket_path}') || exit $?
hm-manifest add tmux socket="$socket" pane="$pane" agent="$agent" >/dev/null || exit $?   # first: what is on the manifest can be cleaned up
register "$pane" "$socket" || exit $?
upsert_team "$(jq -nc --arg n "$agent" --arg p "$pane" --arg s "$socket" --arg m "$model" --arg e "$effort" --arg mode "$mode" \
  --arg wt "$wt" --arg b "$branch" --arg sess "$session" --argjson w "$window" --arg pp "$PANE_PID" --arg ps "$PANE_STARTED" \
  '{name:$n, pane:$p, socket:$s, model:$m, effort:$e, mode:$mode, worktree:$wt, branch:$b, session:$sess, window:$w, pane_pid:$pp, pane_started:$ps}')"

wait_idle "$pane" "$still" "$maxwait"; rc=$?
case "$rc" in
  0) ;;
  3) echo "hivemind: a dialog is waiting in pane $pane ($agent): answer it yourself; nothing was typed" >&2; exit 5 ;;
  *) echo "hivemind: pane $pane ($agent) never went idle within ${maxwait}s; nothing was sent" >&2; exit 1 ;;
esac
line=$(hm_pickup_line "$project" "$ROOT" "$agent")
hm_tmux send-keys -t "$pane" -l "$line"
hm_tmux send-keys -t "$pane" Enter
echo "$pane"

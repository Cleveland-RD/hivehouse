#!/usr/bin/env bash
# The owner's i-have-adhd output style, when it is installed and enabled: prints its SKILL.md for the orchestrator to read
# and follow in every message to the owner. hivehouse never installs or enables it (hh_adhd_skill reads only
# `claude plugin list --json` and tests one file). Exit 0 printed the path, 1 there is none to use.
set -u
. "$(dirname "$0")/hh-lib.sh"
hh_adhd_skill

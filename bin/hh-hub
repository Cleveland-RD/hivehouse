#!/bin/bash -p
# The owner's hub: one Claude session in the owner's work folder that knows every project, hands each task to that
# project's orchestrator, wakes an orchestrator a restart stopped and starts one where none is. It never reads or
# changes a project's code: everything here is records, tmux and fixed lines. bash 3.2 compatible.
# The hub's state is <work folder>/.hivehouse-hub/: projects.json, hub.json (the hub's own session), tasks.jsonl (the
# ledger, one event per line), tasks/<id>.md (each task's text), memory/<project>.md (the hub's notes), panes/<project>.json
# (an orchestrator this hub started, with the line it is to be sent and whether it was: kept until that session registers,
# so a start stopped at a question is continued rather than made twice), runs/<project>.json (the same for a line `run` types
# into a running orchestrator's own pane). HH_HUB names the work folder; else the nearest
# folder at or above the cwd holding .hivehouse-hub/.
# answers.jsonl is the log of dialogs answered through `answer` (a dialog belongs to no task). Away mode (the owner's
# delegate file, see bin/hh-lib.sh) adds away.json (when `away` printed its lines), decisions/<task id>.md (what the hub
# decided for the owner, word for word), holds/<project> (projects the owner keeps the hub away from), recovery.jsonl (the
# sessions the hub started or woke, and what recover reported, with their times: the caps count within 24 hours) and
# recovery-state.json (each agent's state at the last beat).
# Exit: 2 not found (no hub, project, task, agent or record), 4 refused value or state, 5 a dialog needs a person, 1 never idle,
# 64 usage.
set -u
# Everything this writes under .hivehouse-hub/ is at most 755 for a folder and 644 for a file, whatever the caller's umask was (umask 002, the
# default where each user has their own group, would make 775 and 664, which the delegate check refuses). seal_hub puts right what an
# earlier umask made.
HH_CALLER_UMASK=$(umask)   # a pane the hub starts gets the caller's umask back: 022 is for the hub's own records, not an agent's files
umask 022
# Privileged mode (-p) skips BASH_ENV and takes no functions from the environment, and the fixed /bin/bash cannot be swapped
# through PATH: the owner's away file is judged by code nothing in the environment can change. Nothing here finds its sibling
# scripts through PATH either.
HH_BIN=${0%/*}; [ "$HH_BIN" != "$0" ] || HH_BIN=.
. "$HH_BIN/hh-lib.sh"
PLUGIN=$(hh_plugin_name) || exit $?   # the typed commands below begin /$PLUGIN:
# The ledger's vocabulary, declared once. A note never moves a task's state; done and cancelled close it; a plan to
# approve, a question and a blocker wait on the owner.
HUB_EVENTS="asked handed plan question answered blocked overnight cleanup decided done cancelled note"
HUB_CLOSED="done cancelled"
HUB_NEEDS_OWNER="plan question blocked"
HUB_CLOSED_JSON=$(printf '%s' "$HUB_CLOSED" | jq -Rc 'split(" ")')
HUB_NEEDS_OWNER_JSON=$(printf '%s' "$HUB_NEEDS_OWNER" | jq -Rc 'split(" ")')
# The words of the hub's exchange with an orchestrator, held to both skills by tests/test_hub.sh: what an orchestrator's
# message to the hub begins with, and what the hub's own messages begin with.
HUB_REPLIES="HH-CLARIFY HH-PLAN BLOCKED DONE BACK"
HUB_ASKS="TASK OWNER HUB PROGRESS RESPAWN RESTART"
USAGE="usage: hh-hub init
       hh-hub self [--name <session name>] [--window <tokens>]
       hh-hub start                                   (no arguments: the hub itself, in a tmux session named after it)
       hh-hub rotate [--still <s>] [--max <s>] [--settle <s>]   (the hub clears itself and picks up its handoff)
       hh-hub context [--window <tokens>]             (the hub's own context level)
       hh-hub discover
       hh-hub add <project> --home <folder> [--repo <folder>]...
       hh-hub add <project> --repo <folder>...        (a project that exists: more folders)
       hh-hub drop <project> <folder>                 (never the home)
       hh-hub remove <project>
       hh-hub name [<name>]
       hh-hub status [<project>] [--json]
       hh-hub task <project> [--text <text>]          (no --text: the text is read from stdin)
       hh-hub log <task id> <event> [--note <text>]    events: $HUB_EVENTS
       hh-hub tasks [<project>] [--open] [--json]
       hh-hub wake <project> [--mode <m>] [--still <s>] [--max-wait <s>]
       hh-hub start <project> <task id> [--overnight] [--model <m>] [--mode <m>] [--still <s>] [--max-wait <s>]
       hh-hub run <project> overnight <task id> [--still <s>] [--max-wait <s>]
       hh-hub run <project> cleanup <task id> [--disk] [--still <s>] [--max-wait <s>]
       hh-hub continue <project> [--still <s>] [--max-wait <s>]
       hh-hub dialog <project> [<agent>[@<team root>]]
       hh-hub window <project> <agent>[@<team root>] <tokens>   (sets the agent's context window in its team.json record; the hub only)
       hh-hub away --until <time> [--mcp-allow <list>] [--remote-allow <ssh hosts>] [--tools <list>] [--peers <session names>] [--no-hook] [--allow (reserved)]
       hh-hub back
       hh-hub decide <task id> --reason <one line>      (stdin: the question, a line === ANSWER ===, the answer)
       hh-hub hold <project> [--off]
       hh-hub recover [--json] [--max-starts <n>]
       hh-hub answer <project> [<agent>[@<team root>]] --choice <1-9|esc> --seen <fingerprint>
       hh-hub naming --session <session id>"

cmd="${1:-}"; [ -n "$cmd" ] || hh_die 64 "$USAGE"; shift
hub_root() {  # the work folder holding $HH_HUB_DIR/, resolved
  local d
  if [ -n "${HH_HUB:-}" ]; then
    [ -d "$HH_HUB/$HH_HUB_DIR" ] || hh_die 2 "HH_HUB holds no $HH_HUB_DIR/: $HH_HUB"
    (cd "$HH_HUB" && pwd -P); return
  fi
  d=$(pwd -P)
  while :; do
    [ -d "$d/$HH_HUB_DIR" ] && [ ! -L "$d/$HH_HUB_DIR" ] && { printf '%s\n' "$d"; return 0; }
    [ "$d" = / ] && break; d=${d%/*}; [ -n "$d" ] || d=/
  done
  hh_die 2 "no hub here: run hh-hub init in your work folder"
}
hub_root_cwd() {  # the work folder holding $HH_HUB_DIR/, found from the cwd alone: HH_HUB is never consulted for away mode
  local d; d=$(pwd -P)
  while :; do
    [ -d "$d/$HH_HUB_DIR" ] && [ ! -L "$d/$HH_HUB_DIR" ] && { printf '%s\n' "$d"; return 0; }
    [ "$d" = / ] && break; d=${d%/*}; [ -n "$d" ] || d=/
  done
  hh_die 2 "no hub here: run hh-hub init in your work folder"
}
# delegate_for_hub <hub root>: 0 when the owner's delegate file is valid and names this hub; AWAY_UNTIL is its epoch
AWAY_UNTIL=""; AWAY_REFUSED=""; AWAY_HOSTS=""; AWAY_TOOLS=""
delegate_for_hub() {
  AWAY_UNTIL=""; AWAY_REFUSED=""; AWAY_HOSTS=""; AWAY_TOOLS=""
  if ! hh_delegate_mine; then
    # a file that is there and refused says why (status shows it), unless it names a hub that is not this one
    if [ "$HH_DR_ABSENT" != 1 ] && { [ -z "$HH_DR_HUB" ] || [ "$(cd "$HH_DR_HUB" 2>/dev/null && pwd -P)" = "$1" ]; }; then AWAY_REFUSED=$HH_DELEGATE_WHY; fi
    return 1
  fi
  [ "$HH_DG_HUB" = "$1" ] || return 1
  AWAY_UNTIL=$HH_DG_UNTIL; AWAY_HOSTS=$HH_DG_HOSTS; AWAY_TOOLS=$HH_DG_TOOLS
}
epoch_local() { date -r "$1" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$1" '+%Y-%m-%d %H:%M'; }   # epoch_local <epoch>
epoch_iso() { date -u -r "$1" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u -d "@$1" '+%Y-%m-%dT%H:%M:%SZ'; }
# away_hub_caller <hub root> (always after delegate_for_hub, whose hh_delegate_mine refuses without a root-owned jq, so hh_json_get below uses it): exits 4 unless the caller's own Claude is the hub hub.json records (pid and start time) and carries the away
# marker; an environment that cannot be read is a refusal too. recover and a bypass launch both ask it.
# (hub.json's claude_started is compared with hh_lstart_is: the C form or the caller's locale's. A record in any other form is refused
# until `hh-hub self` records it again, which the hub skill runs at every start: this only ever fails closed.)
away_hub_caller() {
  local cpid mrc
  cpid=$(hh_claude_ancestor) || hh_die 4 "this runs inside the hub's own session"
  [ "$cpid" = "$(hh_json_get "$1/$HH_HUB_DIR/hub.json" .claude_pid)" ] && hh_lstart_is "$cpid" "$(hh_json_get "$1/$HH_HUB_DIR/hub.json" .claude_started)" \
    || hh_die 4 "this runs only inside the hub session hub.json records (hh-hub self records it): this Claude is another session"
  hh_env_has "$cpid" HH_AWAY_BYPASS=1; mrc=$?
  case "$mrc" in
    0) ;;
    1) hh_die 4 "this session was not started with the away marker (hh-hub away prints its start line): this is for the hub that was" ;;
    *) hh_die 4 "this session's launch environment cannot be read, so the away marker cannot be checked: refused" ;;
  esac
}
# hh-hub self records "the hub" and hh-hub rotate types into it, and the away hook reads only the words of a command (`hh-hub $(echo self)`
# gets through it): so the script asks who is calling. A Claude carrying the away marker is the hub only when it was also launched with
# HH_PROJECT set to this hub's folder (the hub's start line does; an agent's is its project). A caller that is not marked is unchanged.
# An environment that cannot be read is no proof either way: refused while a delegate file names this hub, as away_hub_caller refuses.
only_the_marked_hub() {  # only_the_marked_hub <hub root> <command word>
  local cpid mrc prc
  cpid=$(hh_claude_ancestor) || return 0
  hh_env_has "$cpid" HH_AWAY_BYPASS=1; mrc=$?
  case "$mrc" in
    1) return 0 ;;
    0) hh_env_has "$cpid" "HH_PROJECT=$1"; prc=$?
       [ "$prc" -eq 0 ] || hh_die 4 "hh-hub $2: this Claude carries the away marker but was not launched with HH_PROJECT=$1: only the hub that hh-hub away's start line launched may run it" ;;
    *) away_now "$1" && hh_die 4 "hh-hub $2: this session's launch environment cannot be read, so the away marker cannot be checked: refused while the owner is away"
       return 0 ;;
  esac
}
# A project's name follows the agent-name rule (lower-case letters, digits, '_' and '-'): it becomes a tmux session, a
# task id and part of an orchestrator's session name.
check_name() { hh_is_agent_name "$1" || hh_die 4 "a project name is lower-case letters, digits, '_' and '-': $1"; }
hub_chosen_name() {  # hub_chosen_name <hub root>: the name in $HH_HUB_DIR/name, else hub; a value that is no name is refused, not skipped
  local n="hub"
  [ -e "$1/$HH_HUB_DIR/name" ] && { IFS= read -r n < "$1/$HH_HUB_DIR/name" || true; }
  hh_is_agent_name "$n" || hh_die 4 "$1/$HH_HUB_DIR/name holds no usable name (lower-case letters, digits, '_' and '-'): run hh-hub name <name>"
  printf '%s\n' "$n"
}
LOCK=""
lock() {  # lock <hub root>: the hub's one lock, around every write of projects.json and tasks.jsonl; released on exit
  local i=0 j; j=$(hh_holder_json $$)
  LOCK="$1/$HH_HUB_DIR/lock"
  until hh_lock_try "$LOCK" "$j"; do i=$((i + 1)); [ "$i" -lt 50 ] || hh_die 4 "the hub is locked by another hh-hub"; sleep 0.1; done
  trap 'hh_lock_release "$LOCK" $$' EXIT
}
unlock() { [ -z "$LOCK" ] || hh_lock_release "$LOCK" $$; LOCK=""; trap - EXIT; }
abs() {  # abs <hub root> <folder as stored>: relative to the hub, or absolute
  case "$2" in /*) printf '%s\n' "$2" ;; *) printf '%s/%s\n' "$1" "$2" ;; esac
}
stored() {  # stored <hub root> <folder as given>: resolved; kept relative when it sits under the hub
  local p; p=$(cd "$1" && cd "$2" 2>/dev/null && pwd -P) || return 1
  case "$p/" in "$1/"*) printf '%s\n' "${p#"$1"/}" ;; *) printf '%s\n' "$p" ;; esac
}
kind_of() {  # kind_of <folder>: "repo", "worktree <its repository>", "folder" or "missing"
  local top common
  [ -d "$1" ] || { echo missing; return; }
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || { echo folder; return; }
  [ "$(cd "$top" && pwd -P)" = "$(cd "$1" && pwd -P)" ] || { echo folder; return; }
  common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || { echo folder; return; }
  common=$(cd "$common" && pwd -P)
  if [ "$common" = "$(cd "$1" && pwd -P)/.git" ]; then echo repo; else echo "worktree ${common%/.git}"; fi
}
owner_of() {  # owner_of <hub root> <folder as stored>: the project that lists the folder, or nothing
  jq -r --arg f "$2" '.projects[]? | select([.repos[]?] | index($f)) | .name' "$1/$HH_HUB_DIR/projects.json" 2>/dev/null | head -1
}
project() {  # project <hub root> <name>: the project's entry, or nothing
  jq -c --arg n "$2" '[.projects[]? | select(.name == $n)][0] // empty' "$1/$HH_HUB_DIR/projects.json" 2>/dev/null
}
need_project() {  # need_project <hub root> <name>: sets PROJ (its entry) and HOME_DIR (its home, absolute)
  check_name "$2"
  PROJ=$(project "$1" "$2"); [ -n "$PROJ" ] || hh_die 2 "no project named $2 in this hub"
  HOME_DIR=$(abs "$1" "$(printf '%s' "$PROJ" | jq -r .home)")
}
hub_name() {  # hub_name <hub root>: the hub's session name as recorded by hh-hub self, or fails
  local n; n=$(hh_json_get "$1/$HH_HUB_DIR/hub.json" .name)
  [ -n "$n" ] && hh_is_session_name "$n" && { printf '%s\n' "$n"; return 0; }
  return 1
}
need_hub_name() { hub_name "$1" || hh_die 2 "the hub has not recorded its own session: run hh-hub self"; }
task_state() {  # task_state <hub root> <id>: the last event that is not a note, or nothing when the task was never asked
  jq -r --arg i "$2" 'select(.id == $i and .event != "note") | .event' "$1/$HH_HUB_DIR/tasks.jsonl" 2>/dev/null | tail -1
}
append_event() {  # append_event <hub root> <id> <project> <event> <note>: one ledger line, under the caller's lock
  jq -nc --arg i "$2" --arg p "$3" --arg e "$4" --arg n "$5" --arg at "$(hh_now)" '{id:$i, project:$p, event:$e, at:$at} + (if $n != "" then {note:$n} else {} end)' \
    >> "$1/$HH_HUB_DIR/tasks.jsonl"
}
in_list() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }   # in_list <word> <space-separated list of words>
# find_agent <project> <agent>[@<team root>]: sets F_ENTRY (its team.json record), F_ROOT (the team root it is in) and F_NAME. The agent may sit in
# a worktree's team: a name used in two team roots of the project is ambiguous without its root. Dies when there is none or it is ambiguous.
find_agent() {
  local name="$1" want="$2" wroot="" e r roots="" nroots=0
  F_ENTRY=""; F_ROOT=""
  case "$want" in *@*) wroot=${want#*@}; want=${want%%@*} ;; esac
  hh_is_agent_name "$want" || hh_die 4 "an agent name is lower-case letters, digits, '_' and '-': $want"
  while IFS= read -r r <&3; do
    e=$(jq -c --arg a "$want" '[.agents[]? | select(.name == $a)][0] // empty' "$r/$HH_STATE_DIR/team.json" 2>/dev/null)
    [ -n "$e" ] || continue
    if [ -n "$wroot" ] && [ "$r" != "$wroot" ]; then continue; fi
    [ -n "$F_ENTRY" ] || { F_ENTRY=$e; F_ROOT=$r; }
    roots="$roots $want@$r"; nroots=$((nroots + 1))
  done 3< <(hh_team_roots "$HOME_DIR")
  [ -n "$F_ENTRY" ] || hh_die 2 "no agent named $want${wroot:+ in $wroot} on $name's team"
  [ "$nroots" -le 1 ] || hh_die 4 "$want is on several team roots of $name:$roots: name one of them"
  F_NAME=$want
}

# An orchestrator this hub started (wake, start) is recorded until it registers itself: a second wake or start while
# that pane still runs would put two orchestrators on one team.
pending() {  # pending <hub root> <project>: 0 a pane this hub started is still that pane; 1 none; 2 cannot tell
  local f="$1/$HH_HUB_DIR/panes/$2.json" rc
  [ -f "$f" ] || return 1
  hh_recorded_pane_is "$(hh_json_get "$f" .socket)" "$(hh_json_get "$f" .pane)" "$(hh_json_get "$f" .pane_pid)" "$(hh_json_get "$f" .pane_started)"; rc=$?
  [ "$rc" -eq 1 ] && rm -f "$f"
  return "$rc"
}
# An orchestrator running outside hivehouse (started by hand, or restarted after a restart without registering) is found in
# Claude Code's own record of each running session, <config dir>/sessions/<pid>.json: its name, folder and tmux pane
# (undocumented, as hh_session_record reads it). It is the project's when its name is <project>-orchestrator or the name
# the team recorded, or when it sits in the project's home with "orchestrator" in its name. This hub's own session and a
# pane this hub started are never it.
live_orchestrator() {  # live_orchestrator <hub root> <project> <home> <recorded name>: prints "<pid> <name> <pane>", or fails
  local f e pid name cwd tm raw hubpid skip
  hubpid=$(hh_json_get "$1/$HH_HUB_DIR/hub.json" .claude_pid); skip=$(hh_json_get "$1/$HH_HUB_DIR/panes/$2.json" .pane_pid)
  for f in "$(hh_claude_dir)"/sessions/*.json; do
    [ -f "$f" ] || continue
    e=$(jq -r '[.pid, .name, .cwd, .tmux] | map(. // "" | tostring) | join("\u001f")' "$f" 2>/dev/null) || continue
    IFS=$'\x1f' read -r pid name cwd tm <<< "$e"
    hh_is_number "$pid" && [ "$pid" != "$hubpid" ] && [ "$pid" != "$skip" ] && hh_alive "$pid" && hh_is_claude "$pid" || continue
    if [ "$name" = "$2-orchestrator" ] || { [ -n "$4" ] && [ "$name" = "$4" ]; } \
       || { [ "$cwd" = "$3" ] && { [ "$name" = "$2" ] || case "$name" in *orchestrator*) true ;; *) false ;; esac; }; }; then
      hh_is_session_name "$name" || name="?"
      raw=$tm; case "$raw" in *[[:space:]]*) raw="" ;; esac
      tm="%${tm##*%}"; case "$tm" in %*[!0-9]*|%) tm="" ;; esac
      printf '%s %s %s %s\n' "$pid" "$name" "${tm:--}" "${raw:--}"; return 0
    fi
  done
  return 1
}
# unreg_pane_ok <pane> <the session record's tmux value> <its pid>: 0 when the pane is on hivehouse's own tmux server, is the very
# pane the record of a session running outside hivehouse names (session:@window.%pane), and that session's process runs inside it
# (the pane's own process is the process or one of its ancestors). A pane id alone says nothing about which server it is on, and two
# servers can both have a first pane named alike, so nothing is read from it or sent to it otherwise.
unreg_pane_ok() {
  local pp p i=0
  [ -n "$1" ] && [ -n "$2" ] && [ "$(hh_tmux display-message -p -t "$1" '#{session_name}:#{window_id}.#{pane_id}' 2>/dev/null)" = "$2" ] || return 1
  pp=$(hh_tmux display-message -p -t "$1" '#{pane_pid}' 2>/dev/null); hh_is_number "$pp" && hh_is_number "${3:-}" || return 1
  p=$3
  while [ "$p" -gt 1 ] 2>/dev/null && [ "$i" -lt 64 ]; do
    [ "$p" = "$pp" ] && return 0
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' '); i=$((i + 1))
  done
  return 1
}
# orch_state <hub root> <project> <home>: sets O_AGENT, O_NAME, O_SID, O_STATE (running, stopped, unknown, none, resumable (no record, but a transcript), or
# unregistered: a live session outside hivehouse, with O_PID and O_PANE), and O_QUESTION (true when a dialog waits on the
# screen of a running orchestrator's pane).
orch_state() {
  local entry="" l r
  O_AGENT=""; O_CPID=""; O_CSTART=""; O_NAME=""; O_SID=""; O_STATE=none; O_PID=""; O_PANE=""; O_TMUX=""; O_QUESTION=false; O_ROOT=$3
  # the team roots, read once per call and kept for the caller (status uses them for the agents and their levels)
  O_ROOTS=(); while IFS= read -r r; do O_ROOTS+=("$r"); done < <(hh_team_roots "$3")
  # the --self orchestrator's entry: the first team root (the home, then each worktree with a team) whose entry is running; failing that the
  # first with an entry (a stopped one). A live entry anywhere wins over a stale one in the home; one process registered in two roots counts once
  local cand cname first="" firstroot=""
  for r in "${O_ROOTS[@]}"; do
    cand=$(hh_self_entry "$r"); [ -n "$cand" ] || continue
    cname=$(printf '%s' "$cand" | jq -r '.name // empty')
    if hh_is_agent_name "$cname" && hh_team_agent_is "$r" "$cname"; then entry=$cand; O_ROOT=$r; break; fi
    [ -n "$first" ] || { first=$cand; firstroot=$r; }
  done
  [ -n "$entry" ] || { entry=$first; [ -z "$firstroot" ] || O_ROOT=$firstroot; }
  if [ -n "$entry" ]; then
    O_AGENT=$(printf '%s' "$entry" | jq -r '.name // empty')
    O_CPID=$(printf '%s' "$entry" | jq -r '.claude_pid // empty'); O_CSTART=$(printf '%s' "$entry" | jq -r '.claude_started // empty')
    if hh_is_agent_name "$O_AGENT"; then
      O_NAME=$(hh_orchestrator_name "$O_ROOT" 2>/dev/null)
      O_SID=$(hh_json_get "$O_ROOT/$HH_STATE_DIR/team/$O_AGENT/session.json" .session_id)
      case "$O_SID" in *[!${HH_LOWER}${HH_UPPER}${HH_DIGITS}-]*) O_SID="" ;; esac
      hh_team_agent_is "$O_ROOT" "$O_AGENT"; case $? in 0) O_STATE=running ;; 1) O_STATE=stopped ;; *) O_STATE=unknown ;; esac
      if [ "$O_STATE" = running ] && hh_pane_question "$(printf '%s' "$entry" | jq -r '.socket // empty')" "$(printf '%s' "$entry" | jq -r '.pane // empty')"; then
        O_QUESTION=true
      fi
    else O_AGENT=""; fi
  fi
  case "$O_STATE" in none|stopped)
    if l=$(live_orchestrator "$1" "$2" "$3" "$O_NAME"); then
      O_STATE=unregistered; O_PID=${l%% *}; l=${l#* }; O_NAME=${l%% *}; l=${l#* }; O_PANE=${l%% *}; O_TMUX=${l#* }
      [ "$O_PANE" != - ] || O_PANE=""; [ "$O_TMUX" != - ] || O_TMUX=""
      [ -n "$O_PANE" ] && unreg_pane_ok "$O_PANE" "$O_TMUX" "$O_PID" && hh_pane_question "" "$O_PANE" && O_QUESTION=true
    fi ;;
  esac
  # nothing recorded of its conversation: a transcript of this project's orchestrator under a team root's folder key (hh_resume_candidate)
  if [ -z "$O_SID" ] && { [ "$O_STATE" = none ] || [ "$O_STATE" = stopped ]; } && hh_resume_candidate "$2-orchestrator" "${O_ROOTS[@]}"; then
    O_SID=$HH_RESUME_SID; O_ROOT=$HH_RESUME_ROOT
    [ -n "$O_AGENT" ] || O_AGENT=orchestrator
    [ -n "$O_NAME" ] || O_NAME="$2-orchestrator"
    [ "$O_STATE" != none ] || O_STATE=resumable
  fi
}
# is_orchestrator_entry <team root> <agent>: 0 when that team.json entry is the orchestrator orch_state found, or another record of the same process
# (a root and an entry, not a name: a spawned agent that shares its name in another root is an agent). A --self entry of the same name (it holds a
# Claude pid) in another root is dropped from the agent lists whether it is stale or live: a project has one orchestrator, so a second live --self
# orchestrator is hidden too.
is_orchestrator_entry() {
  local e cpid cstart
  [ -n "$O_AGENT" ] || return 1
  [ "$1" = "$O_ROOT" ] && [ "$2" = "$O_AGENT" ] && return 0
  e=$(jq -r --arg a "$2" '[.agents[]? | select(.name == $a)][0] // empty | [.claude_pid, .claude_started] | map(. // "" | tostring) | join("\u001f")' "$1/$HH_STATE_DIR/team.json" 2>/dev/null)
  IFS=$'\x1f' read -r cpid cstart <<< "$e"
  [ -n "$cpid" ] || return 1
  { [ "$cpid" = "$O_CPID" ] && [ "$cstart" = "$O_CSTART" ]; } || [ "$2" = "$O_AGENT" ]
}
start_opts() {  # start_opts <model allowed 0|1> [--model m] [--mode m] [--still s] [--max-wait s]: MODEL, MODE, STILL, MAXWAIT
  local allow="$1"; shift
  MODEL=""; MODE=""; STILL=5; MAXWAIT=90
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || hh_die 64 "$USAGE"
    case "$1" in
      --model) [ "$allow" = 1 ] || hh_die 64 "$USAGE"; MODEL="$2" ;;   # a resumed session keeps its own model
      --mode) MODE="$2" ;; --still) STILL="$2" ;; --max-wait) MAXWAIT="$2" ;; *) hh_die 64 "$USAGE" ;;
    esac
    shift 2
  done
  hh_is_number "$STILL" && hh_is_number "$MAXWAIT" || hh_die 4 "--still and --max-wait must be numbers"
  [ -z "$MODEL" ] || hh_is_model_name "$MODEL" || hh_die 4 "bad model: $MODEL"
  # bypass is reached only through project_mode (the owner's delegate file, the project's home, the hub's own marked Claude): never by --mode
  [ "$MODE" != bypassPermissions ] || hh_die 4 "bypassPermissions is never given with --mode: while the owner is away the project's settings resolve to it"
  [ -z "$MODE" ] || hh_check_mode "$MODE" hh-hub
}
# sending <record>: 0 while the hh-hub that owns the record's line (a start, a wake or a continue) is still waiting to send
# it: the pane is then coming up, not waiting on the owner, and nothing else may send its line
sending() { local p; p=$(hh_json_get "$1" .sender_pid); [ -n "$p" ] && hh_alive "$p" && hh_lstart_is "$p" "$(hh_json_get "$1" .sender_started)"; }
# project_mode <home>: the owner's --mode, made stricter by the project's own .hivehouse/settings.json (and auto raised to bypass only
# while the owner is away), as
# hh-spawn's agents get it (hh-settings); the hub's folder is no repository, so it is resolved in the project's home
project_mode() {
  [ -z "$MODE" ] || MODE=$(HH_PROJECT="$1" "$HH_BIN/hh-settings" resolve permission_mode "$MODE") || exit $?
  # a resolved bypass is granted to the hub the owner's file names, running in its own marked Claude, for a listed project
  if [ "$MODE" = bypassPermissions ]; then
    delegate_for_hub "$root" || hh_die 4 "the owner's delegate file does not name this hub: no bypass"
    away_hub_caller "$root"
    hh_check_mode "$MODE" hh-hub "$1"
  fi
}
refuse_pending() {  # refuse_pending <hub root> <project>: under the lock, exits 4 while a pane this hub started for it still runs
  local f="$1/$HH_HUB_DIR/panes/$2.json"
  pending "$1" "$2"; case $? in
    0) if [ "$(hh_json_get "$f" .typed)" = true ] || sending "$f"; then
         hh_die 4 "$2's orchestrator is already coming up in pane $(hh_json_get "$f" .pane); it reports back when it is up"
       fi
       hh_die 4 "$2's orchestrator waits in pane $(hh_json_get "$f" .pane) for its first line (a question on its screen?): answer it there, then run hh-hub continue $2" ;;
    2) hh_die 4 "cannot tell whether the pane this hub started for $2 is still there; nothing was started" ;;
  esac
}
# launch <hub root> <project> <kind> <cwd> <line> <task> <claude args>...: under the hub's lock (so a press of Resume and a
# wake from the conversation cannot both pass the check), a new window in the project's own tmux session, recorded with the
# line it is to be sent; then finish. The pane is the owner's, like the one an orchestrator registers with --self, so it is
# never on a project's manifest (cleanup kills what the manifest names).
launch() {
  local root="$1" name="$2" kind="$3" cwd="$4" line="$5" task="$6" agent="$7" c pane socket ident envs mcpf rc settings
  shift 7
  HH_BP_ENVS=(); HH_BP_ARGS=()
  lock "$root"
  refuse_pending "$root" "$name"
  # bypass (MODE, resolved by project_mode): the marker, the hook's variables and only the MCP servers the owner allowed; nothing for any other mode.
  # The MCP file may hold server secrets, so it is written only once the start is not refused, and removed if the window does not open.
  mcpf="$root/$HH_HUB_DIR/panes/$name-mcp.json"
  if [ "$MODE" = bypassPermissions ]; then mkdir -p "$root/$HH_HUB_DIR/panes"; hh_bypass_launch "$cwd" "$mcpf" || { rm -f "$mcpf"; hh_die 4 "cannot prepare the away MCP file for $name"; }
  else rm -f "$mcpf"; fi   # an earlier bypass start's file may hold server secrets and is not this launch's
  # the measuring statusLine a spawned agent gets (one function, hh_agent_settings), so its window is read, never guessed; the agent's folder is
  # made first (an orchestrator registered under another name than this one measures into the other folder: harmless)
  (HH_PROJECT="$cwd"; export HH_PROJECT; hh_ensure_state && mkdir -p "$cwd/$HH_STATE_DIR/team/$agent") || { rc=$?; rm -f "$mcpf"; exit $rc; }
  settings=$(hh_agent_settings "$HH_BIN" "$cwd" "$cwd/$HH_STATE_DIR/team/$agent") || { rc=$?; rm -f "$mcpf"; exit $rc; }
  c="umask $HH_CALLER_UMASK; $(hh_guard_launch)exec $(printf '%q ' claude "$@" --settings "$settings" ${HH_BP_ARGS[@]+"${HH_BP_ARGS[@]}"})"   # the pane's files are the caller's, not the hub's records
  envs=(-e "HIVEHOUSE_HOME=$(hh_home)" -e "HH_PROJECT=$cwd" ${HH_BP_ENVS[@]+"${HH_BP_ENVS[@]}"})
  [ -n "${HH_TMUX_SOCKET:-}" ] && envs+=(-e "HH_TMUX_SOCKET=$HH_TMUX_SOCKET")
  pane=$(umask "$HH_CALLER_UMASK"; hh_open_window "$name" orchestrator "$cwd" "$c" "${envs[@]}") || { rc=$?; rm -f "$mcpf"; exit $rc; }
  socket=$(hh_tmux display-message -p -t "$pane" '#{socket_path}') || exit $?
  ident=$(hh_pane_identity "$socket" "$pane") || hh_die 4 "cannot read the new pane $pane"
  mkdir -p "$root/$HH_HUB_DIR/panes"
  jq -nc --arg p "$pane" --arg s "$socket" --arg i "${ident%%$'\t'*}" --arg t "${ident#*$'\t'}" --arg k "$kind" --arg l "$line" --arg task "$task" --arg at "$(hh_now)" \
    --arg sp "$$" --arg ss "$(hh_lstart $$)" \
    '{pane:$p, socket:$s, pane_pid:$i, pane_started:$t, kind:$k, line:$l, typed:false, sender_pid:$sp, sender_started:$ss, at:$at} + (if $task != "" then {task:$task} else {} end)' \
    > "$root/$HH_HUB_DIR/panes/$name.json"
  # the sessions this hub started or woke, with their times: recover's caps count them within 24 hours
  jq -nc --arg a "$kind" --arg i "$name" --arg e "$(/bin/date +%s)" '{epoch:($e | tonumber), action:$a, item:$i}' >> "$root/$HH_HUB_DIR/recovery.jsonl"
  unlock
  finish "$root" "$name"
}
# finish <hub root> <project> [panes|runs]: once the recorded pane is idle, types its line and marks it sent; each kind logs
# its own event with its task (a start is handed, a run is overnight or cleanup). The pane is reached on the server the
# record names. A question on its screen is never answered: it says where, and continue picks it up once the owner has.
finish() {
  local root="$1" name="$2" dir="${3:-panes}" f pane line rc socket kind task
  f="$root/$HH_HUB_DIR/$dir/$name.json"; pane=$(hh_json_get "$f" .pane); line=$(hh_json_get "$f" .line); socket=$(hh_json_get "$f" .socket)
  case "$line" in ''|*$'\n'*) hh_die 4 "the line recorded for $name is not one hivehouse will type" ;; esac
  wait_idle "$pane" "$STILL" "$MAXWAIT" "$socket"; rc=$?
  case "$rc" in
    0) ;;
    3) echo "$HH_PREFIX: a question is on the screen of pane $pane ($name): answer it there, then run hh-hub continue $name; nothing was typed" >&2; exit 5 ;;
    *) echo "$HH_PREFIX: pane $pane ($name) never went idle within ${MAXWAIT}s; nothing was typed; hh-hub continue $name tries again" >&2; exit 1 ;;
  esac
  type_line "$pane" "$line" "$socket"
  lock "$root"
  jq '.typed = true' "$f" > "$f.tmp$$" && mv "$f.tmp$$" "$f"
  kind=$(hh_json_get "$f" .kind); task=$(hh_json_get "$f" .task)
  case "$kind" in
    start) append_event "$root" "$task" "$name" handed "started $name-orchestrator in pane $pane" ;;
    overnight|cleanup) append_event "$root" "$task" "$name" "$kind" "sent to $name's orchestrator in pane $pane" ;;
  esac
  unlock
  echo "$pane"
}
# session_target <home> <agent>: the recorded identity of a team member's Claude and its screen, "<socket> <pane> <pid> <started>"
# separated by the unit separator: the --self orchestrator's own Claude, else (a spawned agent) the pane's process, which is its Claude
session_target() {
  jq -r --arg a "$2" '[.agents[]? | select(.name == $a)][0] // empty | [.socket, .pane, (.claude_pid // .pane_pid), (.claude_started // .pane_started)]
    | map(. // "" | tostring) | join("\u001f")' "$1/$HH_STATE_DIR/team.json" 2>/dev/null
}
# hung_try <project> <kind orchestrator|agent> <agent> <task> <socket> <pane> <pid> <started> [<state key>]: recover's look at one running session
# (Phase 4.3). Hung needs positive evidence: Claude Code's working line recognised, with its elapsed time unchanged for 15 minutes
# (hung-state.json holds what each beat saw: the same process, the same time, and since when). Any other screen is unknown: never hung,
# nothing kept. A hung session is stopped (hh_stop_hung) within the cap of 3 restarts of one session in 24 hours, and recover has
# already refused unless the delegate file is valid and this hub's marker was read (away_hub_caller); the action that brings it
# back is added. An orchestrator is stopped only while recover's daily cap on sessions started or woken has room (3.3: the wake that
# follows is one of them); a stop that did not take is blocked once and not tried again for 24 hours. Sets HUNG_STOPPED=1 when it
# stopped one. It works on recover's variables: now, since, starts, max, rjf, hstates, newhs, newrec, actions, blocked.
hung_try() {
  local n="$1" kind="$2" a="$3" task="$4" socket="$5" pane="$6" pid="$7" started="$8" hk="${9:-$3}" key secs hsince tries seen mins why rc
  HUNG_STOPPED=0; key="$n/$hk"
  [ -n "$pid" ] && [ -n "$started" ] || return 0
  secs=$(hh_pane_text "$pane" "$socket" | hh_pane_working_seconds) || return 0
  hsince=$(printf '%s' "$hstates" | jq -r --arg k "$key" --arg p "$pid" --arg s "$started" --argjson c "$secs" \
    '.[$k] | select(.pid == $p and .started == $s and .secs == $c) | .since // empty')
  [ -n "$hsince" ] || hsince=$now
  newhs=$(printf '%s' "$newhs" | jq -c --arg k "$key" --arg p "$pid" --arg s "$started" --argjson c "$secs" --argjson t "$hsince" '. + {($k): {pid:$p, started:$s, secs:$c, since:$t}}')
  [ $((now - hsince)) -ge 900 ] || return 0
  mins=$(((now - hsince) / 60))
  why="hung: its working line has not changed for $mins minutes"
  tries=$(jq -s --arg i "$key" --argjson s "$since" '[.[] | select(.epoch > $s and .action == "restart" and .item == $i)] | length' "$rjf")
  seen=$(jq -s --arg i "$key" --argjson s "$since" '[.[] | select(.epoch > $s and .action == "blocked-restart" and .item == $i)] | length' "$rjf")
  if [ "$tries" -ge 3 ]; then
    [ "$seen" -gt 0 ] || {
      blocked=$(printf '%s' "$blocked" | jq -c --arg p "$n" --arg a "$a" --arg t "$task" '. + [{action:"restart", project:$p, agents:[$a], task:$t, reason:"restarted 3 times in 24 hours and hung again"}]')
      newrec="$newrec$(jq -nc --arg i "$key" --argjson e "$now" '{epoch:$e, action:"blocked-restart", item:$i}')"$'\n'; }
    return 0
  fi
  if [ "$kind" = orchestrator ] && [ "$starts" -ge "$max" ]; then
    seen=$(jq -s --arg i "$n" --argjson s "$since" '[.[] | select(.epoch > $s and .action == "blocked-wake" and .item == $i)] | length' "$rjf")
    [ "$seen" -gt 0 ] || {
      blocked=$(printf '%s' "$blocked" | jq -c --arg p "$n" --arg t "$task" --arg w "$why" --argjson m "$max" '. + [{action:"wake", project:$p, task:$t, reason:($w + ", and the daily cap of \($m) sessions started or woken is reached, so it was not stopped")}]')
      newrec="$newrec$(jq -nc --arg i "$n" --argjson e "$now" '{epoch:$e, action:"blocked-wake", item:$i}')"$'\n'; }
    return 0
  fi
  seen=$(jq -s --arg i "$key" --argjson s "$since" '[.[] | select(.epoch > $s and .action == "blocked-stop" and .item == $i)] | length' "$rjf")
  [ "$seen" -eq 0 ] || return 0
  hh_stop_hung "$pid" "$started" "$socket" "$pane" "$secs"; rc=$?
  case "$rc" in
    0) ;;
    3) blocked=$(printf '%s' "$blocked" | jq -c --arg p "$n" --arg a "$a" --arg t "$task" --arg w "$why" '. + [{action:"restart", project:$p, agents:[$a], task:$t, reason:($w + " and did not stop when asked")}]')
       newrec="$newrec$(jq -nc --arg i "$key" --argjson e "$now" '{epoch:$e, action:"blocked-stop", item:$i}')"$'\n'
       return 0 ;;
    *) return 0 ;;   # not that process any more, or its screen moved: not hung after all
  esac
  newhs=$(printf '%s' "$newhs" | jq -c --arg k "$key" 'del(.[$k])')
  newrec="$newrec$(jq -nc --arg i "$key" --argjson e "$now" '{epoch:$e, action:"restart", item:$i}')"$'\n'
  HUNG_STOPPED=1
  if [ "$kind" = orchestrator ]; then
    starts=$((starts + 1))   # its wake is one of the day's sessions
    actions=$(printf '%s' "$actions" | jq -c --arg p "$n" --arg t "$task" --arg w "$why; hivehouse stopped it" '. + [{action:"wake", project:$p, task:$t, why:$w}]')
  else
    actions=$(printf '%s' "$actions" | jq -c --arg p "$n" --arg a "$a" --arg w "$why; hivehouse stopped it: bring it back with hh-spawn --respawn $a --resume" '. + [{action:"restart", project:$p, agents:[$a], why:$w}]')
  fi
}
# dialog_target <hub root> <project> <agent or empty>: the screen a dialog is read from and answered on. Sets T_SOCKET, T_PANE
# and T_SESSION. The orchestrator by default: its registered pane, else the pane this hub started for it and it has not
# registered from (a start's first dialog), else the pane of one running outside hivehouse. An agent must be on the team
# (exit 2) and running (exit 4). Needs HOME_DIR, so call it after need_project.
dialog_target() {
  local root="$1" name="$2" want="$3" entry tr r e wroot roots nroots
  T_SOCKET=""; T_PANE=""; T_SESSION=""
  orch_state "$root" "$name" "$HOME_DIR"
  if [ -z "$want" ] || [ "$want" = "$O_AGENT" ]; then
    entry=$(hh_self_entry "$O_ROOT")
    if [ "$O_STATE" = running ] && [ -n "$entry" ]; then
      T_SOCKET=$(printf '%s' "$entry" | jq -r '.socket // empty'); T_PANE=$(printf '%s' "$entry" | jq -r '.pane // empty'); T_SESSION="$O_NAME"
    elif pending "$root" "$name"; then
      T_SOCKET=$(hh_json_get "$root/$HH_HUB_DIR/panes/$name.json" .socket); T_PANE=$(hh_json_get "$root/$HH_HUB_DIR/panes/$name.json" .pane); T_SESSION="$name-orchestrator"
    elif [ "$O_STATE" = unregistered ]; then
      unreg_pane_ok "$O_PANE" "$O_TMUX" "$O_PID" || hh_die 4 "$O_NAME runs outside hivehouse, and pane ${O_PANE:-?} is not on this machine's hivehouse tmux server as its session record says: answer it in the pane"
      T_PANE="$O_PANE"; T_SESSION="$O_NAME"
    fi
    [ -n "$T_PANE" ] || hh_die 4 "$name has no orchestrator screen to read ($O_STATE)"
  else
    find_agent "$name" "$want"; entry=$F_ENTRY; tr=$F_ROOT; want=$F_NAME
    hh_team_agent_is "$tr" "$want"; [ $? -eq 0 ] || hh_die 4 "$want is not running: there is no screen to read"
    T_SOCKET=$(printf '%s' "$entry" | jq -r '.socket // empty'); T_PANE=$(printf '%s' "$entry" | jq -r '.pane // empty'); T_SESSION="$want"
    [ -n "$T_PANE" ] || hh_die 4 "$want has no pane recorded"
  fi
}
type_line() { hh_tmux_on "${3:-}" send-keys -t "$1" -l "$2"; hh_tmux_on "${3:-}" send-keys -t "$1" Enter; }   # type_line <pane> <fixed line> [socket]
overnight_line() { printf '/%s:overnight Task %s: read %s. It came from the owner through %s.' "$PLUGIN" "$1" "$2" "$3"; }   # overnight_line <task id> <task file> <hub name>

seal_hub() {  # seal_hub <hub root>: takes group and others' write off $HH_HUB_DIR/ and all inside it, which this user owns
  chmod -R go-w "$1/$HH_HUB_DIR" || hh_die 4 "cannot take group and others' write off $1/$HH_HUB_DIR"
}

# ---- the hub in tmux (hh-hub start, and the lines away and back print) ----
hub_session_note() {  # hub_session_note <hub name>: a printed new-session line never attaches (no -A), so a running hub of that name is to exit first
  hh_tmux has-session -t "=$1" 2>/dev/null || return 0
  echo "# A tmux session named $1 is running: exit the hub in it first (/exit). The line below starts a new session and never attaches to that one, which would not carry the change."
}
tmux_word() { if [ -n "${HH_TMUX_SOCKET:-}" ]; then printf 'tmux -S %q' "$HH_TMUX_SOCKET"; else printf 'tmux'; fi; }   # the tmux the printed lines name
# The hub's own Claude and pane, as hub.json records them: hub_pane_is is 0 only while that Claude is alive and in that very pane
# (process and start time); hub_running is 0 while the Claude is alive and prints the pane's tmux session when it is also in its pane.
hub_pane_is() {  # hub_pane_is <hub root>
  local f="$1/$HH_HUB_DIR/hub.json" pane
  hh_claude_is "$(hh_json_get "$f" .claude_pid)" "$(hh_json_get "$f" .claude_started)" || return 1
  pane=$(hh_json_get "$f" .pane); [ -n "$pane" ] || return 1
  hh_recorded_pane_is "$(hh_json_get "$f" .socket)" "$pane" "$(hh_json_get "$f" .pane_pid)" "$(hh_json_get "$f" .pane_started)"
}
hub_running() {  # hub_running <hub root>
  local f="$1/$HH_HUB_DIR/hub.json"
  hh_claude_is "$(hh_json_get "$f" .claude_pid)" "$(hh_json_get "$f" .claude_started)" || return 1
  if hub_pane_is "$1"; then hh_tmux_on "$(hh_json_get "$f" .socket)" display-message -p -t "$(hh_json_get "$f" .pane)" '#{session_name}' 2>/dev/null; fi
  return 0
}
# What a rotated hub is typed: the pickup line from hh-resolve's file (the hub folder's custom/ first, as HH_PROJECT follows it), its
# {plugin}, {name} and {handoff} filled in. A custom line that is not one line of plain text is ignored with a note.
# While the owner is away custom/ is not read for anything the hub is typed or told: an away agent may write there, and what is typed into
# the hub after a /clear is read by the hub as the owner's. A delegate file that exists but is refused counts as away: fail closed.
away_now() { hh_away_for_hub "$1"; }   # the one predicate, in hh-lib.sh: a valid delegate file names this hub, or a refused one names it or no hub
hub_pickup_line() {  # hub_pickup_line <hub root> <hub name>
  local f text own
  own="$(cd "$HH_BIN/.." && pwd -P)/rules/hub-pickup.md"
  if away_now "$1"; then
    f=$own; echo "$HH_PREFIX: the owner is away: custom/ is not read for the hub's pickup line; the plugin's own is used" >&2
  else f=$(hh_custom_file rules/hub-pickup.md 2>/dev/null) || f=$own; fi
  text=$(cat "$f" 2>/dev/null)
  case "$text" in ''|*[[:cntrl:]]*) echo "$HH_PREFIX: ignoring $f: the pickup line is one line of plain text" >&2; text=$(cat "$own") ;; esac
  [ "${#text}" -le 1000 ] || { echo "$HH_PREFIX: ignoring $f: the pickup line is at most 1000 characters" >&2; text=$(cat "$own"); }
  local h="$1/$HH_HUB_DIR/memory/hub-handoff.md" n="$2" pl="$PLUGIN" lead
  text=${text//\{plugin\}/$pl}; text=${text//\{name\}/$n}; text=${text//\{handoff\}/$h}
  # An allowlist: what is typed into the hub's own prompt box starts with a letter or digit (a message), or with exactly /<plugin>: (this
  # plugin's skill). A "!" starts bash mode, and "/login", "/plugin" and the rest are commands; a custom/ file an away agent rewrote must
  # not reach them.
  lead=${text#"${text%%[![:space:]]*}"}
  case "$lead" in
    [A-Za-z0-9]*) ;;
    *) [ "${text#"/$pl:"}" != "$text" ] || { echo "$HH_PREFIX: ignoring $f: the pickup line starts with a letter or digit, or with /$pl:" >&2; text=$(cat "$own"); text=${text//\{plugin\}/$pl}; text=${text//\{name\}/$n}; text=${text//\{handoff\}/$h}; } ;;
  esac
  printf '%s' "$text"
}
hub_attach() {  # hub_attach <session>: attach from a terminal; inside tmux or with no terminal, say how
  local tm; tm=$(tmux_word)
  if [ -n "${TMUX:-}" ]; then echo "$HH_PREFIX: switch to it with: $tm switch-client -t $1"
  elif [ -t 0 ] && [ -t 1 ]; then exec tmux ${HH_TMUX_SOCKET:+-S "$HH_TMUX_SOCKET"} attach-session -t "=$1"
  else echo "$HH_PREFIX: attach with: $tm attach -t $1"; fi
}
hub_start() {
  local root hubn sess tm
  [ $# -eq 0 ] || hh_die 64 "$USAGE"
  root=$(hub_root) || exit $?
  hubn=$(hub_chosen_name "$root") || exit $?
  hh_is_typed_path "$root" || hh_die 4 "the hub's folder is not a path hivehouse will print into a command: $root"
  command -v tmux >/dev/null 2>&1 || hh_die 2 "tmux is not installed: the hub runs in a tmux session"
  command -v claude >/dev/null 2>&1 || hh_die 2 "claude is not on the PATH"
  tm=$(tmux_word)
  if sess=$(hub_running "$root"); then
    if [ "$sess" != "$hubn" ]; then
      if [ -n "$sess" ]; then hh_die 4 "the hub is already running in tmux session $sess: exit it first (/exit), or attach to it"
      else hh_die 4 "the hub is already running outside tmux: exit it first (/exit)"; fi
    fi
    echo "$HH_PREFIX: the hub is running in tmux session $hubn"; hub_attach "$hubn"; return
  fi
  hh_tmux has-session -t "=$hubn" 2>/dev/null && hh_die 4 "a tmux session named $hubn exists and is not the hub (hub.json records no running hub in it): exit it, or give the hub another name with hh-hub name"
  if [ -n "${TMUX:-}" ]; then   # tmux does not nest: the owner starts it from here
    echo "$HH_PREFIX: you are inside tmux. Start the hub beside this session, then switch to it:"
    printf '%s new-session -d -s %q -c %q -e HH_PROJECT=%q env -u HH_AWAY_BYPASS -u HH_AWAY_HUB -u HH_AWAY_MCP_ALLOW claude --name %q /%s:hub\n' "$tm" "$hubn" "$root" "$root" "$hubn" "$PLUGIN"
    echo "$tm switch-client -t $hubn"
    return 0
  fi
  hh_tmux new-session -d -s "$hubn" -c "$root" -e "HH_PROJECT=$root" env -u HH_AWAY_BYPASS -u HH_AWAY_HUB -u HH_AWAY_MCP_ALLOW claude --name "$hubn" "/$PLUGIN:hub" \
    || hh_die 1 "tmux could not start the session $hubn"
  echo "$HH_PREFIX: the hub started in tmux session $hubn"; hub_attach "$hubn"
}

case "$cmd" in
init)
  [ $# -eq 0 ] || hh_die 64 "$USAGE"
  git rev-parse --git-dir >/dev/null 2>&1 && hh_die 4 "the hub sits above your projects, never inside a repository: run it in your work folder"
  d=$(pwd -P)
  mkdir -p "$d/$HH_HUB_DIR/memory" "$d/$HH_HUB_DIR/tasks" || exit $?
  [ -f "$d/$HH_HUB_DIR/projects.json" ] || echo '{"projects":[]}' > "$d/$HH_HUB_DIR/projects.json"
  touch "$d/$HH_HUB_DIR/tasks.jsonl"
  seal_hub "$d"
  echo "$d/$HH_HUB_DIR" ;;

self)
  name=""; win=""
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || hh_die 64 "$USAGE"
    case "$1" in --name) name="$2" ;; --window) win="$2" ;; *) hh_die 64 "$USAGE" ;; esac
    shift 2
  done
  if [ -n "$win" ]; then case "$win" in ''|*[!0-9]*|0) hh_die 4 "--window must be a positive number: $win" ;; esac; fi
  root=$(hub_root) || exit $?
  pid=$(hh_claude_ancestor) || hh_die 2 "hh-hub self must run inside the Claude session that is the hub"
  only_the_marked_hub "$root" self
  # a second Claude in the hub's folder never takes the hub over from a live one: the recorded hub is replaced only when its process is gone
  # (or is no longer that process: another start time, or not Claude), and the same process may record itself again
  rpid=$(hh_json_get "$root/$HH_HUB_DIR/hub.json" .claude_pid)
  if [ -n "$rpid" ] && [ "$rpid" != "$pid" ] && hh_claude_is "$rpid" "$(hh_json_get "$root/$HH_HUB_DIR/hub.json" .claude_started)"; then
    hh_die 4 "a hub already runs here: $(hh_json_get "$root/$HH_HUB_DIR/hub.json" .name) (process $rpid). Only that session is the hub, and this one is not: do not take its place. Tell the owner."
  fi
  [ -n "$name" ] || name=$(hh_session_record "$pid" .name)
  hubn=$(hub_chosen_name "$root" 2>/dev/null) || hubn=hub
  [ -n "$name" ] || hh_die 4 "this session has no name: start the hub with claude --name $hubn /$PLUGIN:hub (or type /rename $hubn), or pass --name"
  hh_is_session_name "$name" || hh_die 4 "a session name hivehouse will type is one line of letters, digits, space, - _ . ( ), at most 64: $name"
  # orchestrators are told to type it (hh-spawn --self --hub <name>), so it is one word
  case "$name" in *[' ()']*) hh_die 4 "the hub's name is one word (letters, digits, - _ .): $name; rename the session" ;; esac
  # the hub's own pane, as hh-spawn --self records an orchestrator's: hh-hub rotate types into only this pane and process
  psock=""; ppane=""; ppid=""; pstarted=""
  # the pane is read only on the server this process is in ($TMUX names it): $TMUX_PANE on another server is another pane
  if [ -n "${TMUX_PANE:-}" ] && [ -n "${TMUX:-}" ] && psock=$(hh_tmux display-message -p -t "$TMUX_PANE" '#{socket_path}' 2>/dev/null) && [ "$psock" = "${TMUX%%,*}" ] && ident=$(hh_pane_identity "$psock" "$TMUX_PANE"); then
    ppane=$TMUX_PANE; ppid=${ident%%$'\t'*}; pstarted=${ident#*$'\t'}
  else
    if [ -n "${TMUX_PANE:-}" ] && [ -n "${TMUX:-}" ]; then why="is in a tmux server hivehouse does not use"; else why="is not in a tmux pane"; fi
    echo "$HH_PREFIX: this hub $why, so it cannot rotate itself: start it with $(cd "$HH_BIN" && pwd -P)/hh-hub start" >&2
  fi
  # the window the hub was told it has (the hub skill passes the orchestrator window option); registering again keeps it
  [ -n "$win" ] || win=$(hh_json_get "$root/$HH_HUB_DIR/hub.json" .window)
  jq -nc --arg n "$name" --arg p "$pid" --arg s "$(hh_lstart "$pid")" --arg sid "$(hh_session_record "$pid" .sessionId)" --arg at "$(hh_now)" \
    --arg ts "$psock" --arg tp "$ppane" --arg tpp "$ppid" --arg tps "$pstarted" --arg w "$win" \
    '{name:$n, claude_pid:$p, claude_started:$s, at:$at} + (if $sid != "" then {session_id:$sid} else {} end) + (if $w != "" then {window:($w | tonumber)} else {} end)
     + (if $tp != "" then {socket:$ts, pane:$tp, pane_pid:$tpp, pane_started:$tps} else {} end)' \
    > "$root/$HH_HUB_DIR/hub.json.tmp$$" && mv "$root/$HH_HUB_DIR/hub.json.tmp$$" "$root/$HH_HUB_DIR/hub.json"
  # the hub's handoff, from the template (a custom/ file first), when there is none: hh-hub rotate needs one to send the hub back to
  hfile="$root/$HH_HUB_DIR/memory/hub-handoff.md"
  if [ ! -e "$hfile" ]; then
    if away_now "$root"; then tpl="$(cd "$HH_BIN/.." && pwd -P)/rules/hub-handoff.md"   # custom/ is not read while the owner is away
    else tpl=$(HH_PROJECT="$root" hh_custom_file rules/hub-handoff.md 2>/dev/null) || tpl="$(cd "$HH_BIN/.." && pwd -P)/rules/hub-handoff.md"; fi
    mkdir -p "$root/$HH_HUB_DIR/memory" && cp "$tpl" "$hfile" 2>/dev/null \
      || echo "$HH_PREFIX: could not write $hfile from the template" >&2
  fi
  seal_hub "$root"
  echo "$name" ;;

rotate)
  still=15; max=900; settle=8; detached=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --detached) detached=1; shift ;;
      --still|--max|--settle) [ $# -ge 2 ] || hh_die 64 "$USAGE"; hh_is_number "$2" || hh_die 64 "--still, --max and --settle are numbers"
        case "$1" in --still) still=$2 ;; --max) max=$2 ;; *) settle=$2 ;; esac; shift 2 ;;
      *) hh_die 64 "$USAGE" ;;
    esac
  done
  root=$(hub_root) || exit $?
  [ "$detached" = 1 ] || only_the_marked_hub "$root" rotate   # the detached copy has no Claude above it any more: the first call asked
  hf="$root/$HH_HUB_DIR/hub.json"; sock=$(hh_json_get "$hf" .socket); pane=$(hh_json_get "$hf" .pane)
  [ -n "$pane" ] || hh_die 2 "the hub has not recorded its pane: start it with hh-hub start (hh-hub self records it inside tmux)"
  hh_pane_pid "$sock" "$pane" >/dev/null || hh_die 2 "the hub's pane ($pane) is gone"   # display-message exits 0 for a pane that is not there
  hh_is_typed_path "$root" || hh_die 4 "the hub's folder is not a path hivehouse will type: $root"
  hfile="$root/$HH_HUB_DIR/memory/hub-handoff.md"
  grep -q 'START HERE' "$hfile" 2>/dev/null || hh_die 4 "the hub's handoff $hfile is missing or has no START HERE block: the hub would wake with nothing to read; write it first (hh-resolve hub-handoff prints the template)"
  if [ "$detached" = 0 ]; then   # the hub's last act: return at once, the rotation runs on with all three streams redirected
    HH_PROJECT="$root" nohup "$0" rotate --detached --still "$still" --max "$max" --settle "$settle" </dev/null >>"$root/$HH_HUB_DIR/rotate.out" 2>&1 &
    exit 0
  fi
  export HH_PROJECT="$root"
  hubn=$(hub_name "$root") || hubn=$(hub_chosen_name "$root") || exit $?
  note() { printf '%s %s\n' "$(hh_now)" "$*" >> "$root/$HH_HUB_DIR/rotate.log"; }
  verify() {
    hub_pane_is "$root" && return 0
    note "identity $hubn (nothing sent)"
    echo "$HH_PREFIX: the pane $pane is not the one recorded for the hub (or its Claude is gone); nothing was typed" >&2; return 1
  }
  pickup() { hub_pickup_line "$root" "$hubn"; }
  verify || exit 6
  hh_rotate_pane "$pane" "$sock" "$still" "$max" "$settle" verify pickup; rc=$?
  case "$rc" in
    0) note "rotated $hubn" ;;
    5) note "dialog $hubn (nothing sent)"; echo "$HH_PREFIX: a dialog is waiting in the hub's pane; nothing was typed" >&2; exit 5 ;;
    6) exit 6 ;;
    7) note "cleared-but-not-idle $hubn (pickup line not sent)"; echo "$HH_PREFIX: the hub was cleared but its pane did not go idle; the pickup line was not sent" >&2; exit 1 ;;
    *) note "not-idle $hubn (nothing sent)"; echo "$HH_PREFIX: the hub's pane never went idle within ${max}s; nothing was sent" >&2; exit 1 ;;
  esac ;;

context)
  # The hub's own level from its transcript, for the rotation check: a percent of --window, else of an assumed $HH_WINDOW_DEFAULT (said so).
  win=""
  while [ $# -gt 0 ]; do [ $# -ge 2 ] && [ "$1" = --window ] || hh_die 64 "$USAGE"; win=$2; shift 2; done
  if [ -n "$win" ]; then case "$win" in ''|*[!0-9]*|0) hh_die 4 "--window must be a positive number: $win" ;; esac; fi
  root=$(hub_root) || exit $?
  hf="$root/$HH_HUB_DIR/hub.json"
  sid=$(hh_session_record "$(hh_json_get "$hf" .claude_pid)" .sessionId); [ -n "$sid" ] || sid=$(hh_json_get "$hf" .session_id)
  tp=$(hh_session_transcript "$sid") || hh_die 2 "no transcript is recorded for the hub's session: run hh-hub self"
  used=$(hh_transcript_used "$tp")
  [ -n "$used" ] || hh_die 2 "the hub's transcript has no usage line yet"
  if [ -n "$win" ]; then echo $(( used * 100 / win ))
  else
    rw=$(hh_json_get "$hf" .window); { hh_is_number "$rw" && [ "$rw" -gt 0 ]; } || rw=$HH_WINDOW_DEFAULT   # what hh-hub self recorded, else a guess
    hh_assumed_level "$used" "$rw"
  fi
  # a rotation that sent nothing (never idle, a dialog, another pane) is told here, until one works: the hub cannot see rotate.log otherwise
  last=$(tail -1 "$root/$HH_HUB_DIR/rotate.log" 2>/dev/null)
  case "$last" in ''|*" rotated "*) ;; *) echo "last rotate: $last" ;; esac ;;

discover)
  [ $# -eq 0 ] || hh_die 64 "$USAGE"
  root=$(hub_root) || exit $?
  for d in "$root"/*/; do
    d=${d%/}; b=$(basename "$d")
    [ -L "$d" ] && { printf '%-28s %s\n' "$b" "link (not followed)"; continue; }
    k=$(kind_of "$d")
    case "$k" in worktree\ *) w=$(stored "$root" "${k#worktree }") || w="${k#worktree }"; k="worktree of $w" ;; esac
    extra=""; [ -f "$d/$HH_STATE_DIR/team.json" ] && extra="  team"
    owner=$(owner_of "$root" "$b")
    [ -z "$owner" ] || extra="$extra  in $owner"
    printf '%-28s %s%s\n' "$b" "$k" "$extra"
  done ;;

add)
  name="${1:-}"; [ -n "$name" ] || hh_die 64 "$USAGE"; shift
  home=""; repos=()
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || hh_die 64 "$USAGE"
    case "$1" in --home) home="$2" ;; --repo) repos+=("$2") ;; *) hh_die 64 "$USAGE" ;; esac
    shift 2
  done
  [ -n "$home" ] || [ ${#repos[@]} -gt 0 ] || hh_die 64 "$USAGE"
  check_name "$name"
  root=$(hub_root) || exit $?
  if [ -z "$home" ]; then
    # more folders for a project that exists: the same checks, all under the lock, and all or none
    lock "$root"
    [ -n "$(project "$root" "$name")" ] || hh_die 2 "no project named $name in this hub (a new project needs --home)"
    list=()
    for r in "${repos[@]}"; do
      s=$(stored "$root" "$r") || hh_die 4 "no such folder: $r"
      o=$(owner_of "$root" "$s")
      [ -z "$o" ] || [ "$o" = "$name" ] || hh_die 4 "$s already belongs to $o"
      [ "$o" = "$name" ] && continue
      dup=0; for x in ${list[@]+"${list[@]}"}; do [ "$x" = "$s" ] && dup=1; done
      [ "$dup" = 1 ] || list+=("$s")
    done
    f="$root/$HH_HUB_DIR/projects.json"
    jq --arg n "$name" --args '.projects |= map(if .name == $n then .repos += $ARGS.positional else . end)' ${list[@]+"${list[@]}"} < "$f" > "$f.tmp$$" \
      && mv "$f.tmp$$" "$f" || { rm -f "$f.tmp$$"; exit 1; }
    seal_hub "$root"
    echo "$name"; exit 0
  fi
  h=$(stored "$root" "$home") || hh_die 4 "no such folder: $home"
  case "$(kind_of "$(abs "$root" "$h")")" in
    repo) ;;
    worktree\ *) hh_die 4 "$home is a worktree; a project's home is its repository's main folder" ;;
    *) hh_die 4 "$home is not a git repository; a project's home is the repository its team works from" ;;
  esac
  list=("$h")
  for r in ${repos[@]+"${repos[@]}"}; do
    s=$(stored "$root" "$r") || hh_die 4 "no such folder: $r"
    dup=0; for x in "${list[@]}"; do [ "$x" = "$s" ] && dup=1; done
    [ "$dup" = 1 ] || list+=("$s")
  done
  lock "$root"
  [ -z "$(project "$root" "$name")" ] || hh_die 4 "a project named $name is already in this hub"
  for s in "${list[@]}"; do
    o=$(owner_of "$root" "$s")
    [ -z "$o" ] || hh_die 4 "$s already belongs to $o"
  done
  f="$root/$HH_HUB_DIR/projects.json"
  jq --arg n "$name" --arg h "$h" --args '.projects += [{name:$n, home:$h, repos:$ARGS.positional}]' "${list[@]}" < "$f" > "$f.tmp$$" \
    && mv "$f.tmp$$" "$f" || { rm -f "$f.tmp$$"; exit 1; }
  seal_hub "$root"
  echo "$name" ;;

drop)
  # one folder out of a project; its tasks, task files and memory stay, as with remove. A folder that is gone from the disk
  # can still be dropped, by the name it was stored under.
  [ $# -eq 2 ] || hh_die 64 "$USAGE"
  check_name "$1"; root=$(hub_root) || exit $?
  lock "$root"
  [ -n "$(project "$root" "$1")" ] || hh_die 2 "no project named $1 in this hub"
  s=$(stored "$root" "$2") || { s=${2%/}; case "$s" in "$root"/*) s=${s#"$root"/} ;; esac; }
  [ "$(project "$root" "$1" | jq -r .home)" != "$s" ] || hh_die 4 "$s is $1's home and is never dropped (hh-hub remove drops the whole project)"
  [ "$(owner_of "$root" "$s")" = "$1" ] || hh_die 4 "$1 has no folder $s"
  f="$root/$HH_HUB_DIR/projects.json"
  jq --arg n "$1" --arg f "$s" '.projects |= map(if .name == $n then .repos |= map(select(. != $f)) else . end)' "$f" > "$f.tmp$$" \
    && mv "$f.tmp$$" "$f" || { rm -f "$f.tmp$$"; exit 1; }
  seal_hub "$root"
  echo "$1" ;;

name)
  # the hub's own session name (one word), kept in the hub's folder: a second machine's hub need not also be `hub`
  [ $# -le 1 ] || hh_die 64 "$USAGE"
  root=$(hub_root) || exit $?
  if [ $# -eq 0 ]; then hub_chosen_name "$root"; exit $?; fi
  hh_is_agent_name "$1" || hh_die 4 "the hub's name is lower-case letters, digits, '_' and '-': $1"
  printf '%s\n' "$1" > "$root/$HH_HUB_DIR/name.tmp$$" && mv "$root/$HH_HUB_DIR/name.tmp$$" "$root/$HH_HUB_DIR/name"
  seal_hub "$root"
  echo "$1" ;;

remove)
  [ $# -eq 1 ] || hh_die 64 "$USAGE"
  check_name "$1"; root=$(hub_root) || exit $?
  lock "$root"
  [ -n "$(project "$root" "$1")" ] || hh_die 2 "no project named $1 in this hub"
  f="$root/$HH_HUB_DIR/projects.json"
  jq --arg n "$1" '.projects |= map(select(.name != $n))' "$f" > "$f.tmp$$" && mv "$f.tmp$$" "$f"
  seal_hub "$root"
  echo "$1" ;;

status)
  want=""; json=0
  while [ $# -gt 0 ]; do case "$1" in --json) json=1 ;; -*) hh_die 64 "$USAGE" ;; *) want="$1" ;; esac; shift; done
  root=$(hub_root) || exit $?
  [ -z "$want" ] || { check_name "$want"; [ -n "$(project "$root" "$want")" ] || hh_die 2 "no project named $want in this hub"; }
  hub=$(jq -c '{name, claude_pid, claude_started}' "$root/$HH_HUB_DIR/hub.json" 2>/dev/null) || hub='{}'
  [ -n "$hub" ] || hub='{}'
  away='null'
  if delegate_for_hub "$root"; then
    away=$(jq -nc --argjson u "$AWAY_UNTIL" --arg h "$AWAY_HOSTS" --arg tl "$AWAY_TOOLS" --arg since "$(hh_json_get "$root/$HH_HUB_DIR/away.json" .since)" '{until:$u, hosts:$h, tools:$tl} + (if $since != "" then {since:$since} else {} end)')
  fi
  hub=$(printf '%s' "$hub" | jq -c --argjson a "$away" 'if $a == null then . else . + {away:$a} end')
  [ -z "$AWAY_REFUSED" ] || hub=$(printf '%s' "$hub" | jq -c --arg r "$AWAY_REFUSED" '. + {away_refused:$r}')
  # the last away period, which stays after it ends: the screen and the hub keep what was decided in it until it is seen
  last=$(jq -c 'select(.since and .until) | {since, until}' "$root/$HH_HUB_DIR/away.json" 2>/dev/null | head -1)
  [ -z "$last" ] || hub=$(printf '%s' "$hub" | jq -c --argjson l "$last" '. + {last_away:$l}')
  # open tasks per project: those whose last event (a note aside) neither closes them
  opens=$(jq -s --argjson c "$HUB_CLOSED_JSON" '[group_by(.id)[] | {p: .[0].project, s: ([.[] | select(.event != "note")] | last | .event)}
    | select((.s as $s | $c | index($s)) | not)] | group_by(.p) | map({key: .[0].p, value: length}) | from_entries' "$root/$HH_HUB_DIR/tasks.jsonl")
  level() {  # level <agent>: {context, context_assumed} (or {context_unknown, context_tokens}) from this project's $levels when one was read, else {}
    local l c x=false
    l=$(printf '%s\n' "$levels" | awk -v a="$1" '$1 == a { print; exit }'); c=$(printf '%s' "$l" | awk '{print $2}')
    case "$c" in ''|*[!0-9]*) echo '{}'; return ;; esac
    # tokens over a window that is only assumed: no percent, so nothing in the status reads over 100
    case "$l" in *"(window unknown)"*) jq -nc --argjson c "$c" '{context_unknown:true, context_tokens:$c}'; return ;; esac
    case "$l" in *"(window assumed"*) x=true ;; esac   # never inside $(...): bash 3.2 misreads a case there
    jq -nc --argjson c "$c" --argjson x "$x" '{context:$c, context_assumed:$x}'
  }
  out='[]'
  for n in $(jq -r '.projects[]?.name' "$root/$HH_HUB_DIR/projects.json"); do
    [ -z "$want" ] || [ "$n" = "$want" ] || continue
    hh_is_agent_name "$n" || continue
    p=$(project "$root" "$n"); home=$(abs "$root" "$(printf '%s' "$p" | jq -r .home)")
    repos='[]'
    while IFS= read -r r; do
      a=$(abs "$root" "$r"); k=$(kind_of "$a"); br=""; ch=""
      case "$k" in
        repo|worktree\ *) br=$(git -C "$a" symbolic-ref --short -q HEAD 2>/dev/null || git -C "$a" rev-parse --short HEAD 2>/dev/null)
                          # never takes the index lock: an agent's git add or commit in that folder must not meet it
                          ch=$(git --no-optional-locks -C "$a" status --porcelain 2>/dev/null | grep -c .) ;;
      esac
      repos=$(printf '%s' "$repos" | jq -c --arg r "$r" --arg k "${k%% *}" --arg b "$br" --arg c "$ch" '. + [{folder:$r, kind:$k} + (if $b != "" then {branch:$b, changed:($c | tonumber)} else {} end)]')
    done < <(printf '%s' "$p" | jq -r '.repos[]')
    orch_state "$root" "$n" "$home"
    # each session's context level as hh-context reads it, per team root: "<agent> <level>[ (window assumed N)][ (not running)]"
    # each team root's levels, read once: lv[i] is the root O_ROOTS[i]'s
    lv=(); ri=0; oi=0
    for tr in "${O_ROOTS[@]}"; do
      lv[$ri]=$(HH_PROJECT="$tr" "$HH_BIN/hh-context" --all 2>/dev/null) || lv[$ri]=""
      [ "$tr" != "$O_ROOT" ] || oi=$ri
      ri=$((ri + 1))
    done
    olv='{}'
    if [ -n "$O_AGENT" ] && [ "$O_STATE" != unregistered ] && [ "$O_STATE" != resumable ]; then
      levels=${lv[$oi]-}
      olv=$(level "$O_AGENT")
    fi
    starting='null'
    if [ "$O_STATE" != running ] && pending "$root" "$n"; then
      q=false; hh_pane_question "$(hh_json_get "$root/$HH_HUB_DIR/panes/$n.json" .socket)" "$(hh_json_get "$root/$HH_HUB_DIR/panes/$n.json" .pane)" && q=true
      sg=false; sending "$root/$HH_HUB_DIR/panes/$n.json" && sg=true
      starting=$(jq -c --argjson q "$q" --argjson sg "$sg" '{pane, kind, at, typed: (.typed // false), sending: $sg, question: $q} + (if .task then {task} else {} end)' "$root/$HH_HUB_DIR/panes/$n.json")
    fi
    agents='[]'
    ri=0
    for tr in "${O_ROOTS[@]}"; do   # the agents of every team root, each with its worktree
      levels=${lv[$ri]-}; ri=$((ri + 1))
      for a in $(jq -r '.agents[]?.name' "$tr/$HH_STATE_DIR/team.json" 2>/dev/null); do
        hh_is_agent_name "$a" && ! is_orchestrator_entry "$tr" "$a" || continue
        hh_team_agent_is "$tr" "$a"; case $? in 0) st=running ;; 1) st=stopped ;; 2) st=unknown ;; *) st=unrecorded ;; esac
        q=false
        [ "$st" != running ] || ! hh_pane_question "$(jq -r --arg a "$a" '[.agents[] | select(.name == $a)][0].socket // empty' "$tr/$HH_STATE_DIR/team.json")" \
          "$(jq -r --arg a "$a" '[.agents[] | select(.name == $a)][0].pane // empty' "$tr/$HH_STATE_DIR/team.json")" || q=true
        agents=$(printf '%s' "$agents" | jq -c --arg a "$a" --arg s "$st" --arg w "$tr" --argjson q "$q" --argjson l "$(level "$a")" '. + [{name:$a, state:$s, worktree:$w, question:$q} + $l]')
      done
    done
    # a name used in two team roots is told apart by its root: ref is "<name>@<team root>" then, the bare name otherwise
    agents=$(printf '%s' "$agents" | jq -c '. as $all | map(. as $a | . + {ref: (if ([$all[] | select(.name == $a.name)] | length) > 1 then "\($a.name)@\($a.worktree)" else $a.name end)})')
    open=$(printf '%s' "$opens" | jq -r --arg p "$n" '.[$p] // 0')
    held=false; [ ! -f "$root/$HH_HUB_DIR/holds/$n" ] || held=true
    out=$(printf '%s' "$out" | jq -c --arg n "$n" --arg h "$home" --argjson r "$repos" --argjson ag "$agents" --argjson st "$starting" \
      --argjson held "$held" --arg os "$O_STATE" --arg on "$O_NAME" --arg sid "$O_SID" --argjson ot "$open" --argjson oq "$O_QUESTION" --arg opid "$O_PID" --arg opane "$O_PANE" \
      --argjson ol "$olv" \
      '. + [{name:$n, home:$h, repos:$r, orchestrator:({state:$os, question:$oq} + (if $on != "" then {name:$on} else {} end) + (if $sid != "" then {session_id:$sid} else {} end)
            + (if $opid != "" then {pid:($opid | tonumber)} else {} end) + (if $opane != "" then {pane:$opane} else {} end)
            + $ol + (if $st != null then {starting:$st} else {} end)), agents:$ag, open_tasks:$ot, held:$held}]')
  done
  if [ "$json" = 1 ]; then
    jq -n --arg root "$root" --argjson h "$hub" --argjson p "$out" '{hub:({root:$root} + $h), projects:$p}'
  else
    awaytxt=""; [ "$away" = null ] || awaytxt="  ·  away until $(epoch_local "$AWAY_UNTIL")"
    [ -z "$AWAY_REFUSED" ] || awaytxt="  ·  away refused: $AWAY_REFUSED"
    printf '%s' "$out" | jq -r --arg root "$root" --arg awaytxt "$awaytxt" --arg hub "$(printf '%s' "$hub" | jq -r '.name // "hub (not recorded: hh-hub self)"')" '
      def n($k; $w): "\($k) \($w)\(if $k == 1 then "" else "s" end)";
      (map(.repos[].folder | length) | max // 0) as $fw |
      "\($hub)  ·  \($root)  ·  \(n(length; "project"))  ·  \(n(map(.open_tasks) | add // 0; "open task"))\($awaytxt)",
      (.[] |
        "",
        "\(.name)\(if .held then "  (held: the hub starts and wakes nothing here)" else "" end)",
        "  orchestrator  \(if .orchestrator.state == "unregistered" then "running, not registered with hivehouse" elif .orchestrator.state == "resumable" then "stopped, not registered (resumable)" else .orchestrator.state end)\(if .orchestrator.name then "  \(.orchestrator.name)" else "" end)\(if .orchestrator.pane then " in pane \(.orchestrator.pane)" else "" end)\(if .orchestrator.question then "  (a question on its screen)" else "" end)\(if .orchestrator.starting then (if .orchestrator.starting.typed or .orchestrator.starting.sending then "  (coming up in pane \(.orchestrator.starting.pane))" else "  (waiting in pane \(.orchestrator.starting.pane)\(if .orchestrator.starting.question then " on a question" else "" end): hh-hub continue \(.name))" end) else "" end)",
        "  agents        \(if (.agents | length) == 0 then "none" else "\([.agents[] | select(.state == "running")] | length) of \(.agents | length) running\([.agents[] | select(.state != "running" or .question) | "\(.ref) \(if .question then "has a question on its screen" else .state end)"] | if length > 0 then "  (\(join(", ")))" else "" end)" end)",
        "  tasks         \(.open_tasks) open",
        (.repos | to_entries[] | "\(if .key == 0 then "  folders       " else "                " end)\(.value.folder + (" " * ($fw - (.value.folder | length))))  \(.value.kind)\(if .value.branch then "  \(.value.branch)  \(if .value.changed == 0 then "clean" else "\(.value.changed) changed" end)" else "" end)"))'
  fi ;;

task)
  name="${1:-}"; [ -n "$name" ] || hh_die 64 "$USAGE"; shift
  text=""; given=0
  while [ $# -gt 0 ]; do [ $# -ge 2 ] && [ "$1" = --text ] || hh_die 64 "$USAGE"; text="$2"; given=1; shift 2; done
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  hn=$(need_hub_name "$root") || exit $?
  [ "$given" = 1 ] || text=$(cat)
  [ -n "$(printf '%s' "$text" | tr -d '[:space:]')" ] || hh_die 4 "a task needs its text"
  lock "$root"
  n=$(jq -r --arg p "$name" 'select(.project == $p) | .id' "$root/$HH_HUB_DIR/tasks.jsonl" | sort -u | grep -c .)
  id="$name-$((n + 1))"
  folders=$(printf '%s' "$PROJ" | jq -r '.home as $h | .repos[] | "\(if . == $h then 1 else 0 end)\t\(.)"' | while IFS=$'\t' read -r ish f; do
    if [ "$ish" = 1 ]; then printf -- '- %s (home: the team works from here)\n' "$(abs "$root" "$f")"; else printf -- '- %s\n' "$(abs "$root" "$f")"; fi
  done)
  {
    printf '# Task %s\n\n' "$id"
    printf 'From the owner, through %s. The owner reads and answers you only through %s: send it your questions, your plan,\n' "$hn" "$hn"
    printf 'blockers and finished work with SendMessage, the first line `TASK %s:` and then one of: %s.\n' "$id" "$(printf '%s' "$HUB_REPLIES" | sed 's/ /, /g')"
    printf 'A reply that begins `OWNER on TASK %s:` carries the owner'"'"'s own words. One that begins `HUB on TASK %s:` is the hub'"'"'s own decision, made for the owner while they are away.\n\n' "$id" "$id"
    printf 'Project folders:\n%s\n\n## The task\n\n%s\n' "$folders" "$text"
  } > "$root/$HH_HUB_DIR/tasks/$id.md"
  append_event "$root" "$id" "$name" asked ""
  printf '%s\t%s\n' "$id" "$root/$HH_HUB_DIR/tasks/$id.md" ;;

log)
  [ $# -ge 2 ] || hh_die 64 "$USAGE"
  id="$1"; ev="$2"; shift 2; note=""
  while [ $# -gt 0 ]; do [ $# -ge 2 ] && [ "$1" = --note ] || hh_die 64 "$USAGE"; note="$2"; shift 2; done
  in_list "$ev" "$HUB_EVENTS" || hh_die 4 "unknown event: $ev (events: $HUB_EVENTS)"
  [ "$ev" != decided ] || hh_die 4 "a decision is recorded with hh-hub decide, which asks the owner's delegate file"
  root=$(hub_root) || exit $?
  lock "$root"
  [ -n "$(task_state "$root" "$id")" ] || hh_die 2 "no task $id in this hub"
  p=$(jq -r --arg i "$id" 'select(.id == $i) | .project' "$root/$HH_HUB_DIR/tasks.jsonl" | head -1)
  append_event "$root" "$id" "$p" "$ev" "$note"
  echo "$id $ev" ;;

tasks)
  want=""; open=0; json=0
  while [ $# -gt 0 ]; do case "$1" in --open) open=1 ;; --json) json=1 ;; -*) hh_die 64 "$USAGE" ;; *) want="$1" ;; esac; shift; done
  root=$(hub_root) || exit $?
  rows=$(jq -s --arg w "$want" --argjson o "$open" --argjson c "$HUB_CLOSED_JSON" --argjson ow "$HUB_NEEDS_OWNER_JSON" '
    [group_by(.id)[] | select($w == "" or .[0].project == $w)
     | {id: .[0].id, project: .[0].project, asked: .[0].at,
        state: ([.[] | select(.event != "note")] | last | .event),
        updated: (last | .at), last_note: ([.[] | select(.note)] | last | .note // null),
        decisions: [.[] | select(.event == "decided") | {at, reason: (.note // "")}]}
     | .needs_owner = (.state as $s | $ow | index($s) != null)
     | select($o == 0 or ((.state as $s | $c | index($s)) | not))] | sort_by(.asked)' "$root/$HH_HUB_DIR/tasks.jsonl")
  if [ "$json" = 1 ]; then printf '%s\n' "$rows"
  else printf '%s' "$rows" | jq -r '.[] | "\(.id)\t\(.state)\t\(.updated)\(if .last_note then "\t\(.last_note)" else "" end)"'; fi ;;

wake)
  name="${1:-}"; [ -n "$name" ] || hh_die 64 "$USAGE"; shift
  start_opts 0 "$@"
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  hn=$(need_hub_name "$root") || exit $?
  orch_state "$root" "$name" "$HOME_DIR"
  case "$O_STATE" in
    none) hh_die 2 "no orchestrator is recorded for $name: start one on a task with hh-hub start $name <task id>" ;;
    resumable) ;;   # nothing recorded, but a transcript of it: resumed below by its session id
    running) hh_die 4 "$name's orchestrator is running as $O_NAME: message it instead" ;;
    unregistered) hh_die 4 "$name's orchestrator is running as $O_NAME (pid $O_PID${O_PANE:+, pane $O_PANE}) but is not registered with hivehouse: ask it to run hh-spawn --self --agent orchestrator --hub $hn" ;;
    unknown) hh_die 4 "cannot tell whether $name's orchestrator is running; nothing was started" ;;
  esac
  [ -n "$O_SID" ] || hh_die 2 "$name's orchestrator has no session recorded, so there is no conversation to resume"
  # whatever the state above says (a start time read in another locale, a name that does not match): a live Claude already holding this
  # conversation means it is running, and a second process on it would fork it
  if holder=$(hh_session_holder "$O_SID"); then who=${O_NAME:-$name}; hh_die 4 "$who's conversation is already open in a live session (pid $holder): it is running; nothing was started."; fi
  project_mode "$HOME_DIR"
  hh_is_session_name "$O_NAME" || hh_die 4 "$name's orchestrator name is not one hivehouse will type"
  args=(--resume "$O_SID" --name "$O_NAME"); [ -z "$MODE" ] || args+=(--permission-mode "$MODE")
  launch "$root" "$name" wake "$O_ROOT" \
    "You are $O_NAME, resumed by $hn after a restart. Register again with hh-spawn --self --agent $O_AGENT --hub $hn, run hh-context --all, and run hh-spawn --respawn <agent> for each agent it marks (not running). Then send $hn one line, first word BACK: which agents are back and what you were doing." \
    "" "${O_AGENT:-orchestrator}" "${args[@]}" ;;

start)
  [ $# -gt 0 ] || { hub_start; exit $?; }
  name="${1:-}"; id="${2:-}"; [ -n "$name" ] && [ -n "$id" ] || hh_die 64 "$USAGE"; shift 2
  overnight=0; sargs=()
  for a in "$@"; do if [ "$a" = --overnight ]; then overnight=1; else sargs+=("$a"); fi; done
  start_opts 1 ${sargs[@]+"${sargs[@]}"}
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  hn=$(need_hub_name "$root") || exit $?
  st=$(task_state "$root" "$id"); [ -n "$st" ] || hh_die 2 "no task $id in this hub"
  [ "$(jq -r --arg i "$id" 'select(.id == $i) | .project' "$root/$HH_HUB_DIR/tasks.jsonl" | head -1)" = "$name" ] || hh_die 4 "task $id is not $name's"
  in_list "$st" "$HUB_CLOSED" && hh_die 4 "task $id is $st"
  orch_state "$root" "$name" "$HOME_DIR"
  case "$O_STATE" in
    none|resumable) ;;
    unregistered) hh_die 4 "$name's orchestrator is already running as $O_NAME (pid $O_PID${O_PANE:+, pane $O_PANE}) but is not registered with hivehouse: ask it to run hh-spawn --self --agent orchestrator --hub $hn, then hand it the task" ;;
    *) hh_die 4 "$name already has an orchestrator ($O_STATE): message it, or wake it with hh-hub wake $name" ;;
  esac
  tf="$root/$HH_HUB_DIR/tasks/$id.md"
  hh_is_typed_path "$tf" || hh_die 4 "the task's path is not one hivehouse will type: $tf"
  project_mode "$HOME_DIR"
  args=(--name "$name-orchestrator"); [ -z "$MODEL" ] || args+=(--model "$MODEL"); [ -z "$MODE" ] || args+=(--permission-mode "$MODE")
  if [ "$overnight" = 1 ]; then sline=$(overnight_line "$id" "$tf" "$hn"); else sline="/$PLUGIN:start Task $id: read $tf. It came from the owner through $hn."; fi
  launch "$root" "$name" start "$HOME_DIR" "$sline" "$id" orchestrator "${args[@]}" ;;

run)
  # the two owner-only skills, typed into the project's running orchestrator: only a line this script builds, only when the
  # orchestrator is registered and alive, never while a task waits on the owner, and once (its own record, runs/<project>.json)
  name="${1:-}"; skill="${2:-}"; id="${3:-}"; [ -n "$name" ] && [ -n "$skill" ] && [ -n "$id" ] || hh_die 64 "$USAGE"; shift 3
  case "$skill" in overnight|cleanup) ;; *) hh_die 64 "$USAGE" ;; esac
  disk=""; rargs=()
  for a in "$@"; do if [ "$a" = --disk ]; then disk=" --disk"; else rargs+=("$a"); fi; done
  [ -z "$disk" ] || [ "$skill" = cleanup ] || hh_die 64 "$USAGE"
  start_opts 0 ${rargs[@]+"${rargs[@]}"}
  [ -z "$MODE" ] || hh_die 64 "$USAGE"
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  hn=$(need_hub_name "$root") || exit $?
  st=$(task_state "$root" "$id"); [ -n "$st" ] || hh_die 2 "no task $id in this hub"
  [ "$(jq -r --arg i "$id" 'select(.id == $i) | .project' "$root/$HH_HUB_DIR/tasks.jsonl" | head -1)" = "$name" ] || hh_die 4 "task $id is not $name's"
  in_list "$st" "$HUB_CLOSED" && hh_die 4 "task $id is $st"
  in_list "$st" "$HUB_NEEDS_OWNER" && hh_die 4 "task $id waits on the owner ($st): nothing is run until it is answered"
  [ "$skill" != overnight ] || [ "$st" != overnight ] || hh_die 4 "task $id is already in an overnight run: nothing was typed"
  orch_state "$root" "$name" "$HOME_DIR"
  case "$O_STATE" in
    running) ;;
    stopped) hh_die 4 "$name's orchestrator is stopped: wake it first with hh-hub wake $name" ;;
    none|resumable) hh_die 4 "$name has no orchestrator: start one first with hh-hub start $name $id" ;;
    unregistered) hh_die 4 "$name's orchestrator is running as $O_NAME but is not registered with hivehouse: ask it to run hh-spawn --self --agent orchestrator --hub $hn first" ;;
    *) hh_die 4 "cannot tell whether $name's orchestrator is running; nothing was typed" ;;
  esac
  tf="$root/$HH_HUB_DIR/tasks/$id.md"
  hh_is_typed_path "$tf" || hh_die 4 "the task's path is not one hivehouse will type: $tf"
  entry=$(hh_self_entry "$O_ROOT")
  rsocket=$(printf '%s' "$entry" | jq -r '.socket // empty'); rpane=$(printf '%s' "$entry" | jq -r '.pane // empty')
  [ -n "$rpane" ] || hh_die 4 "$name's orchestrator has no pane recorded"
  if [ "$skill" = overnight ]; then rline=$(overnight_line "$id" "$tf" "$hn"); else rline="/$PLUGIN:cleanup$disk"; fi
  rf="$root/$HH_HUB_DIR/runs/$name.json"
  lock "$root"
  if [ -f "$rf" ] && sending "$rf"; then hh_die 4 "another hh-hub run is typing into $name's orchestrator; it reports when it is done"; fi
  ident=$(hh_pane_identity "$rsocket" "$rpane") || hh_die 4 "cannot read $name's orchestrator pane $rpane"
  mkdir -p "$root/$HH_HUB_DIR/runs"
  jq -nc --arg p "$rpane" --arg s "$rsocket" --arg i "${ident%%$'\t'*}" --arg t "${ident#*$'\t'}" --arg k "$skill" --arg l "$rline" --arg task "$id" --arg at "$(hh_now)" \
    --arg sp "$$" --arg ss "$(hh_lstart $$)" \
    '{pane:$p, socket:$s, pane_pid:$i, pane_started:$t, kind:$k, line:$l, typed:false, sender_pid:$sp, sender_started:$ss, at:$at, task:$task}' \
    > "$rf"
  unlock
  finish "$root" "$name" runs ;;

window)
  # the hub's way to fix a window that reads wrong (hh-context says "assumed", or the level is far off): the one team.json writer, under its lock
  name="${1:-}"; agent="${2:-}"; tokens="${3:-}"
  [ $# -eq 3 ] && [ -n "$name" ] && [ -n "$agent" ] || hh_die 64 "$USAGE"
  case "$tokens" in ''|*[!0-9]*|0|0[0-9]*) hh_die 4 "the window is a positive number of tokens: $tokens" ;; esac
  root=$(hub_root) || exit $?
  only_the_marked_hub "$root" window
  need_project "$root" "$name"
  find_agent "$name" "$agent"
  hh_team_edit "$F_ROOT" '.agents |= map(if .name == $a then .window = ($w | tonumber) else . end)' --arg a "$F_NAME" --arg w "$tokens" || exit $?
  echo "$F_NAME window $tokens" ;;

dialog)
  name="${1:-}"; [ -n "$name" ] || hh_die 64 "$USAGE"; shift
  agent=""; if [ $# -gt 0 ]; then agent="$1"; shift; fi
  [ $# -eq 0 ] || hh_die 64 "$USAGE"
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  dialog_target "$root" "$name" "$agent"
  d=$(hh_pane_dialog "$T_SOCKET" "$T_PANE"); rc=$?
  case "$rc" in
    0) ;;
    3) hh_die 4 "no dialog is on $T_SESSION's screen (pane $T_PANE)" ;;
    *) hh_die 4 "cannot read $T_SESSION's pane $T_PANE" ;;
  esac
  printf '%s' "$d" | jq -c --arg p "$name" --arg s "$T_SESSION" --arg pane "$T_PANE" '{project:$p, session:$s, pane:$pane} + .' ;;

answer)
  # one key for a dialog the owner chose an option of: the digit of a numbered dialog, Escape, or, for a menu without digits,
  # arrow keys to the chosen row and Enter as the last key of that choice. Never text, never Enter on its own. The screen is
  # read again under the lock and must be the one the owner was shown (its fingerprint).
  name="${1:-}"; [ -n "$name" ] || hh_die 64 "$USAGE"; shift
  agent=""; case "${1:-}" in ''|--*) ;; *) agent="$1"; shift ;; esac
  choice=""; seen=""
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || hh_die 64 "$USAGE"
    case "$1" in --choice) choice="$2" ;; --seen) seen="$2" ;; *) hh_die 64 "$USAGE" ;; esac
    shift 2
  done
  case "$choice" in esc|[1-9]) ;; *) hh_die 64 "$USAGE" ;; esac
  case "$seen" in ''|*[!0-9a-f]*) hh_die 64 "$USAGE" ;; esac
  [ "${#seen}" -eq 40 ] || hh_die 64 "$USAGE"
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  # while the owner is away the hub decides internal work but never answers a screen dialog (a permission prompt, say): it is the owner's
  ! delegate_for_hub "$root" || hh_die 4 "the owner is away: the hub never answers a screen dialog; it waits for them (hh-hub dialog still reads it)"
  lock "$root"
  dialog_target "$root" "$name" "$agent"
  d=$(hh_pane_dialog "$T_SOCKET" "$T_PANE"); rc=$?
  case "$rc" in
    0) ;;
    3) hh_die 4 "no dialog is on $T_SESSION's screen (pane $T_PANE): nothing was sent" ;;
    *) hh_die 4 "cannot read $T_SESSION's pane $T_PANE: nothing was sent" ;;
  esac
  [ "$(printf '%s' "$d" | jq -r .fingerprint)" = "$seen" ] || hh_die 4 "the dialog changed; look again: nothing was sent"
  keys=()
  if [ "$choice" = esc ]; then
    [ "$(printf '%s' "$d" | jq -r .esc)" = true ] || hh_die 4 "this dialog does not offer Escape: answer it in the pane"
    keys=(Escape); label="Esc"
  else
    opt=$(printf '%s' "$d" | jq -c --argjson n "$choice" '[.options[] | select(.n == $n)][0] // empty')
    [ -n "$opt" ] || hh_die 64 "this dialog has no option $choice"
    [ "$(printf '%s' "$opt" | jq -r .offered)" = true ] || hh_die 4 "option $choice needs your own text: answer it in the pane"
    label=$(printf '%s' "$opt" | jq -r .label); optn=$(printf '%s' "$opt" | jq -r .n)
    hh_is_number "$optn" || hh_die 4 "cannot read the number of option $choice: answer it in the pane"
    case "$(printf '%s' "$d" | jq -r .kind)" in
      numbered) keys=("$optn") ;;
      menu)
        cur=$(printf '%s' "$d" | jq -r '.cursor // empty'); hh_is_number "$cur" || hh_die 4 "cannot tell which row the cursor is on: answer it in the pane"
        delta=$((optn - cur))
        while [ "$delta" -gt 0 ]; do keys+=(Down); delta=$((delta - 1)); done
        while [ "$delta" -lt 0 ]; do keys+=(Up); delta=$((delta + 1)); done
        keys+=(Enter) ;;
      *) hh_die 4 "the options of this dialog could not be read: answer it in the pane" ;;
    esac
  fi
  for k in "${keys[@]}"; do hh_tmux_on "$T_SOCKET" send-keys -t "$T_PANE" "$k"; sleep 0.2; done
  jq -nc --arg p "$name" --arg s "$T_SESSION" --arg c "$choice" --arg o "$label" --arg at "$(hh_now)" \
    '{event:"answered-dialog", project:$p, session:$s, choice:$c, option:$o, at:$at}' >> "$root/$HH_HUB_DIR/answers.jsonl"
  unlock   # the wait below can take seconds: a log or a task meanwhile must not find the hub locked
  gone=false
  for _ in 1 2 3 4 5; do
    sleep 1
    hh_pane_dialog "$T_SOCKET" "$T_PANE" >/dev/null; [ $? -eq 3 ] && { gone=true; break; }
  done
  jq -nc --arg s "$T_SESSION" --arg c "$choice" --arg o "$label" --argjson g "$gone" '{answered:true, session:$s, choice:$c, option:$o, dialog_gone:$g}' ;;

continue)
  name="${1:-}"; [ -n "$name" ] || hh_die 64 "$USAGE"; shift
  start_opts 0 "$@"
  [ -z "$MODE" ] || hh_die 64 "$USAGE"
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  f="$root/$HH_HUB_DIR/panes/$name.json"
  lock "$root"
  # a run stopped at a dialog is picked up here, before any start record
  rf="$root/$HH_HUB_DIR/runs/$name.json"
  if [ -f "$rf" ] && [ "$(hh_json_get "$rf" .typed)" != true ] && ! sending "$rf" \
     && hh_recorded_pane_is "$(hh_json_get "$rf" .socket)" "$(hh_json_get "$rf" .pane)" "$(hh_json_get "$rf" .pane_pid)" "$(hh_json_get "$rf" .pane_started)"; then
    jq --arg sp "$$" --arg ss "$(hh_lstart $$)" '.sender_pid = $sp | .sender_started = $ss' "$rf" > "$rf.tmp$$" && mv "$rf.tmp$$" "$rf"
    unlock
    finish "$root" "$name" runs
    exit $?
  fi
  pending "$root" "$name"; case $? in
    1) hh_die 2 "this hub has started nothing for $name that is still waiting" ;;
    2) hh_die 4 "cannot tell whether the pane this hub started for $name is still there" ;;
  esac
  [ "$(hh_json_get "$f" .typed)" != true ] || hh_die 4 "$name's orchestrator was already sent its line in pane $(hh_json_get "$f" .pane); it reports back when it is up"
  sending "$f" && hh_die 4 "$name's orchestrator is being started in pane $(hh_json_get "$f" .pane) and its line is on the way; nothing to continue"
  jq --arg sp "$$" --arg ss "$(hh_lstart $$)" '.sender_pid = $sp | .sender_started = $ss' "$f" > "$f.tmp$$" && mv "$f.tmp$$" "$f"
  unlock
  finish "$root" "$name" ;;

away)
  # Prints what the owner pastes to turn delegate mode on: the sudo lines that make the root-owned delegate file, and the
  # hub's own start line (marked, in bypass, with only its allowed MCP servers). hivehouse never runs sudo itself, so a changed
  # script cannot take the password, and the owner sees what runs as root. The hub is found from the cwd alone.
  until=""; allow=""; rhosts=""; rcmds=""; rtools=""; rpeers=""; hookv=on
  while [ $# -gt 0 ]; do
    if [ "$1" = --no-hook ]; then hookv=off; shift; continue; fi
    [ $# -ge 2 ] || hh_die 64 "$USAGE"
    case "$1" in --until) until="$2" ;; --mcp-allow) allow="$2" ;; --remote-allow) rhosts="$2" ;; --tools) rtools="$2" ;; --peers) rpeers="$2" ;; --allow) rcmds="$2" ;; *) hh_die 64 "$USAGE" ;; esac
    shift 2
  done
  [ -n "$until" ] || hh_die 64 "$USAGE"
  root=$(hub_root_cwd) || exit $?
  hubn=$(hub_chosen_name "$root" 2>/dev/null) || hubn=hub
  hh_is_typed_path "$root" || hh_die 4 "the hub's folder is not a path hivehouse will print into a command: $root"
  case "$allow" in *[!${HH_LOWER}${HH_UPPER}${HH_DIGITS}_,.:-]*) hh_die 4 "--mcp-allow is a comma-separated list of server or tool names" ;; esac
  # the same checks the delegate file is read with, so a line that would read invalid is never printed
  hh_delegate_check_list hosts "$rhosts" || hh_die 4 "--remote-allow: $HH_DELEGATE_WHY"
  hh_delegate_check_list allow "$rcmds" || hh_die 4 "--allow: $HH_DELEGATE_WHY"
  hh_delegate_check_list tools "$rtools" || hh_die 4 "--tools: $HH_DELEGATE_WHY"
  hh_delegate_check_list peers "$rpeers" || hh_die 4 "--peers: $HH_DELEGATE_WHY"
  now=$(/bin/date +%s)
  case "$until" in
    *[!0-9]*)
      case "$until" in
        +[0-9]*[mhd]) n=${until#+}; u=${n##*[0-9]}; n=${n%"$u"}
          case "$u" in m) epoch=$((now + n * 60)) ;; h) epoch=$((now + n * 3600)) ;; d) epoch=$((now + n * 86400)) ;; esac ;;
        *) epoch=$(perl -MTime::Local -e '
             my $t = shift; $t =~ s/T/ /;
             if ($t =~ /^(\d{4})-(\d\d)-(\d\d)(?: (\d\d):(\d\d))?$/) { print timelocal(0, $5 // 0, $4 // 0, $3, $2 - 1, $1) } else { exit 1 }' "$until") || hh_die 64 "--until is an epoch, +<n>m|h|d, or YYYY-MM-DD[ HH:MM] (local time): $until" ;;
      esac ;;
    *) epoch="$until" ;;
  esac
  hh_is_number "$epoch" || hh_die 64 "--until is an epoch, +<n>m|h|d, or YYYY-MM-DD[ HH:MM] (local time): $until"
  [ "$epoch" -gt "$now" ] || hh_die 4 "--until is not in the future"
  [ "$epoch" -le $((now + 604800)) ] || hh_die 4 "away is at most 7 days: the hub's heartbeat does not outlive that"
  # the hub's records, each project home and each worktree team root of one are checked as the delegate check will check them, before anything is printed: an away that
  # would be refused unseen is not worth the owner's sudo. The group-writable ones this user owns are fixed by a line needing no sudo.
  hh_jq_resolve
  [ -n "$HH_JQ" ] || hh_die 4 "no root-owned jq was found (/usr/bin/jq, /usr/local/bin/jq or /opt/homebrew/bin/jq): away mode reads its records with one, so it cannot be switched on here"
  me=$(hh_real_uid); hh_is_number "$me" || hh_die 4 "this user's id cannot be read"
  bad=""; hh_hub_records_trusted "$root" "$me" || bad=$HH_BAD_LIST
  while IFS=$'\t' read -r name home; do
    [ -n "$home" ] || continue
    case "$home" in /*) a=$home ;; *) a="$root/$home" ;; esac
    a=$(cd "$a" 2>/dev/null && pwd -P) || continue
    # the home, then each worktree team root of it: hh_delegate_for_project checks them the same strict way
    while IFS= read -r t; do
      hh_path_trusted "$t" dir "$me" strict || bad="$bad$t"$'\t'"$HH_DELEGATE_WHY"$'\n'
    done < <(hh_team_roots "$a")
  done < <(jq -r '.projects[]? | [.name, .home] | @tsv' "$root/$HH_HUB_DIR/projects.json" 2>/dev/null)
  if [ -n "$bad" ]; then
    echo "# Not away: the delegate check would refuse this hub, so no line to paste is printed."
    while IFS=$'\t' read -r p why; do
      [ -n "$p" ] || continue
      echo "# $why"
      # only a path this user owns, that is no link, fails for being writable (hh_path_trusted asks the owner and the kind first)
      case "$why" in *"writable by group or others"*) printf 'chmod -- go-w %q\n' "$p" ;; esac
    done <<< "$bad"
    hh_die 4 "away needs the hub's records and every project home to be this user's and not writable by group or others (fix them with the lines above, then run hh-hub away again)"
  fi
  seal_hub "$root"
  file=$(hh_delegate_path) || hh_die 4 "this user's id cannot be read, so there is no delegate file to name"
  dir=${file%/*}; base=${dir%/*}; grp=root; [ ! -d /System/Library ] || grp=wheel
  hh_is_typed_path "$file" || hh_die 4 "the delegate file's path is not one hivehouse will print into a command: $file"
  mcp="$root/$HH_HUB_DIR/away-mcp.json"
  cdir=$(hh_claude_dir); cj=$(hh_claude_json)
  hh_write_away_mcp "$mcp" "$allow" "$root" || hh_die 1 "cannot write $mcp"
  missing=$HH_AWAY_MCP_MISSING
  jq -nc --arg s "$(epoch_iso "$now")" --argjson u "$epoch" '{since:$s, until:$u}' > "$root/$HH_HUB_DIR/away.json"
  sid=$(hh_json_get "$root/$HH_HUB_DIR/hub.json" .session_id)
  case "$sid" in ''|*[!${HH_LOWER}${HH_UPPER}${HH_DIGITS}-]*) sid="" ;; esac
  echo "# Away until $(epoch_local "$epoch") (at most 7 days). Paste these lines in a terminal: hivehouse never runs sudo, and what runs as root is only this."
  echo "# This file is for $(/usr/bin/id -un) (uid $(/usr/bin/id -u)): one file for each user, so another user on this machine is not away. The uid is written into the lines, so an administrator can paste these lines from another account."
  printf 'sudo mkdir -p -- %q\n' "$dir"
  printf "printf '%%s\\\\n' %q %q %q %q %q %q %q %q %q | sudo tee -- %q > /dev/null\n" "$HH_DELEGATE_TAG $HH_DELEGATE_WRITE" "hub=$root" "until=$epoch" "mcp=$allow" "hosts=$rhosts" "allow=$rcmds" "tools=$rtools" "peers=$rpeers" "hook=$hookv" "$file"
  printf 'sudo chown -- root:%s %q %q %q\n' "$grp" "$base" "$dir" "$file"
  printf 'sudo chmod -- 0755 %q %q\n' "$base" "$dir"
  printf 'sudo chmod -- 0644 %q\n' "$file"
  echo "# Then exit the running hub (so two do not share the folder) and start it in tmux with this line, pasted in a terminal outside tmux: marked, in bypass, with only its allowed MCP servers. The marker and its variables go to tmux with -e, never through the shell."
  hub_session_note "$hubn"
  tm=$(tmux_word)
  if [ -n "$sid" ]; then
    printf '%s new-session -s %q -c %q -e HH_AWAY_BYPASS=1 -e HH_PROJECT=%q -e HH_AWAY_HUB=%q -e HH_AWAY_MCP_ALLOW=%q claude --permission-mode bypassPermissions --no-chrome --strict-mcp-config --mcp-config %q --resume %q\n' "$tm" "$hubn" "$root" "$root" "$root" "$allow" "$mcp" "$sid"
  else
    printf '%s new-session -s %q -c %q -e HH_AWAY_BYPASS=1 -e HH_PROJECT=%q -e HH_AWAY_HUB=%q -e HH_AWAY_MCP_ALLOW=%q claude --name %q --permission-mode bypassPermissions --no-chrome --strict-mcp-config --mcp-config %q /%s:hub\n' "$tm" "$hubn" "$root" "$root" "$root" "$allow" "$hubn" "$mcp" "$PLUGIN"
  fi
  # what Claude Code asks once, by hand, before the owner leaves: nobody is there to answer it later
  if [ "$(jq -r '.skipDangerousModePermissionPrompt // false' "$cdir/settings.json" 2>/dev/null)" != true ]; then
    echo "# Before leaving: Claude Code shows a one-time warning the first time it runs in bypass mode. Start claude --permission-mode bypassPermissions once and choose 'Yes, I accept' (it then writes skipDangerousModePermissionPrompt to $cdir/settings.json): nobody can answer it while you are away."
  fi
  # the hub's folder and every listed project's home and repositories: a folder Claude Code does not trust stops its session at the
  # trust dialog, which nobody answers while the owner is away (a repository, or a worktree, is judged by its main repository's own entry)
  seen=" "
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    case "$t" in /*) ;; *) t="$root/$t" ;; esac
    hh_claude_trusts "$t" && continue
    case "$seen" in *" $HH_TRUST_KEY "*) continue ;; esac
    seen="$seen$HH_TRUST_KEY "
    printf '# Before leaving: %q is not trusted by Claude Code yet (it looks for %q in %q). Start claude in %q once and accept the folder-trust dialog: it shows for every untrusted folder.\n' "$t" "$HH_TRUST_KEY" "$cj" "$HH_TRUST_KEY"
  done < <({ printf '%s\n' "$root"; jq -r '.projects[]? | .home, (.repos[]?)' "$root/$HH_HUB_DIR/projects.json" 2>/dev/null; })
  echo "# Away mode needs permission_mode_local set to auto (the hub resolves it); a stricter value keeps its sessions out of bypass."
  echo "# MCP servers allowed for the hub: ${allow:-none}.${missing:+ Not found (not loaded):$missing.}"
  echo "# The MCP allowlist also stops browser automation and computer-use (browser checks) unless they are in it: add them with --mcp-allow if the night needs them."
  echo "# SendMessage is held to the hub and its teams while you are away: sessions on other machines are cut off for the whole away period, except the peers you name with --peers."
  echo "# Nothing runs while the machine is off: after a reboot, start the hub again with the lines above."
  echo "# A message from another session to the hub, while you are away, is information only; to instruct it, type into it (Remote Control, say)."
  if [ -n "$rhosts" ]; then echo "# Remote hosts allowed while away: $rhosts (read-only commands over ssh; nothing else reaches them)."
  else echo "# No remote host is used while away: overnight work runs on this machine."; fi
  echo "# Extra tools allowed while away: ${rtools:-none} (Workflow, WebFetch, DesignSync, ArtifactCheck and PushNotification are refused unless listed with --tools; CronCreate and ScheduleWakeup always pass)."
  echo "# Peers the hub and its orchestrators may message while away: ${rpeers:-none} (sessions on other machines that you name; only the hub and a registered orchestrator of one of its projects may send to them, each send is logged in $HH_HUB_DIR/$HH_PEER_LOG, and nothing local may carry their names)."
  if [ "$hookv" = off ]; then echo "# hook=off: after it has read the call and the session's launch variables, hivehouse's away hook allows every tool call of the away sessions and does not check this user's away sessions; your own guard has to. Launching in bypass, hh-push, hh-remote-sync, hh-cleanup --finish and the hub's screen hook are unchanged."
  else echo "# hook=on: hivehouse's away hook checks every tool call of the away sessions (--no-hook turns it off)."; fi
  echo "# When you are back, run hh-hub back." ;;

back)
  [ $# -eq 0 ] || hh_die 64 "$USAGE"
  root=$(hub_root_cwd) || exit $?
  hh_is_typed_path "$root" || hh_die 4 "the hub's folder is not a path hivehouse will print into a command: $root"
  file=$(hh_delegate_path) || hh_die 4 "this user's id cannot be read, so there is no delegate file to name"
  hh_is_typed_path "$file" || hh_die 4 "the delegate file's path is not one hivehouse will print into a command: $file"
  sid=$(hh_json_get "$root/$HH_HUB_DIR/hub.json" .session_id)
  case "$sid" in ''|*[!${HH_LOWER}${HH_UPPER}${HH_DIGITS}-]*) sid="" ;; esac
  echo "# Away ends when this file is gone. Paste the line in a terminal:"
  printf 'sudo rm -f -- %q\n' "$file"
  echo "# Then exit the hub and start it again in tmux (paste this in a terminal outside tmux) without bypass, so each action it takes asks you again:"
  hubn=$(hub_chosen_name "$root" 2>/dev/null || echo hub)
  hub_session_note "$hubn"
  tm=$(tmux_word)
  if [ -n "$sid" ]; then printf '%s new-session -s %q -c %q -e HH_PROJECT=%q env -u HH_AWAY_BYPASS -u HH_AWAY_HUB -u HH_AWAY_MCP_ALLOW claude --resume %q\n' "$tm" "$hubn" "$root" "$root" "$sid"
  else printf '%s new-session -s %q -c %q -e HH_PROJECT=%q env -u HH_AWAY_BYPASS -u HH_AWAY_HUB -u HH_AWAY_MCP_ALLOW claude --name %q /%s:hub\n' "$tm" "$hubn" "$root" "$root" "$hubn" "$PLUGIN"; fi ;;

decide)
  # A decision the hub made for the owner, recorded word for word. Only while the owner's delegate file is valid for this
  # hub. stdin: the question as the orchestrator asked it, a line "=== ANSWER ===", the answer as sent back.
  id="${1:-}"; [ -n "$id" ] || hh_die 64 "$USAGE"; shift
  reason=""
  while [ $# -gt 0 ]; do [ $# -ge 2 ] && [ "$1" = --reason ] || hh_die 64 "$USAGE"; reason="$2"; shift 2; done
  case "$reason" in ''|*$'\n'*) hh_die 64 "a decision's reason is one line" ;; esac
  root=$(hub_root_cwd) || exit $?
  delegate_for_hub "$root" || hh_die 4 "the owner is not away (no valid delegate file for this hub): the owner decides"
  text=$(cat)
  case "$text" in *$'\n=== ANSWER ===\n'*) ;; *) hh_die 64 "stdin is the question, a line === ANSWER ===, then the answer" ;; esac
  question=${text%%$'\n=== ANSWER ===\n'*}; answer=${text#*$'\n=== ANSWER ===\n'}
  [ -n "$(printf '%s' "$question" | tr -d '[:space:]')" ] && [ -n "$(printf '%s' "$answer" | tr -d '[:space:]')" ] || hh_die 64 "a decision needs its question and its answer"
  lock "$root"
  st=$(task_state "$root" "$id"); [ -n "$st" ] || hh_die 2 "no task $id in this hub"
  in_list "$st" "$HUB_CLOSED" && hh_die 4 "task $id is $st"
  p=$(jq -r --arg i "$id" 'select(.id == $i) | .project' "$root/$HH_HUB_DIR/tasks.jsonl" | head -1)
  mkdir -p "$root/$HH_HUB_DIR/decisions"
  {
    printf '## %s: %s\n\n### Question\n\n%s\n\n### Answer\n\n%s\n\n' "$(hh_now)" "$reason" "$question" "$answer"
  } >> "$root/$HH_HUB_DIR/decisions/$id.md"
  append_event "$root" "$id" "$p" decided "$reason"
  echo "$id decided"
  echo "now send the answer you recorded: HUB on TASK $id: $(printf '%s\n' "$answer" | head -1)" ;;

hold)
  name="${1:-}"; [ -n "$name" ] || hh_die 64 "$USAGE"; shift
  off=0; case "${1:-}" in --off) off=1; shift ;; esac
  [ $# -eq 0 ] || hh_die 64 "$USAGE"
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  lock "$root"
  mkdir -p "$root/$HH_HUB_DIR/holds"
  if [ "$off" = 1 ]; then rm -f "$root/$HH_HUB_DIR/holds/$name"; echo "$name released"
  else hh_now > "$root/$HH_HUB_DIR/holds/$name"; echo "$name held"; fi ;;

recover)
  # What the hub does on each beat while the owner is away: the actions due, each capped within a rolling 24 hours, and
  # what is blocked for the owner. It carries nothing out itself. Only while the owner's delegate file is valid for this
  # hub and this session carries the away marker; with no delegate file it prints that nothing is due.
  json=0; max=10
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --max-starts) [ $# -ge 2 ] || hh_die 64 "$USAGE"; max="$2"; shift 2 ;;
      *) hh_die 64 "$USAGE" ;;
    esac
  done
  hh_is_number "$max" || hh_die 4 "--max-starts must be a number"
  root=$(hub_root_cwd) || exit $?
  if ! delegate_for_hub "$root"; then
    if [ "$json" = 1 ]; then echo '{"away":false,"actions":[],"blocked":[]}'; else echo "not away: nothing to recover"; fi
    exit 0
  fi
  away_hub_caller "$root"
  now=$(/bin/date +%s); since=$((now - 86400))
  # every project's state is read first, with no lock held (tmux can be slow); the lock is taken only to write
  rj="$root/$HH_HUB_DIR/recovery.jsonl"; rjf="$rj"; [ -f "$rj" ] || rjf=/dev/null; newrec=""
  rs="$root/$HH_HUB_DIR/recovery-state.json"
  states=$(jq -c . "$rs" 2>/dev/null) || states='{}'
  # what each hung check saw last beat, and what it sees now (only what is seen again is kept)
  hs="$root/$HH_HUB_DIR/hung-state.json"; hstates=$(jq -c . "$hs" 2>/dev/null) || hstates='{}'; newhs='{}'
  # tasks that can go on without the owner: open, and not waiting on them
  work=$(jq -s --argjson c "$HUB_CLOSED_JSON" --argjson ow "$HUB_NEEDS_OWNER_JSON" '[group_by(.id)[]
    | {p: .[0].project, id: .[0].id, s: ([.[] | select(.event != "note")] | last | .event)}
    | select((.s as $s | ($c + $ow) | index($s)) | not)]' "$root/$HH_HUB_DIR/tasks.jsonl")
  starts=$(jq -s --argjson s "$since" '[.[] | select(.epoch > $s and (.action == "start" or .action == "wake"))] | length' "$rjf")
  actions='[]'; blocked='[]'
  for n in $(jq -r '.projects[]?.name' "$root/$HH_HUB_DIR/projects.json"); do
    hh_is_agent_name "$n" || continue
    [ ! -f "$root/$HH_HUB_DIR/holds/$n" ] || continue
    need_project "$root" "$n"
    orch_state "$root" "$n" "$HOME_DIR"
    task=$(printf '%s' "$work" | jq -r --arg p "$n" '[.[] | select(.p == $p)][0].id // empty')
    prevag=$(printf '%s' "$states" | jq -c --arg p "$n" '.[$p] // {}')
    nowag='{}'; newly='[]'
    while IFS= read -r tr <&3; do   # every team root of the project, the home first
    for a in $(jq -r '.agents[]?.name' "$tr/$HH_STATE_DIR/team.json" 2>/dev/null); do
      hh_is_agent_name "$a" && ! is_orchestrator_entry "$tr" "$a" || continue
      ak=$a; [ "$tr" = "${O_ROOTS[0]}" ] || ak="$tr:$a"   # an agent is its team root and its name; the home's keep the bare name
      hh_team_agent_is "$tr" "$a"; case $? in 0) st=running ;; 1) st=stopped ;; *) st=unknown ;; esac
      if [ "$st" = running ]; then
        IFS=$'\x1f' read -r tsock tpane tpid tstart <<< "$(session_target "$tr" "$a")"
        hung_try "$n" agent "$a" "$task" "$tsock" "$tpane" "$tpid" "$tstart" "$ak"
        [ "$HUNG_STOPPED" = 0 ] || st=restarted   # not "stopped since the last beat": its restart is already an action
      fi
      nowag=$(printf '%s' "$nowag" | jq -c --arg a "$ak" --arg s "$st" '. + {($a): $s}')
      if [ "$st" = stopped ] && [ "$(printf '%s' "$prevag" | jq -r --arg a "$ak" '.[$a] // empty')" = running ]; then
        newly=$(printf '%s' "$newly" | jq -c --arg a "$a" '. + [$a]')
      fi
    done
    done 3< <(hh_team_roots "$HOME_DIR")
    states=$(printf '%s' "$states" | jq -c --arg p "$n" --argjson v "$nowag" '. + {($p): $v}')
    if [ "$O_STATE" = running ] && [ -n "$O_AGENT" ]; then
      IFS=$'\x1f' read -r tsock tpane tpid tstart <<< "$(session_target "$O_ROOT" "$O_AGENT")"
      hung_try "$n" orchestrator "$O_AGENT" "$task" "$tsock" "$tpane" "$tpid" "$tstart"
      [ "$HUNG_STOPPED" = 0 ] || continue   # stopped: the wake action is its restart
    fi
    # a start or wake waiting on a dialog is the owner's: listed, never capped
    if [ "$O_STATE" != running ] && pending "$root" "$n"; then
      if hh_pane_question "$(hh_json_get "$root/$HH_HUB_DIR/panes/$n.json" .socket)" "$(hh_json_get "$root/$HH_HUB_DIR/panes/$n.json" .pane)"; then
        actions=$(printf '%s' "$actions" | jq -c --arg p "$n" '. + [{action:"list", project:$p, why:"a dialog waits on the screen of a session this hub started"}]')
      fi
      continue
    fi
    if { [ "$O_STATE" = stopped ] || [ "$O_STATE" = resumable ]; } && [ -n "$task" ]; then   # resumable: no record, but a transcript; wake resumes it
      tries=$(jq -s --arg i "$n" --argjson s "$since" '[.[] | select(.epoch > $s and .action == "wake" and .item == $i)] | length' "$rjf")
      seenblock=$(jq -s --arg i "$n" --argjson s "$since" '[.[] | select(.epoch > $s and .action == "blocked-wake" and .item == $i)] | length' "$rjf")
      if [ "$tries" -ge 3 ]; then
        [ "$seenblock" -gt 0 ] || {
          blocked=$(printf '%s' "$blocked" | jq -c --arg p "$n" --arg t "$task" '. + [{action:"wake", project:$p, task:$t, reason:"woken 3 times in 24 hours and still stopped"}]')
          newrec="$newrec$(jq -nc --arg i "$n" --argjson e "$now" '{epoch:$e, action:"blocked-wake", item:$i}')"$'\n'; }
      elif [ "$starts" -ge "$max" ]; then
        [ "$seenblock" -gt 0 ] || {
          blocked=$(printf '%s' "$blocked" | jq -c --arg p "$n" --arg t "$task" --argjson m "$max" '. + [{action:"wake", project:$p, task:$t, reason:"the daily cap of \($m) sessions started or woken is reached"}]')
          newrec="$newrec$(jq -nc --arg i "$n" --argjson e "$now" '{epoch:$e, action:"blocked-wake", item:$i}')"$'\n'; }
      else
        actions=$(printf '%s' "$actions" | jq -c --arg p "$n" --arg t "$task" '. + [{action:"wake", project:$p, task:$t}]')
        starts=$((starts + 1))   # this beat's wake is one of the day's sessions: the next project sees the cap with it
      fi
    elif [ "$O_STATE" = running ] && [ "$newly" != '[]' ]; then
      tries=$(jq -s --arg i "$n" --argjson s "$since" '[.[] | select(.epoch > $s and .action == "respawn" and .item == $i)] | length' "$rjf")
      if [ "$tries" -ge 3 ]; then
        blocked=$(printf '%s' "$blocked" | jq -c --arg p "$n" --arg t "$task" --argjson a "$newly" '. + [{action:"respawn", project:$p, agents:$a, reason:"RESPAWN sent 3 times in 24 hours"}]')
      else
        actions=$(printf '%s' "$actions" | jq -c --arg p "$n" --argjson a "$newly" '. + [{action:"respawn", project:$p, agents:$a}]')
        newrec="$newrec$(jq -nc --arg i "$n" --argjson e "$now" '{epoch:$e, action:"respawn", item:$i}')"$'\n'
      fi
    fi
  done
  lock "$root"
  [ -z "$newrec" ] || printf '%s' "$newrec" >> "$rj"
  printf '%s\n' "$states" > "$rs.tmp$$" && mv "$rs.tmp$$" "$rs"
  printf '%s\n' "$newhs" > "$hs.tmp$$" && mv "$hs.tmp$$" "$hs"
  unlock
  if [ "$json" = 1 ]; then
    jq -nc --argjson u "$AWAY_UNTIL" --argjson a "$actions" --argjson b "$blocked" '{away:true, until:$u, actions:$a, blocked:$b}'
  else
    printf '%s' "$actions" | jq -r '.[] | "\(.action) \(.project)\(if .task then " (task \(.task))" else "" end)\(if .agents then " (agents: \(.agents | join(", ")))" else "" end)\(if .why then ": \(.why)" else "" end)"'
    printf '%s' "$blocked" | jq -r '.[] | "blocked \(.action) \(.project): \(.reason)"'
  fi ;;

naming)
  # hh-hub naming --session <id>: what Claude Code records about this hub's own session ({found, name, source}) and a name
  # for it no other running session has (hub, else hub-2...). The records are Claude Code's own and undocumented
  # (<config dir>/sessions/<pid>.json); without one, found is false and the session is left as it is.
  [ $# -eq 2 ] && [ "$1" = --session ] || hh_die 64 "$USAGE"
  sid="$2"; case "$sid" in ''|*[!${HH_LOWER}${HH_UPPER}${HH_DIGITS}-]*) hh_die 4 "bad session id: $sid" ;; esac
  found=false; mname=""; msource=""; taken=""
  for f in "$(hh_claude_dir)"/sessions/*.json; do
    [ -f "$f" ] || continue
    e=$(jq -r '[.pid, .sessionId, .name, .nameSource] | map(. // "" | tostring) | join("\u001f")' "$f" 2>/dev/null) || continue
    IFS=$'\x1f' read -r pid fsid fname fsource <<< "$e"
    hh_is_number "$pid" && hh_alive "$pid" && hh_is_claude "$pid" || continue
    if [ "$fsid" = "$sid" ]; then found=true; mname="$fname"; msource="$fsource"; else taken="$taken|$fname|"; fi
  done
  base=hub; if root=$(hub_root 2>/dev/null); then base=$(hub_chosen_name "$root") || exit $?; fi
  free=$base; i=2
  while case "$taken" in *"|$free|"*) true ;; *) false ;; esac; do free="$base-$i"; i=$((i + 1)); done
  jq -nc --argjson f "$found" --arg n "$mname" --arg s "$msource" --arg free "$free" '{found:$f, name:$n, source:$s, free:$free}' ;;

*) hh_die 64 "$USAGE" ;;
esac

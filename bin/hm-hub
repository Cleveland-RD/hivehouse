#!/usr/bin/env bash
# The owner's hub: one Claude session in the owner's work folder that knows every project, hands each task to that
# project's orchestrator, wakes an orchestrator a restart stopped and starts one where none is. It never reads or
# changes a project's code: everything here is records, tmux and fixed lines. bash 3.2 compatible.
# The hub's state is <work folder>/.hivemind-hub/: projects.json, hub.json (the hub's own session), tasks.jsonl (the
# ledger, one event per line), tasks/<id>.md (each task's text), memory/<project>.md (the hub's notes), panes/<project>.json
# (an orchestrator this hub started, with the line it is to be sent and whether it was: kept until that session registers,
# so a start stopped at a question is continued rather than made twice), runs/<project>.json (the same for a line `run` types
# into a running orchestrator's own pane). HM_HUB names the work folder; else the nearest
# folder at or above the cwd holding .hivemind-hub/.
# answers.jsonl is the log of dialogs answered through `answer` (a dialog belongs to no task).
# Exit: 2 not found (no hub, project, task, agent or record), 4 refused value or state, 5 a dialog needs a person, 1 never idle,
# 64 usage.
set -u
. "$(dirname "$0")/hm-lib.sh"
# The ledger's vocabulary, declared once. A note never moves a task's state; done and cancelled close it; a plan to
# approve, a question and a blocker wait on the owner.
HUB_EVENTS="asked handed plan question answered blocked overnight cleanup done cancelled note"
HUB_CLOSED="done cancelled"
HUB_NEEDS_OWNER="plan question blocked"
HUB_CLOSED_JSON=$(printf '%s' "$HUB_CLOSED" | jq -Rc 'split(" ")')
HUB_NEEDS_OWNER_JSON=$(printf '%s' "$HUB_NEEDS_OWNER" | jq -Rc 'split(" ")')
# The words of the hub's exchange with an orchestrator, held to both skills by tests/test_hub.sh: what an orchestrator's
# message to the hub begins with, and what the hub's own messages begin with.
HUB_REPLIES="HM-CLARIFY HM-PLAN BLOCKED DONE BACK"
HUB_ASKS="TASK OWNER PROGRESS RESPAWN"
USAGE="usage: hm-hub init
       hm-hub self [--name <session name>]
       hm-hub discover
       hm-hub add <project> --home <folder> [--repo <folder>]...
       hm-hub remove <project>
       hm-hub status [<project>] [--json]
       hm-hub task <project> [--text <text>]          (no --text: the text is read from stdin)
       hm-hub log <task id> <event> [--note <text>]    events: $HUB_EVENTS
       hm-hub tasks [<project>] [--open] [--json]
       hm-hub wake <project> [--mode <m>] [--still <s>] [--max-wait <s>]
       hm-hub start <project> <task id> [--overnight] [--model <m>] [--mode <m>] [--still <s>] [--max-wait <s>]
       hm-hub run <project> overnight <task id> [--still <s>] [--max-wait <s>]
       hm-hub run <project> cleanup <task id> [--disk] [--still <s>] [--max-wait <s>]
       hm-hub continue <project> [--still <s>] [--max-wait <s>]
       hm-hub dialog <project> [<agent>]
       hm-hub answer <project> [<agent>] --choice <1-9|esc> --seen <fingerprint>
       hm-hub naming --session <session id>"

cmd="${1:-}"; [ -n "$cmd" ] || hm_die 64 "$USAGE"; shift
hub_root() {  # the work folder holding .hivemind-hub/, resolved
  local d
  if [ -n "${HM_HUB:-}" ]; then
    [ -d "$HM_HUB/.hivemind-hub" ] || hm_die 2 "HM_HUB holds no .hivemind-hub/: $HM_HUB"
    (cd "$HM_HUB" && pwd -P); return
  fi
  d=$(pwd -P)
  while :; do
    [ -d "$d/.hivemind-hub" ] && [ ! -L "$d/.hivemind-hub" ] && { printf '%s\n' "$d"; return 0; }
    [ "$d" = / ] && break; d=$(dirname "$d")
  done
  hm_die 2 "no hub here: run hm-hub init in your work folder"
}
# A project's name follows the agent-name rule (lower-case letters, digits, '_' and '-'): it becomes a tmux session, a
# task id and part of an orchestrator's session name.
check_name() { hm_is_agent_name "$1" || hm_die 4 "a project name is lower-case letters, digits, '_' and '-': $1"; }
LOCK=""
lock() {  # lock <hub root>: the hub's one lock, around every write of projects.json and tasks.jsonl; released on exit
  local i=0 j; j=$(hm_holder_json $$)
  LOCK="$1/.hivemind-hub/lock"
  until hm_lock_try "$LOCK" "$j"; do i=$((i + 1)); [ "$i" -lt 50 ] || hm_die 4 "the hub is locked by another hm-hub"; sleep 0.1; done
  trap 'hm_lock_release "$LOCK" $$' EXIT
}
unlock() { [ -z "$LOCK" ] || hm_lock_release "$LOCK" $$; LOCK=""; trap - EXIT; }
abs() {  # abs <hub root> <folder as stored>: relative to the hub, or absolute
  case "$2" in /*) printf '%s\n' "$2" ;; *) printf '%s/%s\n' "$1" "$2" ;; esac
}
stored() {  # stored <hub root> <folder as given>: resolved; kept relative when it sits under the hub
  local p; p=$(cd "$1" && cd "$2" 2>/dev/null && pwd -P) || return 1
  case "$p/" in "$1/"*) printf '%s\n' "${p#"$1"/}" ;; *) printf '%s\n' "$p" ;; esac
}
kind_of() {  # kind_of <folder>: "repo", "worktree <its repository>", "folder" or "missing"
  local top common
  [ -d "$1" ] || { echo missing; return; }
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || { echo folder; return; }
  [ "$(cd "$top" && pwd -P)" = "$(cd "$1" && pwd -P)" ] || { echo folder; return; }
  common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || { echo folder; return; }
  common=$(cd "$common" && pwd -P)
  if [ "$common" = "$(cd "$1" && pwd -P)/.git" ]; then echo repo; else echo "worktree ${common%/.git}"; fi
}
owner_of() {  # owner_of <hub root> <folder as stored>: the project that lists the folder, or nothing
  jq -r --arg f "$2" '.projects[]? | select([.repos[]?] | index($f)) | .name' "$1/.hivemind-hub/projects.json" 2>/dev/null | head -1
}
project() {  # project <hub root> <name>: the project's entry, or nothing
  jq -c --arg n "$2" '[.projects[]? | select(.name == $n)][0] // empty' "$1/.hivemind-hub/projects.json" 2>/dev/null
}
need_project() {  # need_project <hub root> <name>: sets PROJ (its entry) and HOME_DIR (its home, absolute)
  check_name "$2"
  PROJ=$(project "$1" "$2"); [ -n "$PROJ" ] || hm_die 2 "no project named $2 in this hub"
  HOME_DIR=$(abs "$1" "$(printf '%s' "$PROJ" | jq -r .home)")
}
hub_name() {  # hub_name <hub root>: the hub's session name as recorded by hm-hub self, or fails
  local n; n=$(hm_json_get "$1/.hivemind-hub/hub.json" .name)
  [ -n "$n" ] && hm_is_session_name "$n" && { printf '%s\n' "$n"; return 0; }
  return 1
}
need_hub_name() { hub_name "$1" || hm_die 2 "the hub has not recorded its own session: run hm-hub self"; }
task_state() {  # task_state <hub root> <id>: the last event that is not a note, or nothing when the task was never asked
  jq -r --arg i "$2" 'select(.id == $i and .event != "note") | .event' "$1/.hivemind-hub/tasks.jsonl" 2>/dev/null | tail -1
}
append_event() {  # append_event <hub root> <id> <project> <event> <note>: one ledger line, under the caller's lock
  jq -nc --arg i "$2" --arg p "$3" --arg e "$4" --arg n "$5" --arg at "$(hm_now)" '{id:$i, project:$p, event:$e, at:$at} + (if $n != "" then {note:$n} else {} end)' \
    >> "$1/.hivemind-hub/tasks.jsonl"
}
in_list() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }   # in_list <word> <space-separated list of words>

# An orchestrator this hub started (wake, start) is recorded until it registers itself: a second wake or start while
# that pane still runs would put two orchestrators on one team.
pending() {  # pending <hub root> <project>: 0 a pane this hub started is still that pane; 1 none; 2 cannot tell
  local f="$1/.hivemind-hub/panes/$2.json" rc
  [ -f "$f" ] || return 1
  hm_recorded_pane_is "$(hm_json_get "$f" .socket)" "$(hm_json_get "$f" .pane)" "$(hm_json_get "$f" .pane_pid)" "$(hm_json_get "$f" .pane_started)"; rc=$?
  [ "$rc" -eq 1 ] && rm -f "$f"
  return "$rc"
}
# An orchestrator running outside hivemind (started by hand, or restarted after a restart without registering) is found in
# Claude Code's own record of each running session, <config dir>/sessions/<pid>.json: its name, folder and tmux pane
# (undocumented, as hm_session_record reads it). It is the project's when its name is <project>-orchestrator or the name
# the team recorded, or when it sits in the project's home with "orchestrator" in its name. This hub's own session and a
# pane this hub started are never it.
live_orchestrator() {  # live_orchestrator <hub root> <project> <home> <recorded name>: prints "<pid> <name> <pane>", or fails
  local f e pid name cwd tm hubpid skip
  hubpid=$(hm_json_get "$1/.hivemind-hub/hub.json" .claude_pid); skip=$(hm_json_get "$1/.hivemind-hub/panes/$2.json" .pane_pid)
  for f in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/sessions/*.json; do
    [ -f "$f" ] || continue
    e=$(jq -r '[.pid, .name, .cwd, .tmux] | map(. // "" | tostring) | join("\u001f")' "$f" 2>/dev/null) || continue
    IFS=$'\x1f' read -r pid name cwd tm <<< "$e"
    hm_is_number "$pid" && [ "$pid" != "$hubpid" ] && [ "$pid" != "$skip" ] && hm_alive "$pid" && hm_is_claude "$pid" || continue
    if [ "$name" = "$2-orchestrator" ] || { [ -n "$4" ] && [ "$name" = "$4" ]; } \
       || { [ "$cwd" = "$3" ] && case "$name" in *orchestrator*) true ;; *) false ;; esac; }; then
      hm_is_session_name "$name" || name="?"
      tm="%${tm##*%}"; case "$tm" in %*[!0-9]*|%) tm="" ;; esac
      printf '%s %s %s\n' "$pid" "$name" "$tm"; return 0
    fi
  done
  return 1
}
# orch_state <hub root> <project> <home>: sets O_AGENT, O_NAME, O_SID, O_STATE (running, stopped, unknown, none, or
# unregistered: a live session outside hivemind, with O_PID and O_PANE), and O_QUESTION (true when a dialog waits on the
# screen of a running orchestrator's pane).
orch_state() {
  local entry l
  O_AGENT=""; O_NAME=""; O_SID=""; O_STATE=none; O_PID=""; O_PANE=""; O_QUESTION=false
  entry=$(hm_self_entry "$3")
  if [ -n "$entry" ]; then
    O_AGENT=$(printf '%s' "$entry" | jq -r '.name // empty')
    if hm_is_agent_name "$O_AGENT"; then
      O_NAME=$(hm_orchestrator_name "$3" 2>/dev/null)
      O_SID=$(hm_json_get "$3/.hivemind/team/$O_AGENT/session.json" .session_id)
      case "$O_SID" in *[!${HM_LOWER}${HM_UPPER}${HM_DIGITS}-]*) O_SID="" ;; esac
      hm_team_agent_is "$3" "$O_AGENT"; case $? in 0) O_STATE=running ;; 1) O_STATE=stopped ;; *) O_STATE=unknown ;; esac
      if [ "$O_STATE" = running ] && hm_pane_question "$(printf '%s' "$entry" | jq -r '.socket // empty')" "$(printf '%s' "$entry" | jq -r '.pane // empty')"; then
        O_QUESTION=true
      fi
    else O_AGENT=""; fi
  fi
  case "$O_STATE" in none|stopped)
    if l=$(live_orchestrator "$1" "$2" "$3" "$O_NAME"); then
      O_STATE=unregistered; O_PID=${l%% *}; l=${l#* }; O_NAME=${l%% *}; O_PANE=${l#* }
      [ -n "$O_PANE" ] && hm_pane_question "" "$O_PANE" && O_QUESTION=true
    fi ;;
  esac
}
start_opts() {  # start_opts <model allowed 0|1> [--model m] [--mode m] [--still s] [--max-wait s]: MODEL, MODE, STILL, MAXWAIT
  local allow="$1"; shift
  MODEL=""; MODE=""; STILL=5; MAXWAIT=90
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || hm_die 64 "$USAGE"
    case "$1" in
      --model) [ "$allow" = 1 ] || hm_die 64 "$USAGE"; MODEL="$2" ;;   # a resumed session keeps its own model
      --mode) MODE="$2" ;; --still) STILL="$2" ;; --max-wait) MAXWAIT="$2" ;; *) hm_die 64 "$USAGE" ;;
    esac
    shift 2
  done
  hm_is_number "$STILL" && hm_is_number "$MAXWAIT" || hm_die 4 "--still and --max-wait must be numbers"
  [ -z "$MODEL" ] || hm_is_model_name "$MODEL" || hm_die 4 "bad model: $MODEL"
  [ -z "$MODE" ] || hm_check_mode "$MODE" hm-hub
}
# sending <record>: 0 while the hm-hub that owns the record's line (a start, a wake or a continue) is still waiting to send
# it: the pane is then coming up, not waiting on the owner, and nothing else may send its line
sending() { local p; p=$(hm_json_get "$1" .sender_pid); [ -n "$p" ] && hm_alive "$p" && [ "$(hm_lstart "$p")" = "$(hm_json_get "$1" .sender_started)" ]; }
# project_mode <home>: the owner's --mode, made stricter (never looser) by the project's own .hivemind/settings.json, as
# hm-spawn's agents get it (hm-settings); the hub's folder is no repository, so it is resolved in the project's home
project_mode() { [ -z "$MODE" ] || MODE=$(HM_PROJECT="$1" "$(dirname "$0")/hm-settings" resolve permission_mode "$MODE") || exit $?; }
refuse_pending() {  # refuse_pending <hub root> <project>: under the lock, exits 4 while a pane this hub started for it still runs
  local f="$1/.hivemind-hub/panes/$2.json"
  pending "$1" "$2"; case $? in
    0) if [ "$(hm_json_get "$f" .typed)" = true ] || sending "$f"; then
         hm_die 4 "$2's orchestrator is already coming up in pane $(hm_json_get "$f" .pane); it reports back when it is up"
       fi
       hm_die 4 "$2's orchestrator waits in pane $(hm_json_get "$f" .pane) for its first line (a question on its screen?): answer it there, then run hm-hub continue $2" ;;
    2) hm_die 4 "cannot tell whether the pane this hub started for $2 is still there; nothing was started" ;;
  esac
}
# launch <hub root> <project> <kind> <cwd> <line> <task> <claude args>...: under the hub's lock (so a press of Resume and a
# wake from the conversation cannot both pass the check), a new window in the project's own tmux session, recorded with the
# line it is to be sent; then finish. The pane is the owner's, like the one an orchestrator registers with --self, so it is
# never on a project's manifest (cleanup kills what the manifest names).
launch() {
  local root="$1" name="$2" kind="$3" cwd="$4" line="$5" task="$6" c pane socket ident envs
  shift 6
  c="exec $(printf '%q ' claude "$@")"
  envs=(-e "HIVEMIND_HOME=$(hm_home)")
  [ -n "${HM_TMUX_SOCKET:-}" ] && envs+=(-e "HM_TMUX_SOCKET=$HM_TMUX_SOCKET")
  lock "$root"
  refuse_pending "$root" "$name"
  pane=$(hm_open_window "$name" orchestrator "$cwd" "$c" "${envs[@]}") || exit $?
  socket=$(hm_tmux display-message -p -t "$pane" '#{socket_path}') || exit $?
  ident=$(hm_pane_identity "$socket" "$pane") || hm_die 4 "cannot read the new pane $pane"
  mkdir -p "$root/.hivemind-hub/panes"
  jq -nc --arg p "$pane" --arg s "$socket" --arg i "${ident%%$'\t'*}" --arg t "${ident#*$'\t'}" --arg k "$kind" --arg l "$line" --arg task "$task" --arg at "$(hm_now)" \
    --arg sp "$$" --arg ss "$(hm_lstart $$)" \
    '{pane:$p, socket:$s, pane_pid:$i, pane_started:$t, kind:$k, line:$l, typed:false, sender_pid:$sp, sender_started:$ss, at:$at} + (if $task != "" then {task:$task} else {} end)' \
    > "$root/.hivemind-hub/panes/$name.json"
  unlock
  finish "$root" "$name"
}
# finish <hub root> <project> [panes|runs]: once the recorded pane is idle, types its line and marks it sent; each kind logs
# its own event with its task (a start is handed, a run is overnight or cleanup). The pane is reached on the server the
# record names. A question on its screen is never answered: it says where, and continue picks it up once the owner has.
finish() {
  local root="$1" name="$2" dir="${3:-panes}" f pane line rc socket kind task
  f="$root/.hivemind-hub/$dir/$name.json"; pane=$(hm_json_get "$f" .pane); line=$(hm_json_get "$f" .line); socket=$(hm_json_get "$f" .socket)
  case "$line" in ''|*$'\n'*) hm_die 4 "the line recorded for $name is not one hivemind will type" ;; esac
  wait_idle "$pane" "$STILL" "$MAXWAIT" "$socket"; rc=$?
  case "$rc" in
    0) ;;
    3) echo "hivemind: a question is on the screen of pane $pane ($name): answer it there, then run hm-hub continue $name; nothing was typed" >&2; exit 5 ;;
    *) echo "hivemind: pane $pane ($name) never went idle within ${MAXWAIT}s; nothing was typed; hm-hub continue $name tries again" >&2; exit 1 ;;
  esac
  type_line "$pane" "$line" "$socket"
  lock "$root"
  jq '.typed = true' "$f" > "$f.tmp$$" && mv "$f.tmp$$" "$f"
  kind=$(hm_json_get "$f" .kind); task=$(hm_json_get "$f" .task)
  case "$kind" in
    start) append_event "$root" "$task" "$name" handed "started $name-orchestrator in pane $pane" ;;
    overnight|cleanup) append_event "$root" "$task" "$name" "$kind" "sent to $name's orchestrator in pane $pane" ;;
  esac
  unlock
  echo "$pane"
}
# dialog_target <hub root> <project> <agent or empty>: the screen a dialog is read from and answered on. Sets T_SOCKET, T_PANE
# and T_SESSION. The orchestrator by default: its registered pane, else the pane this hub started for it and it has not
# registered from (a start's first dialog), else the pane of one running outside hivemind. An agent must be on the team
# (exit 2) and running (exit 4). Needs HOME_DIR, so call it after need_project.
dialog_target() {
  local root="$1" name="$2" want="$3" entry
  T_SOCKET=""; T_PANE=""; T_SESSION=""
  orch_state "$root" "$name" "$HOME_DIR"
  if [ -z "$want" ] || [ "$want" = "$O_AGENT" ]; then
    entry=$(hm_self_entry "$HOME_DIR")
    if [ "$O_STATE" = running ] && [ -n "$entry" ]; then
      T_SOCKET=$(printf '%s' "$entry" | jq -r '.socket // empty'); T_PANE=$(printf '%s' "$entry" | jq -r '.pane // empty'); T_SESSION="$O_NAME"
    elif pending "$root" "$name"; then
      T_SOCKET=$(hm_json_get "$root/.hivemind-hub/panes/$name.json" .socket); T_PANE=$(hm_json_get "$root/.hivemind-hub/panes/$name.json" .pane); T_SESSION="$name-orchestrator"
    elif [ "$O_STATE" = unregistered ]; then
      T_PANE="$O_PANE"; T_SESSION="$O_NAME"
    fi
    [ -n "$T_PANE" ] || hm_die 4 "$name has no orchestrator screen to read ($O_STATE)"
  else
    hm_is_agent_name "$want" || hm_die 4 "an agent name is lower-case letters, digits, '_' and '-': $want"
    entry=$(jq -c --arg a "$want" '[.agents[]? | select(.name == $a)][0] // empty' "$HOME_DIR/.hivemind/team.json" 2>/dev/null)
    [ -n "$entry" ] || hm_die 2 "no agent named $want on $name's team"
    hm_team_agent_is "$HOME_DIR" "$want"; [ $? -eq 0 ] || hm_die 4 "$want is not running: there is no screen to read"
    T_SOCKET=$(printf '%s' "$entry" | jq -r '.socket // empty'); T_PANE=$(printf '%s' "$entry" | jq -r '.pane // empty'); T_SESSION="$want"
    [ -n "$T_PANE" ] || hm_die 4 "$want has no pane recorded"
  fi
}
type_line() { hm_tmux_on "${3:-}" send-keys -t "$1" -l "$2"; hm_tmux_on "${3:-}" send-keys -t "$1" Enter; }   # type_line <pane> <fixed line> [socket]
overnight_line() { printf '/hivemind:overnight Task %s: read %s. It came from the owner through %s.' "$1" "$2" "$3"; }   # overnight_line <task id> <task file> <hub name>

case "$cmd" in
init)
  [ $# -eq 0 ] || hm_die 64 "$USAGE"
  git rev-parse --git-dir >/dev/null 2>&1 && hm_die 4 "the hub sits above your projects, never inside a repository: run it in your work folder"
  d=$(pwd -P)
  mkdir -p "$d/.hivemind-hub/memory" "$d/.hivemind-hub/tasks" || exit $?
  [ -f "$d/.hivemind-hub/projects.json" ] || echo '{"projects":[]}' > "$d/.hivemind-hub/projects.json"
  touch "$d/.hivemind-hub/tasks.jsonl"
  echo "$d/.hivemind-hub" ;;

self)
  name=""
  while [ $# -gt 0 ]; do [ $# -ge 2 ] && [ "$1" = --name ] || hm_die 64 "$USAGE"; name="$2"; shift 2; done
  root=$(hub_root) || exit $?
  pid=$(hm_claude_ancestor) || hm_die 2 "hm-hub self must run inside the Claude session that is the hub"
  [ -n "$name" ] || name=$(hm_session_record "$pid" .name)
  [ -n "$name" ] || hm_die 4 "this session has no name: start the hub with claude --name hub /hivemind:hub (or type /rename hub), or pass --name"
  hm_is_session_name "$name" || hm_die 4 "a session name hivemind will type is one line of letters, digits, space, - _ . ( ), at most 64: $name"
  # orchestrators are told to type it (hm-spawn --self --hub <name>), so it is one word
  case "$name" in *[' ()']*) hm_die 4 "the hub's name is one word (letters, digits, - _ .): $name; rename the session" ;; esac
  jq -nc --arg n "$name" --arg p "$pid" --arg s "$(hm_lstart "$pid")" --arg sid "$(hm_session_record "$pid" .sessionId)" --arg at "$(hm_now)" \
    '{name:$n, claude_pid:$p, claude_started:$s, at:$at} + (if $sid != "" then {session_id:$sid} else {} end)' \
    > "$root/.hivemind-hub/hub.json.tmp$$" && mv "$root/.hivemind-hub/hub.json.tmp$$" "$root/.hivemind-hub/hub.json"
  echo "$name" ;;

discover)
  [ $# -eq 0 ] || hm_die 64 "$USAGE"
  root=$(hub_root) || exit $?
  for d in "$root"/*/; do
    d=${d%/}; b=$(basename "$d")
    [ -L "$d" ] && { printf '%-28s %s\n' "$b" "link (not followed)"; continue; }
    k=$(kind_of "$d")
    case "$k" in worktree\ *) w=$(stored "$root" "${k#worktree }") || w="${k#worktree }"; k="worktree of $w" ;; esac
    extra=""; [ -f "$d/.hivemind/team.json" ] && extra="  team"
    owner=$(owner_of "$root" "$b")
    [ -z "$owner" ] || extra="$extra  in $owner"
    printf '%-28s %s%s\n' "$b" "$k" "$extra"
  done ;;

add)
  name="${1:-}"; [ -n "$name" ] || hm_die 64 "$USAGE"; shift
  home=""; repos=()
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || hm_die 64 "$USAGE"
    case "$1" in --home) home="$2" ;; --repo) repos+=("$2") ;; *) hm_die 64 "$USAGE" ;; esac
    shift 2
  done
  [ -n "$home" ] || hm_die 64 "$USAGE"
  check_name "$name"
  root=$(hub_root) || exit $?
  h=$(stored "$root" "$home") || hm_die 4 "no such folder: $home"
  case "$(kind_of "$(abs "$root" "$h")")" in
    repo) ;;
    worktree\ *) hm_die 4 "$home is a worktree; a project's home is its repository's main folder" ;;
    *) hm_die 4 "$home is not a git repository; a project's home is the repository its team works from" ;;
  esac
  list=("$h")
  for r in ${repos[@]+"${repos[@]}"}; do
    s=$(stored "$root" "$r") || hm_die 4 "no such folder: $r"
    dup=0; for x in "${list[@]}"; do [ "$x" = "$s" ] && dup=1; done
    [ "$dup" = 1 ] || list+=("$s")
  done
  lock "$root"
  [ -z "$(project "$root" "$name")" ] || hm_die 4 "a project named $name is already in this hub"
  for s in "${list[@]}"; do
    o=$(owner_of "$root" "$s")
    [ -z "$o" ] || hm_die 4 "$s already belongs to $o"
  done
  f="$root/.hivemind-hub/projects.json"
  jq --arg n "$name" --arg h "$h" --args '.projects += [{name:$n, home:$h, repos:$ARGS.positional}]' "${list[@]}" < "$f" > "$f.tmp$$" \
    && mv "$f.tmp$$" "$f" || { rm -f "$f.tmp$$"; exit 1; }
  echo "$name" ;;

remove)
  [ $# -eq 1 ] || hm_die 64 "$USAGE"
  check_name "$1"; root=$(hub_root) || exit $?
  lock "$root"
  [ -n "$(project "$root" "$1")" ] || hm_die 2 "no project named $1 in this hub"
  f="$root/.hivemind-hub/projects.json"
  jq --arg n "$1" '.projects |= map(select(.name != $n))' "$f" > "$f.tmp$$" && mv "$f.tmp$$" "$f"
  echo "$1" ;;

status)
  want=""; json=0
  while [ $# -gt 0 ]; do case "$1" in --json) json=1 ;; -*) hm_die 64 "$USAGE" ;; *) want="$1" ;; esac; shift; done
  root=$(hub_root) || exit $?
  [ -z "$want" ] || { check_name "$want"; [ -n "$(project "$root" "$want")" ] || hm_die 2 "no project named $want in this hub"; }
  hub=$(jq -c '{name, claude_pid, claude_started}' "$root/.hivemind-hub/hub.json" 2>/dev/null) || hub='{}'
  [ -n "$hub" ] || hub='{}'
  # open tasks per project: those whose last event (a note aside) neither closes them
  opens=$(jq -s --argjson c "$HUB_CLOSED_JSON" '[group_by(.id)[] | {p: .[0].project, s: ([.[] | select(.event != "note")] | last | .event)}
    | select((.s as $s | $c | index($s)) | not)] | group_by(.p) | map({key: .[0].p, value: length}) | from_entries' "$root/.hivemind-hub/tasks.jsonl")
  level() {  # level <agent>: {context, context_assumed} from this project's $levels when one was read, else {}
    local l c x=false
    l=$(printf '%s\n' "$levels" | awk -v a="$1" '$1 == a { print; exit }'); c=$(printf '%s' "$l" | awk '{print $2}')
    case "$c" in ''|*[!0-9]*) echo '{}'; return ;; esac
    case "$l" in *"(window assumed"*) x=true ;; esac   # never inside $(...): bash 3.2 misreads a case there
    jq -nc --argjson c "$c" --argjson x "$x" '{context:$c, context_assumed:$x}'
  }
  out='[]'
  for n in $(jq -r '.projects[]?.name' "$root/.hivemind-hub/projects.json"); do
    [ -z "$want" ] || [ "$n" = "$want" ] || continue
    hm_is_agent_name "$n" || continue
    p=$(project "$root" "$n"); home=$(abs "$root" "$(printf '%s' "$p" | jq -r .home)")
    repos='[]'
    while IFS= read -r r; do
      a=$(abs "$root" "$r"); k=$(kind_of "$a"); br=""; ch=""
      case "$k" in
        repo|worktree\ *) br=$(git -C "$a" symbolic-ref --short -q HEAD 2>/dev/null || git -C "$a" rev-parse --short HEAD 2>/dev/null)
                          # never takes the index lock: an agent's git add or commit in that folder must not meet it
                          ch=$(git --no-optional-locks -C "$a" status --porcelain 2>/dev/null | grep -c .) ;;
      esac
      repos=$(printf '%s' "$repos" | jq -c --arg r "$r" --arg k "${k%% *}" --arg b "$br" --arg c "$ch" '. + [{folder:$r, kind:$k} + (if $b != "" then {branch:$b, changed:($c | tonumber)} else {} end)]')
    done < <(printf '%s' "$p" | jq -r '.repos[]')
    orch_state "$root" "$n" "$home"
    # each session's context level as hm-context reads it: "<agent> <level>[ (window assumed N)][ (not running)]"
    levels=$(HM_PROJECT="$home" "$(dirname "$0")/hm-context" --all 2>/dev/null) || levels=""
    starting='null'
    if [ "$O_STATE" != running ] && pending "$root" "$n"; then
      q=false; hm_pane_question "$(hm_json_get "$root/.hivemind-hub/panes/$n.json" .socket)" "$(hm_json_get "$root/.hivemind-hub/panes/$n.json" .pane)" && q=true
      sg=false; sending "$root/.hivemind-hub/panes/$n.json" && sg=true
      starting=$(jq -c --argjson q "$q" --argjson sg "$sg" '{pane, kind, at, typed: (.typed // false), sending: $sg, question: $q} + (if .task then {task} else {} end)' "$root/.hivemind-hub/panes/$n.json")
    fi
    agents='[]'
    for a in $(jq -r '.agents[]?.name' "$home/.hivemind/team.json" 2>/dev/null); do
      hm_is_agent_name "$a" && [ "$a" != "$O_AGENT" ] || continue
      hm_team_agent_is "$home" "$a"; case $? in 0) st=running ;; 1) st=stopped ;; 2) st=unknown ;; *) st=unrecorded ;; esac
      q=false
      [ "$st" != running ] || ! hm_pane_question "$(jq -r --arg a "$a" '[.agents[] | select(.name == $a)][0].socket // empty' "$home/.hivemind/team.json")" \
        "$(jq -r --arg a "$a" '[.agents[] | select(.name == $a)][0].pane // empty' "$home/.hivemind/team.json")" || q=true
      agents=$(printf '%s' "$agents" | jq -c --arg a "$a" --arg s "$st" --argjson q "$q" --argjson l "$(level "$a")" '. + [{name:$a, state:$s, question:$q} + $l]')
    done
    open=$(printf '%s' "$opens" | jq -r --arg p "$n" '.[$p] // 0')
    out=$(printf '%s' "$out" | jq -c --arg n "$n" --arg h "$home" --argjson r "$repos" --argjson ag "$agents" --argjson st "$starting" \
      --arg os "$O_STATE" --arg on "$O_NAME" --arg sid "$O_SID" --argjson ot "$open" --argjson oq "$O_QUESTION" --arg opid "$O_PID" --arg opane "$O_PANE" \
      --argjson ol "$( [ -n "$O_AGENT" ] && [ "$O_STATE" != unregistered ] && level "$O_AGENT" || echo '{}')" \
      '. + [{name:$n, home:$h, repos:$r, orchestrator:({state:$os, question:$oq} + (if $on != "" then {name:$on} else {} end) + (if $sid != "" then {session_id:$sid} else {} end)
            + (if $opid != "" then {pid:($opid | tonumber)} else {} end) + (if $opane != "" then {pane:$opane} else {} end)
            + $ol + (if $st != null then {starting:$st} else {} end)), agents:$ag, open_tasks:$ot}]')
  done
  if [ "$json" = 1 ]; then
    jq -n --arg root "$root" --argjson h "$hub" --argjson p "$out" '{hub:({root:$root} + $h), projects:$p}'
  else
    printf '%s' "$out" | jq -r --arg root "$root" --arg hub "$(printf '%s' "$hub" | jq -r '.name // "hub (not recorded: hm-hub self)"')" '
      def n($k; $w): "\($k) \($w)\(if $k == 1 then "" else "s" end)";
      (map(.repos[].folder | length) | max // 0) as $fw |
      "\($hub)  ·  \($root)  ·  \(n(length; "project"))  ·  \(n(map(.open_tasks) | add // 0; "open task"))",
      (.[] |
        "",
        .name,
        "  orchestrator  \(if .orchestrator.state == "unregistered" then "running, not registered with hivemind" else .orchestrator.state end)\(if .orchestrator.name then "  \(.orchestrator.name)" else "" end)\(if .orchestrator.pane then " in pane \(.orchestrator.pane)" else "" end)\(if .orchestrator.question then "  (a question on its screen)" else "" end)\(if .orchestrator.starting then (if .orchestrator.starting.typed or .orchestrator.starting.sending then "  (coming up in pane \(.orchestrator.starting.pane))" else "  (waiting in pane \(.orchestrator.starting.pane)\(if .orchestrator.starting.question then " on a question" else "" end): hm-hub continue \(.name))" end) else "" end)",
        "  agents        \(if (.agents | length) == 0 then "none" else "\([.agents[] | select(.state == "running")] | length) of \(.agents | length) running\([.agents[] | select(.state != "running" or .question) | "\(.name) \(if .question then "has a question on its screen" else .state end)"] | if length > 0 then "  (\(join(", ")))" else "" end)" end)",
        "  tasks         \(.open_tasks) open",
        (.repos | to_entries[] | "\(if .key == 0 then "  folders       " else "                " end)\(.value.folder + (" " * ($fw - (.value.folder | length))))  \(.value.kind)\(if .value.branch then "  \(.value.branch)  \(if .value.changed == 0 then "clean" else "\(.value.changed) changed" end)" else "" end)"))'
  fi ;;

task)
  name="${1:-}"; [ -n "$name" ] || hm_die 64 "$USAGE"; shift
  text=""; given=0
  while [ $# -gt 0 ]; do [ $# -ge 2 ] && [ "$1" = --text ] || hm_die 64 "$USAGE"; text="$2"; given=1; shift 2; done
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  hn=$(need_hub_name "$root") || exit $?
  [ "$given" = 1 ] || text=$(cat)
  [ -n "$(printf '%s' "$text" | tr -d '[:space:]')" ] || hm_die 4 "a task needs its text"
  lock "$root"
  n=$(jq -r --arg p "$name" 'select(.project == $p) | .id' "$root/.hivemind-hub/tasks.jsonl" | sort -u | grep -c .)
  id="$name-$((n + 1))"
  folders=$(printf '%s' "$PROJ" | jq -r '.home as $h | .repos[] | "\(if . == $h then 1 else 0 end)\t\(.)"' | while IFS=$'\t' read -r ish f; do
    if [ "$ish" = 1 ]; then printf -- '- %s (home: the team works from here)\n' "$(abs "$root" "$f")"; else printf -- '- %s\n' "$(abs "$root" "$f")"; fi
  done)
  {
    printf '# Task %s\n\n' "$id"
    printf 'From the owner, through %s. The owner reads and answers you only through %s: send it your questions, your plan,\n' "$hn" "$hn"
    printf 'blockers and finished work with SendMessage, the first line `TASK %s:` and then one of: %s.\n' "$id" "$(printf '%s' "$HUB_REPLIES" | sed 's/ /, /g')"
    printf 'A reply that begins `OWNER on TASK %s:` carries the owner'"'"'s own words.\n\n' "$id"
    printf 'Project folders:\n%s\n\n## The task\n\n%s\n' "$folders" "$text"
  } > "$root/.hivemind-hub/tasks/$id.md"
  append_event "$root" "$id" "$name" asked ""
  printf '%s\t%s\n' "$id" "$root/.hivemind-hub/tasks/$id.md" ;;

log)
  [ $# -ge 2 ] || hm_die 64 "$USAGE"
  id="$1"; ev="$2"; shift 2; note=""
  while [ $# -gt 0 ]; do [ $# -ge 2 ] && [ "$1" = --note ] || hm_die 64 "$USAGE"; note="$2"; shift 2; done
  in_list "$ev" "$HUB_EVENTS" || hm_die 4 "unknown event: $ev (events: $HUB_EVENTS)"
  root=$(hub_root) || exit $?
  lock "$root"
  [ -n "$(task_state "$root" "$id")" ] || hm_die 2 "no task $id in this hub"
  p=$(jq -r --arg i "$id" 'select(.id == $i) | .project' "$root/.hivemind-hub/tasks.jsonl" | head -1)
  append_event "$root" "$id" "$p" "$ev" "$note"
  echo "$id $ev" ;;

tasks)
  want=""; open=0; json=0
  while [ $# -gt 0 ]; do case "$1" in --open) open=1 ;; --json) json=1 ;; -*) hm_die 64 "$USAGE" ;; *) want="$1" ;; esac; shift; done
  root=$(hub_root) || exit $?
  rows=$(jq -s --arg w "$want" --argjson o "$open" --argjson c "$HUB_CLOSED_JSON" --argjson ow "$HUB_NEEDS_OWNER_JSON" '
    [group_by(.id)[] | select($w == "" or .[0].project == $w)
     | {id: .[0].id, project: .[0].project, asked: .[0].at,
        state: ([.[] | select(.event != "note")] | last | .event),
        updated: (last | .at), last_note: ([.[] | select(.note)] | last | .note // null)}
     | .needs_owner = (.state as $s | $ow | index($s) != null)
     | select($o == 0 or ((.state as $s | $c | index($s)) | not))] | sort_by(.asked)' "$root/.hivemind-hub/tasks.jsonl")
  if [ "$json" = 1 ]; then printf '%s\n' "$rows"
  else printf '%s' "$rows" | jq -r '.[] | "\(.id)\t\(.state)\t\(.updated)\(if .last_note then "\t\(.last_note)" else "" end)"'; fi ;;

wake)
  name="${1:-}"; [ -n "$name" ] || hm_die 64 "$USAGE"; shift
  start_opts 0 "$@"
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  hn=$(need_hub_name "$root") || exit $?
  orch_state "$root" "$name" "$HOME_DIR"
  case "$O_STATE" in
    none) hm_die 2 "no orchestrator is recorded for $name: start one on a task with hm-hub start $name <task id>" ;;
    running) hm_die 4 "$name's orchestrator is running as $O_NAME: message it instead" ;;
    unregistered) hm_die 4 "$name's orchestrator is running as $O_NAME (pid $O_PID${O_PANE:+, pane $O_PANE}) but is not registered with hivemind: ask it to run hm-spawn --self --agent orchestrator --hub $hn" ;;
    unknown) hm_die 4 "cannot tell whether $name's orchestrator is running; nothing was started" ;;
  esac
  [ -n "$O_SID" ] || hm_die 2 "$name's orchestrator has no session recorded, so there is no conversation to resume"
  project_mode "$HOME_DIR"
  hm_is_session_name "$O_NAME" || hm_die 4 "$name's orchestrator name is not one hivemind will type"
  args=(--resume "$O_SID" --name "$O_NAME"); [ -z "$MODE" ] || args+=(--permission-mode "$MODE")
  launch "$root" "$name" wake "$HOME_DIR" \
    "You are $O_NAME, resumed by $hn after a restart. Register again with hm-spawn --self --agent $O_AGENT --hub $hn, run hm-context --all, and run hm-spawn --respawn <agent> for each agent it marks (not running). Then send $hn one line, first word BACK: which agents are back and what you were doing." \
    "" "${args[@]}" ;;

start)
  name="${1:-}"; id="${2:-}"; [ -n "$name" ] && [ -n "$id" ] || hm_die 64 "$USAGE"; shift 2
  overnight=0; sargs=()
  for a in "$@"; do if [ "$a" = --overnight ]; then overnight=1; else sargs+=("$a"); fi; done
  start_opts 1 ${sargs[@]+"${sargs[@]}"}
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  hn=$(need_hub_name "$root") || exit $?
  st=$(task_state "$root" "$id"); [ -n "$st" ] || hm_die 2 "no task $id in this hub"
  [ "$(jq -r --arg i "$id" 'select(.id == $i) | .project' "$root/.hivemind-hub/tasks.jsonl" | head -1)" = "$name" ] || hm_die 4 "task $id is not $name's"
  in_list "$st" "$HUB_CLOSED" && hm_die 4 "task $id is $st"
  orch_state "$root" "$name" "$HOME_DIR"
  case "$O_STATE" in
    none) ;;
    unregistered) hm_die 4 "$name's orchestrator is already running as $O_NAME (pid $O_PID${O_PANE:+, pane $O_PANE}) but is not registered with hivemind: ask it to run hm-spawn --self --agent orchestrator --hub $hn, then hand it the task" ;;
    *) hm_die 4 "$name already has an orchestrator ($O_STATE): message it, or wake it with hm-hub wake $name" ;;
  esac
  tf="$root/.hivemind-hub/tasks/$id.md"
  hm_is_typed_path "$tf" || hm_die 4 "the task's path is not one hivemind will type: $tf"
  project_mode "$HOME_DIR"
  args=(--name "$name-orchestrator"); [ -z "$MODEL" ] || args+=(--model "$MODEL"); [ -z "$MODE" ] || args+=(--permission-mode "$MODE")
  if [ "$overnight" = 1 ]; then sline=$(overnight_line "$id" "$tf" "$hn"); else sline="/hivemind:start Task $id: read $tf. It came from the owner through $hn."; fi
  launch "$root" "$name" start "$HOME_DIR" "$sline" "$id" "${args[@]}" ;;

run)
  # the two owner-only skills, typed into the project's running orchestrator: only a line this script builds, only when the
  # orchestrator is registered and alive, never while a task waits on the owner, and once (its own record, runs/<project>.json)
  name="${1:-}"; skill="${2:-}"; id="${3:-}"; [ -n "$name" ] && [ -n "$skill" ] && [ -n "$id" ] || hm_die 64 "$USAGE"; shift 3
  case "$skill" in overnight|cleanup) ;; *) hm_die 64 "$USAGE" ;; esac
  disk=""; rargs=()
  for a in "$@"; do if [ "$a" = --disk ]; then disk=" --disk"; else rargs+=("$a"); fi; done
  [ -z "$disk" ] || [ "$skill" = cleanup ] || hm_die 64 "$USAGE"
  start_opts 0 ${rargs[@]+"${rargs[@]}"}
  [ -z "$MODE" ] || hm_die 64 "$USAGE"
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  hn=$(need_hub_name "$root") || exit $?
  st=$(task_state "$root" "$id"); [ -n "$st" ] || hm_die 2 "no task $id in this hub"
  [ "$(jq -r --arg i "$id" 'select(.id == $i) | .project' "$root/.hivemind-hub/tasks.jsonl" | head -1)" = "$name" ] || hm_die 4 "task $id is not $name's"
  in_list "$st" "$HUB_CLOSED" && hm_die 4 "task $id is $st"
  in_list "$st" "$HUB_NEEDS_OWNER" && hm_die 4 "task $id waits on the owner ($st): nothing is run until it is answered"
  orch_state "$root" "$name" "$HOME_DIR"
  case "$O_STATE" in
    running) ;;
    stopped) hm_die 4 "$name's orchestrator is stopped: wake it first with hm-hub wake $name" ;;
    none) hm_die 4 "$name has no orchestrator: start one first with hm-hub start $name $id" ;;
    unregistered) hm_die 4 "$name's orchestrator is running as $O_NAME but is not registered with hivemind: ask it to run hm-spawn --self --agent orchestrator --hub $hn first" ;;
    *) hm_die 4 "cannot tell whether $name's orchestrator is running; nothing was typed" ;;
  esac
  tf="$root/.hivemind-hub/tasks/$id.md"
  hm_is_typed_path "$tf" || hm_die 4 "the task's path is not one hivemind will type: $tf"
  entry=$(hm_self_entry "$HOME_DIR")
  rsocket=$(printf '%s' "$entry" | jq -r '.socket // empty'); rpane=$(printf '%s' "$entry" | jq -r '.pane // empty')
  [ -n "$rpane" ] || hm_die 4 "$name's orchestrator has no pane recorded"
  if [ "$skill" = overnight ]; then rline=$(overnight_line "$id" "$tf" "$hn"); else rline="/hivemind:cleanup$disk"; fi
  rf="$root/.hivemind-hub/runs/$name.json"
  lock "$root"
  if [ -f "$rf" ] && sending "$rf"; then hm_die 4 "another hm-hub run is typing into $name's orchestrator; it reports when it is done"; fi
  ident=$(hm_pane_identity "$rsocket" "$rpane") || hm_die 4 "cannot read $name's orchestrator pane $rpane"
  mkdir -p "$root/.hivemind-hub/runs"
  jq -nc --arg p "$rpane" --arg s "$rsocket" --arg i "${ident%%$'\t'*}" --arg t "${ident#*$'\t'}" --arg k "$skill" --arg l "$rline" --arg task "$id" --arg at "$(hm_now)" \
    --arg sp "$$" --arg ss "$(hm_lstart $$)" \
    '{pane:$p, socket:$s, pane_pid:$i, pane_started:$t, kind:$k, line:$l, typed:false, sender_pid:$sp, sender_started:$ss, at:$at, task:$task}' \
    > "$rf"
  unlock
  finish "$root" "$name" runs ;;

dialog)
  name="${1:-}"; [ -n "$name" ] || hm_die 64 "$USAGE"; shift
  agent=""; if [ $# -gt 0 ]; then agent="$1"; shift; fi
  [ $# -eq 0 ] || hm_die 64 "$USAGE"
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  dialog_target "$root" "$name" "$agent"
  d=$(hm_pane_dialog "$T_SOCKET" "$T_PANE"); rc=$?
  case "$rc" in
    0) ;;
    3) hm_die 4 "no dialog is on $T_SESSION's screen (pane $T_PANE)" ;;
    *) hm_die 4 "cannot read $T_SESSION's pane $T_PANE" ;;
  esac
  printf '%s' "$d" | jq -c --arg p "$name" --arg s "$T_SESSION" --arg pane "$T_PANE" '{project:$p, session:$s, pane:$pane} + .' ;;

answer)
  # one key for a dialog the owner chose an option of: the digit of a numbered dialog, Escape, or, for a menu without digits,
  # arrow keys to the chosen row and Enter as the last key of that choice. Never text, never Enter on its own. The screen is
  # read again under the lock and must be the one the owner was shown (its fingerprint).
  name="${1:-}"; [ -n "$name" ] || hm_die 64 "$USAGE"; shift
  agent=""; case "${1:-}" in ''|--*) ;; *) agent="$1"; shift ;; esac
  choice=""; seen=""
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || hm_die 64 "$USAGE"
    case "$1" in --choice) choice="$2" ;; --seen) seen="$2" ;; *) hm_die 64 "$USAGE" ;; esac
    shift 2
  done
  case "$choice" in esc|[1-9]) ;; *) hm_die 64 "$USAGE" ;; esac
  case "$seen" in ''|*[!0-9a-f]*) hm_die 64 "$USAGE" ;; esac
  [ "${#seen}" -eq 40 ] || hm_die 64 "$USAGE"
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  lock "$root"
  dialog_target "$root" "$name" "$agent"
  d=$(hm_pane_dialog "$T_SOCKET" "$T_PANE"); rc=$?
  case "$rc" in
    0) ;;
    3) hm_die 4 "no dialog is on $T_SESSION's screen (pane $T_PANE): nothing was sent" ;;
    *) hm_die 4 "cannot read $T_SESSION's pane $T_PANE: nothing was sent" ;;
  esac
  [ "$(printf '%s' "$d" | jq -r .fingerprint)" = "$seen" ] || hm_die 4 "the dialog changed; look again: nothing was sent"
  keys=()
  if [ "$choice" = esc ]; then
    [ "$(printf '%s' "$d" | jq -r .esc)" = true ] || hm_die 4 "this dialog does not offer Escape: answer it in the pane"
    keys=(Escape); label="Esc"
  else
    opt=$(printf '%s' "$d" | jq -c --argjson n "$choice" '[.options[] | select(.n == $n)][0] // empty')
    [ -n "$opt" ] || hm_die 64 "this dialog has no option $choice"
    [ "$(printf '%s' "$opt" | jq -r .offered)" = true ] || hm_die 4 "option $choice needs your own text: answer it in the pane"
    label=$(printf '%s' "$opt" | jq -r .label)
    case "$(printf '%s' "$d" | jq -r .kind)" in
      numbered) keys=("$choice") ;;
      menu)
        cur=$(printf '%s' "$d" | jq -r '.cursor // empty'); hm_is_number "$cur" || hm_die 4 "cannot tell which row the cursor is on: answer it in the pane"
        delta=$((choice - cur))
        while [ "$delta" -gt 0 ]; do keys+=(Down); delta=$((delta - 1)); done
        while [ "$delta" -lt 0 ]; do keys+=(Up); delta=$((delta + 1)); done
        keys+=(Enter) ;;
      *) hm_die 4 "the options of this dialog could not be read: answer it in the pane" ;;
    esac
  fi
  for k in "${keys[@]}"; do hm_tmux_on "$T_SOCKET" send-keys -t "$T_PANE" "$k"; sleep 0.2; done
  jq -nc --arg p "$name" --arg s "$T_SESSION" --arg c "$choice" --arg o "$label" --arg at "$(hm_now)" \
    '{event:"answered-dialog", project:$p, session:$s, choice:$c, option:$o, at:$at}' >> "$root/.hivemind-hub/answers.jsonl"
  gone=false
  for _ in 1 2 3 4 5; do
    sleep 1
    hm_pane_dialog "$T_SOCKET" "$T_PANE" >/dev/null; [ $? -eq 3 ] && { gone=true; break; }
  done
  jq -nc --arg s "$T_SESSION" --arg c "$choice" --arg o "$label" --argjson g "$gone" '{answered:true, session:$s, choice:$c, option:$o, dialog_gone:$g}' ;;

continue)
  name="${1:-}"; [ -n "$name" ] || hm_die 64 "$USAGE"; shift
  start_opts 0 "$@"
  [ -z "$MODE" ] || hm_die 64 "$USAGE"
  root=$(hub_root) || exit $?
  need_project "$root" "$name"
  f="$root/.hivemind-hub/panes/$name.json"
  lock "$root"
  # a run stopped at a dialog is picked up here, before any start record
  rf="$root/.hivemind-hub/runs/$name.json"
  if [ -f "$rf" ] && [ "$(hm_json_get "$rf" .typed)" != true ] && ! sending "$rf" \
     && hm_recorded_pane_is "$(hm_json_get "$rf" .socket)" "$(hm_json_get "$rf" .pane)" "$(hm_json_get "$rf" .pane_pid)" "$(hm_json_get "$rf" .pane_started)"; then
    jq --arg sp "$$" --arg ss "$(hm_lstart $$)" '.sender_pid = $sp | .sender_started = $ss' "$rf" > "$rf.tmp$$" && mv "$rf.tmp$$" "$rf"
    unlock
    finish "$root" "$name" runs
    exit $?
  fi
  pending "$root" "$name"; case $? in
    1) hm_die 2 "this hub has started nothing for $name that is still waiting" ;;
    2) hm_die 4 "cannot tell whether the pane this hub started for $name is still there" ;;
  esac
  [ "$(hm_json_get "$f" .typed)" != true ] || hm_die 4 "$name's orchestrator was already sent its line in pane $(hm_json_get "$f" .pane); it reports back when it is up"
  sending "$f" && hm_die 4 "$name's orchestrator is being started in pane $(hm_json_get "$f" .pane) and its line is on the way; nothing to continue"
  jq --arg sp "$$" --arg ss "$(hm_lstart $$)" '.sender_pid = $sp | .sender_started = $ss' "$f" > "$f.tmp$$" && mv "$f.tmp$$" "$f"
  unlock
  finish "$root" "$name" ;;

naming)
  # hm-hub naming --session <id>: what Claude Code records about this hub's own session ({found, name, source}) and a name
  # for it no other running session has (hub, else hub-2...). The records are Claude Code's own and undocumented
  # (<config dir>/sessions/<pid>.json); without one, found is false and the session is left as it is.
  [ $# -eq 2 ] && [ "$1" = --session ] || hm_die 64 "$USAGE"
  sid="$2"; case "$sid" in ''|*[!${HM_LOWER}${HM_UPPER}${HM_DIGITS}-]*) hm_die 4 "bad session id: $sid" ;; esac
  found=false; mname=""; msource=""; taken=""
  for f in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/sessions/*.json; do
    [ -f "$f" ] || continue
    e=$(jq -r '[.pid, .sessionId, .name, .nameSource] | map(. // "" | tostring) | join("\u001f")' "$f" 2>/dev/null) || continue
    IFS=$'\x1f' read -r pid fsid fname fsource <<< "$e"
    hm_is_number "$pid" && hm_alive "$pid" && hm_is_claude "$pid" || continue
    if [ "$fsid" = "$sid" ]; then found=true; mname="$fname"; msource="$fsource"; else taken="$taken|$fname|"; fi
  done
  free=hub; i=2
  while case "$taken" in *"|$free|"*) true ;; *) false ;; esac; do free="hub-$i"; i=$((i + 1)); done
  jq -nc --argjson f "$found" --arg n "$mname" --arg s "$msource" --arg free "$free" '{found:$f, name:$n, source:$s, free:$free}' ;;

*) hm_die 64 "$USAGE" ;;
esac

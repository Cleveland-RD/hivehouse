#!/usr/bin/env bash
# Clear an agent's context and send it back to its handoff: /clear, then the pickup line, each only when the pane is idle.
# hh-rotate <agent> [--still 15] [--max 900] [--settle 8]
# Exit: 0 rotated, 1 the pane never went idle (nothing sent), 2 no such agent or project, 3 .hivehouse tracked,
# 5 a dialog needs a person (nothing typed), 6 the pane is no longer the agent that was recorded (nothing typed), 64 usage. Every outcome that sent nothing is logged to .hivehouse/rotate.log.
set -u
. "$(dirname "$0")/hh-lib.sh"
agent=""; still=15; max=900; settle=8
while [ $# -gt 0 ]; do
  case "$1" in
    --still) still="${2:-}"; shift 2 ;; --max) max="${2:-}"; shift 2 ;; --settle) settle="${2:-}"; shift 2 ;;
    -*) hh_die 64 "usage: hh-rotate <agent> [--still s] [--max s] [--settle s]" ;;
    *) [ -z "$agent" ] || hh_die 64 "usage: hh-rotate <agent> [--still s] [--max s] [--settle s]"; agent="$1"; shift ;;
  esac
done
[ -n "$agent" ] || hh_die 64 "usage: hh-rotate <agent> [--still s] [--max s] [--settle s]"
for n in "$still" "$max" "$settle"; do case "$n" in ''|*[!0-9]*) hh_die 64 "--still, --max and --settle are numbers" ;; esac; done
ROOT=$(hh_project_root) || exit $?
STATE="$ROOT/$HH_STATE_DIR"
if [ -n "$(git -C "$ROOT" ls-files -- "$HH_STATE_DIR")" ]; then
  hh_die 3 "files under $HH_STATE_DIR/ are tracked by git; untrack them before using hivehouse here"
fi
pane=$(jq -r --arg a "$agent" '[.agents[]? | select(.name == $a) | .pane][0] // empty' "$STATE/team.json" 2>/dev/null)
[ -n "$pane" ] || hh_die 2 "no agent named $agent in this project's team"
export HH_PROJECT="$ROOT"
hh_tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1 || hh_die 2 "the pane of $agent ($pane) is gone"
project=$(basename "$ROOT")
note() { printf '%s %s\n' "$(hh_now)" "$*" >> "$STATE/rotate.log"; }
# Only the pane and process that were recorded are typed into (hh_rotate_pane checks again before every send). A record without
# identity (an older format) proves nothing, so it is refused too.
verify() {
  hh_team_agent_is "$ROOT" "$agent" && return 0
  note "identity $agent (nothing sent)"
  echo "$HH_PREFIX: the pane $pane is not the one recorded for $agent (or its Claude is gone); nothing was typed" >&2; return 1
}
verify || exit 6
level() {  # "50%", or "50% (window assumed 1000000)" when hh-context had to guess the window
  local v; v=$("$(dirname "$0")/hh-context" "$agent" 2>/dev/null) || { echo '?'; return; }
  case "$v" in *"(window unknown)") echo "$v"; return ;; esac   # "250000 tokens (window unknown)" is no percent
  echo "${v%% *}%${v#"${v%% *}"}"
}
pickup() { hh_pickup_line "$project" "$ROOT" "$agent"; }

before=$(level)
hh_rotate_pane "$pane" "" "$still" "$max" "$settle" verify pickup; rc=$?
case "$rc" in
  0) ;;
  5) note "dialog $agent (nothing sent)"; echo "$HH_PREFIX: a dialog is waiting in $agent's pane; nothing was typed" >&2; exit 5 ;;
  6) exit 6 ;;
  7) note "cleared-but-not-idle $agent (pickup line not sent)"
     echo "$HH_PREFIX: $agent was cleared but its pane did not go idle; the pickup line was not sent" >&2; exit 1 ;;
  *) note "not-idle $agent (nothing sent)"; echo "$HH_PREFIX: $agent's pane never went idle within ${max}s; nothing was sent" >&2; exit 1 ;;
esac
note "rotated $agent $before -> $(level)"

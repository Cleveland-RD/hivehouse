#!/usr/bin/env bash
# SessionStart hook. Silent and harmless anywhere hivehouse did not spawn this pane: it never fails the session, so every
# path exits 0. The project and agent come from the registry hh-spawn wrote, never from the cwd; only the owner's hub is
# known by its folder.
set -u
. "$(dirname "$0")/hh-lib.sh"
input=$(cat)
# The owner's hub (hh-hub init): a session started in the hub's own folder is the hub, and only there, never in a project
# below it. Said at every start, clear and resume, since a /clear forgets it.
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)
if [ -n "$cwd" ] && [ -d "$cwd/$HH_HUB_DIR" ] && [ ! -L "$cwd/$HH_HUB_DIR" ]; then
  plugin=$(hh_plugin_name) || exit 0
  # a hub is already recorded and its Claude is alive: a second Claude here is not the hub and must not take its place (hh-hub self refuses it too)
  rpid=$(hh_json_get "$cwd/$HH_HUB_DIR/hub.json" .claude_pid 2>/dev/null) || rpid=""
  mine=$(hh_claude_ancestor 2>/dev/null) || mine=""
  if [ -n "$rpid" ] && [ "$rpid" != "$mine" ] && hh_claude_is "$rpid" "$(hh_json_get "$cwd/$HH_HUB_DIR/hub.json" .claude_started 2>/dev/null)"; then
    printf 'A hub already runs in this folder: %s (process %s). This session is not the hub: do not invoke the %s:hub skill, do not run hh-hub self, and do not take its place. Tell the owner, and ask what they want this session to do.\n' \
      "$(hh_json_get "$cwd/$HH_HUB_DIR/hub.json" .name 2>/dev/null)" "$rpid" "$plugin"
    exit 0
  fi
  printf 'This session is the owner'"'"'s hivehouse hub (%s/%s). Before anything else, invoke the %s:hub skill with the Skill tool and follow it.\n' "$cwd" "$HH_HUB_DIR" "$plugin"
  exit 0
fi
hh_hook_session || exit 0   # sets HK_PROJECT and HK_AGENT: this very pane and Claude, as hivehouse registered them
field() { printf '%s' "$input" | jq -r --arg k "$1" '.[$k] // empty' 2>/dev/null; }
hh_write_session "$HK_PROJECT" "$HK_AGENT" "$(field session_id)" "$(field transcript_path)" "$(field source)" || exit 0
"$(dirname "$0")/hh-disk" --hook --min-gb "${CLAUDE_PLUGIN_OPTION_MIN_FREE_GB:-20}" --path "$HK_PROJECT" 2>/dev/null || true
exit 0

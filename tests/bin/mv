#!/usr/bin/env bash
# Stand-in for mv in tests: records the mode of each source (when HM_FAKE_LOG is set), then moves. It exists so a test can
# see the mode a file had at the moment it was moved into place.
if [ -n "${HM_FAKE_LOG:-}" ]; then for a in "$@"; do [ -f "$a" ] && printf 'mv-source-mode: %s %s\n' "$(ls -ln "$a" | cut -c1-10)" "$a" >> "$HM_FAKE_LOG"; done; fi
exec /bin/mv "$@"

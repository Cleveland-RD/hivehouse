#!/usr/bin/env bash
# Stand-in for `claude` in tests (tests/lib.sh puts this directory first on PATH). Prints its argv, one per line, then
# behaves as HM_FAKE_CLAUDE says: idle (default: the prompt box, then a line reader), dialog (a trust dialog, then reads),
# dialoganswer (a dialog until a person answers it, then idle), dialogfile (the capture HM_FAKE_DIALOG names, drawn as it was; then every key is read one at a time and logged as a line
# "KEY: <name>": a Down or Up leaves the dialog, any other key ends it and the idle prompt box comes back), dialogprompt (a dialog inside the prompt box's rules, above an empty prompt line), quotesdialog (dialog words quoted in the conversation above an empty
# prompt box: idle), clearbusy (idle until /clear, then never idle again), retryclear (idle, but the first /clear is left
# on the input line), bare (reads with no prompt at all), busy (never still), ticking (a prompt that keeps being
# redrawn, so never still), hook (runs the SessionStart hook as a Claude would, then idle), nested (starts a second Claude
# below this one that runs the hook, as `claude -p` from an agent's own Bash does, then idle). The variable reaches a pane through tmux -e, never inherited.
# The prompt box is what Claude Code 2.1.x draws: a rule, "❯" + U+00A0 + a dim placeholder, a rule, a footer.
# the remote-host queries hm-remote-sync makes (no model, no prompt): version, and the plugin's install path and version;
# HM_FAKE_PLUGIN_LIST names a file to list instead, and HM_FAKE_PLUGIN_CALLS a file each `plugin list` call is logged to
if [ "${1:-}" = --version ]; then echo "2.1.300 (Claude Code)"; exit 0; fi
if [ "${1:-}" = plugin ] && [ "${2:-}" = list ]; then
  [ -z "${HM_FAKE_PLUGIN_CALLS:-}" ] || printf '%s\n' "$*" >> "$HM_FAKE_PLUGIN_CALLS"
  if [ -n "${HM_FAKE_PLUGIN_LIST:-}" ]; then cat "$HM_FAKE_PLUGIN_LIST"; exit 0; fi   # a test's own listing
  jq -nc --arg p "$(cd "$(dirname "$0")/../.." && pwd -P)" --arg v "${HM_FAKE_PLUGIN_VERSION:-0.1.0}" '[{id:"hivemind@hivemind",version:$v,installPath:$p}]'; exit 0
fi
for a in "$@"; do printf 'ARGV: %s\n' "$a"; done
printf 'ENV: HM_AGENT=%s HM_PROJECT=%s HIVEMIND_HOME=%s HM_TMUX_SOCKET=%s\n' "${HM_AGENT:-}" "${HM_PROJECT:-}" "${HIVEMIND_HOME:-}" "${HM_TMUX_SOCKET:-}"
RULE='────────────────────────────── fake ──'
box() {  # box [typed text]: with text the input line holds it (no placeholder), as when the UI left a command there
  if [ -n "${1:-}" ]; then printf '\n%s\n❯\xc2\xa0%s\n%s\n  footer line\n' "$RULE" "$1" "$RULE"
  else printf '\n%s\n❯\xc2\xa0\033[2mTry "fix lint errors"\033[0m\n%s\n  footer line\n' "$RULE" "$RULE"; fi
}
dialog() { printf '%s\n Do you trust the files in this folder?\n\n ❯ 1. Yes, I trust this folder\n   2. No, exit\n\n Enter to confirm · Esc to cancel\n' "$RULE"; }
hookinput='{"session_id":"sp","transcript_path":"/tmp/sp.jsonl","source":"startup"}'
case "${HM_FAKE_CLAUDE:-idle}" in
  hook) sleep 3; printf "%s" "$hookinput" | hm-session-hook; box; cat ;;  # after hm-spawn has registered the pane
  nested) HM_FAKE_CLAUDE=hook bash "$0" >/dev/null 2>&1; box; cat ;;
  busy) while :; do date; sleep 0.3; done ;;
  dialog) dialog; cat ;;
  dialogfile)
    cat "$HM_FAKE_DIALOG"; gone=0
    while IFS= read -rsn1 k; do
      if [ "$k" = $'\033' ]; then
        IFS= read -rsn2 -t 1 rest
        case "$rest" in '') name=ESC ;; '[B'|'OB') name=DOWN ;; '[A'|'OA') name=UP ;; *) name="SEQ$rest" ;; esac
      elif [ -z "$k" ]; then name=ENTER
      else name="$k"; fi
      case "$name" in DOWN|UP) [ "$gone" = 1 ] || { printf '\nKEY: %s\n' "$name"; continue; } ;; esac
      gone=1; printf '\033[2J\033[HKEY: %s\n' "$name"; box
    done ;;
  dialoganswer) dialog; IFS= read -r _; printf '\033[2J\033[H'; box; while IFS= read -r line; do printf 'GOT: %s\n' "$line"; box; done ;;  # answered once, then idle
  dialogprompt) printf '\n%s\n Do you want to proceed?\n 1. Yes   2. No   Esc to cancel\n❯\xc2\xa0\n%s\n  footer line\n' "$RULE" "$RULE"; cat ;;
  quotesdialog) printf 'earlier the agent was told: Do you want to proceed? Esc to cancel\n'; box; cat ;;
  bare) cat ;;
  ticking) while :; do date; box; sleep 0.3; done ;;
  *)  # idle, retryclear, clearbusy: a line reader that understands /clear
    n=0; box
    while IFS= read -r line; do
      case "$line" in
        /clear) n=$((n + 1))
          if [ "${HM_FAKE_CLAUDE:-idle}" = retryclear ] && [ "$n" -lt 2 ]; then box '/clear'
          elif [ "${HM_FAKE_CLAUDE:-idle}" = clearbusy ]; then printf '\033[2J\033[HCLEARED\n'; while :; do date; sleep 0.3; done
          else printf '\033[2J\033[HCLEARED\n'; box; fi ;;
        *) printf 'GOT: %s\n' "$line"; box ;;
      esac
    done ;;
esac
